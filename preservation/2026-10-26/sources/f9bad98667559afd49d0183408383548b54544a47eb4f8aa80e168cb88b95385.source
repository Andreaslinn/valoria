.sii-geo-estimate{margin:20px 0;padding:20px;border:1px solid #496532;border-radius:16px;background:#172317;color:#edf5e7;overflow-wrap:anywhere}.sii-geo-estimate h3{margin:6px 0 12px;font-size:22px}.sii-geo-eyebrow{font-size:10px;letter-spacing:.12em;color:#bbd5a5}.sii-geo-value{font-size:30px;font-weight:700;margin:12px 0}.sii-geo-estimate p{line-height:1.5}.sii-geo-estimate details{margin:14px 0}.sii-geo-estimate summary{cursor:pointer;font-weight:600}.sii-geo-estimate table{width:100%;font-size:12px;border-collapse:collapse;margin:12px 0}.sii-geo-estimate td,.sii-geo-estimate th{text-align:left;padding:7px 4px;border-bottom:1px solid #34452c}.sii-geo-estimate caption{text-align:left;margin:8px 0;color:#b9cab0}.sii-geo-estimate ol{padding-left:18px}.sii-geo-estimate li{margin:14px 0;font-size:13px;line-height:1.5}.sii-geo-estimate small{display:block;font-size:11px;line-height:1.5;color:#bacab1}
