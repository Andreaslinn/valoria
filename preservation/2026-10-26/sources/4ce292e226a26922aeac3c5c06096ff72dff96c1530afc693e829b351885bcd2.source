from pathlib import Path
import json
from netlify_bridge import netlify_client
out={}
with netlify_client() as c:
 for name,site,branch in [('v2','0af3d12f-a75b-494e-b75a-333a6165db68','release/valoria-v2-entrypoints-20261012'),('legacy','346587ad-56cc-4a1c-afd3-218d750a2183','release/valoria-legacy-entrypoints-20261012')]:
  r=c.post('/sites/'+site+'/builds',params={'branch':branch,'title':'User-requested public entrypoints acceptance preview'});r.raise_for_status();b=r.json()
  out[name]={'site_id':site,'branch':branch,'build_id':b['id'],'deploy_id':b['deploy_id']}
Path('work/entrypoint-previews.json').write_text(json.dumps(out,indent=2));print(json.dumps(out,indent=2))
