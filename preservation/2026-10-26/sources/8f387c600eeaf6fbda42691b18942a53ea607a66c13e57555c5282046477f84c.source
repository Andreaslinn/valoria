"use client";

import {
  ArrowRight,
  ExternalLink,
  Loader2,
  Radar,
  Search,
  ShieldCheck,
  SlidersHorizontal,
  WalletCards,
  X,
} from "lucide-react";
import { useEffect, useMemo, useRef, useState } from "react";

import { Button, ButtonLink } from "@/components/ui/button";
import { Card, CardDescription, CardTitle } from "@/components/ui/card";
import { StatusNote } from "@/components/ui/status-note";
import { ApiError } from "@/lib/api/client";
import { getRadarCommunes, listRadarOpportunities, type RadarCommune } from "@/lib/api/radar";
import { saveToWatchlist } from "@/lib/api/watchlist";
import {
  formatClp,
  formatConfidence,
  formatM2,
  formatNumber,
  formatPropertyType,
  formatText,
  formatUf,
} from "@/lib/formatters";
import type { RadarOpportunity } from "@/types/radar";

type SaveState = "saving" | "saved" | "error";

const LIMIT_OPTIONS = [10, 20, 50, 100];
const BEDROOM_OPTIONS = ["Todos", "1+", "2+", "3+", "4+"] as const;

export function RadarWorkspace() {
  const [items, setItems] = useState<RadarOpportunity[]>([]);
  const [hasSearched, setHasSearched] = useState(false);
  const [loading, setLoading] = useState(false);
  const [slow, setSlow] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [message, setMessage] = useState<string | null>(null);
  const [limit, setLimit] = useState(20);
  const [bedroomsMin, setBedroomsMin] = useState<number | null>(null);
  const [propertyType, setPropertyType] = useState("");
  const [commune, setCommune] = useState("");
  const [communeOptions, setCommuneOptions] = useState<RadarCommune[]>([]);
  const [maxPriceUf, setMaxPriceUf] = useState("");
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [saveState, setSaveState] = useState<Record<number, SaveState>>({});
  const [strategyFiltersLoaded, setStrategyFiltersLoaded] = useState(false);
  const loadingRef = useRef(false);

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    setStrategyFiltersLoaded(params.get("source") === "mi-estrategia");
    setPropertyType(params.get("property_type") ?? "");
    setCommune(params.getAll("communes")[0] ?? "");
    setMaxPriceUf(params.get("max_price_uf") ?? "");
  }, []);

  useEffect(() => {
    void getRadarCommunes()
      .then((options) => setCommuneOptions(options))
      .catch(() => setCommuneOptions([]));
  }, []);

  useEffect(() => {
    if (!loading) {
      setSlow(false);
      return;
    }
    const timer = window.setTimeout(() => setSlow(true), 5000);
    return () => window.clearTimeout(timer);
  }, [loading]);

  async function search() {
    if (loadingRef.current) return;
    loadingRef.current = true;
    setLoading(true);
    setHasSearched(true);
    setError(null);
    setMessage(null);
    try {
      const result = await listRadarOpportunities({
        bedroomsMin,
        communes: commune ? [commune] : [],
        limit,
        maxPriceUf: optionalNumber(maxPriceUf),
        propertyType: propertyType.trim() || null,
      });
      setItems(result.filter((item) => !isHouse(item.property_type)));
    } catch (caught) {
      setItems([]);
      setError(errorText(caught, "No pudimos ejecutar Radar."));
    } finally {
      loadingRef.current = false;
      setLoading(false);
      setFiltersOpen(false);
    }
  }

  async function save(item: RadarOpportunity) {
    if (!item.listing_id) return;
    setSaveState((current) => ({ ...current, [item.listing_id as number]: "saving" }));
    setError(null);
    setMessage(null);
    try {
      await saveToWatchlist(item.listing_id);
      setSaveState((current) => ({ ...current, [item.listing_id as number]: "saved" }));
      setMessage("Propiedad guardada en Watchlist.");
    } catch (caught) {
      setSaveState((current) => ({ ...current, [item.listing_id as number]: "error" }));
      setError(errorText(caught, "No pudimos guardar esta propiedad."));
    }
  }

  const summary = useMemo(() => buildSummary(items), [items]);
  const strategyFilterSummary = strategyFiltersSummary(propertyType, communeLabel(commune, communeOptions), maxPriceUf);
  const requestedTypeOutsideScope = isRequestedTypeOutsideScope(propertyType);

  function clearStrategyFilters() {
    setStrategyFiltersLoaded(false);
    setPropertyType("");
    setCommune("");
    setMaxPriceUf("");
    setBedroomsMin(null);
    window.history.replaceState(null, "", "/app/radar");
  }

  return (
    <div className="grid gap-5">
      <Card>
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div className="lg:hidden">
              <CardTitle>Feed Radar</CardTitle>
            </div>
            <div className="hidden lg:block">
              <CardTitle>Radar beta</CardTitle>
            </div>
            <CardDescription>
              Radar analiza publicaciones recientes y busca precios bajo el valor estimado por Valoria.
            </CardDescription>
          </div>
          <div className="flex items-center gap-2">
            <span className="rounded-lg border border-accent-500/25 bg-accent-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-100">
              Solo departamentos
            </span>
            <Button
              className="min-h-9 px-3 lg:hidden"
              onClick={() => setFiltersOpen(true)}
              type="button"
              variant="secondary"
            >
              <SlidersHorizontal className="h-4 w-4" aria-hidden />
              Filtros
            </Button>
          </div>
        </div>

        <div className="mt-5 hidden gap-3 lg:grid lg:grid-cols-3">
          <SummaryFact label="Estado" value={loading ? "Buscando" : "Listo"} />
          <SummaryFact label="Ejecucion" value="Manual con boton" />
          <SummaryFact label="Resultados" value={hasSearched ? `${items.length} oportunidad(es)` : "Sin buscar"} />
        </div>

        <div className="mt-5 hidden gap-3 lg:grid lg:grid-cols-3">
          <label className="grid gap-2 text-sm text-muted">
            Limite
            <select
              className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
              disabled={loading}
              onChange={(event) => setLimit(Number(event.target.value))}
              value={limit}
            >
              {LIMIT_OPTIONS.map((option) => (
                <option key={option} value={option}>
                  {option} resultados
                </option>
              ))}
            </select>
          </label>

          <label className="grid gap-2 text-sm text-muted">
            Dormitorios
            <select
              className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
              disabled={loading}
              onChange={(event) => setBedroomsMin(bedroomsValue(event.target.value))}
              value={bedroomsMin === null ? "Todos" : `${bedroomsMin}+`}
            >
              {BEDROOM_OPTIONS.map((option) => (
                <option key={option} value={option}>
                  {option}
                </option>
              ))}
            </select>
          </label>

          <label className="grid gap-2 text-sm text-muted">
            Tipo de propiedad
            <input
              className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
              disabled={loading}
              onChange={(event) => setPropertyType(event.target.value)}
              placeholder="Departamento"
              value={propertyType}
            />
          </label>

          <label className="grid gap-2 text-sm text-muted">
            Comuna
            <select
              className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
              disabled={loading}
              onChange={(event) => setCommune(event.target.value)}
              value={commune}
            >
              <option value="">Todas las comunas</option>
              {communeOptions.map((option) => <option key={option.slug} value={option.slug}>{option.name}</option>)}
            </select>
          </label>

          <label className="grid gap-2 text-sm text-muted">
            Presupuesto maximo UF
            <input
              className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
              disabled={loading}
              inputMode="decimal"
              min="1"
              onChange={(event) => setMaxPriceUf(event.target.value)}
              placeholder="Opcional"
              type="number"
              value={maxPriceUf}
            />
          </label>

          <Button className="self-end" disabled={loading} onClick={search} type="button">
            {loading ? <Loader2 className="h-4 w-4 animate-spin" aria-hidden /> : <Search className="h-4 w-4" aria-hidden />}
            {loading ? "Buscando..." : "Buscar oportunidades"}
          </Button>
        </div>
      </Card>

      {strategyFiltersLoaded ? (
        <StatusNote tone="info">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p>Filtros cargados desde Mi estrategia</p>
              {strategyFilterSummary ? <p className="mt-1 text-sm text-muted">{strategyFilterSummary}</p> : null}
            </div>
            <button className="text-sm font-semibold text-ink underline underline-offset-4" onClick={clearStrategyFilters} type="button">
              Limpiar filtros
            </button>
          </div>
        </StatusNote>
      ) : null}

      {requestedTypeOutsideScope ? (
        <StatusNote tone="warning">
          Radar beta analiza solo departamentos. El tipo solicitado no ampliara el alcance actual y puede no entregar resultados.
        </StatusNote>
      ) : null}

      {!hasSearched ? (
        <div className="lg:hidden">
          <Button className="w-full" disabled={loading} onClick={search} type="button">
            {loading ? <Loader2 className="h-4 w-4 animate-spin" aria-hidden /> : <Search className="h-4 w-4" aria-hidden />}
            {loading ? "Buscando..." : "Buscar oportunidades"}
          </Button>
        </div>
      ) : null}

      {filtersOpen ? (
        <div className="fixed inset-0 z-50 lg:hidden">
          <button
            aria-label="Cerrar filtros"
            className="absolute inset-0 h-full w-full bg-black/55"
            onClick={() => setFiltersOpen(false)}
            type="button"
          />
          <div className="absolute inset-x-3 bottom-3 mx-auto max-w-md rounded-lg border border-line bg-[#050914]/95 p-4 shadow-[0_-24px_80px_rgba(0,0,0,0.55)] backdrop-blur-2xl">
            <div className="flex items-start justify-between gap-4">
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.16em] text-brand-500">
                  Radar
                </p>
                <h3 className="mt-1 text-lg font-semibold text-ink">Filtros de busqueda</h3>
              </div>
              <button
                aria-label="Cerrar filtros"
                className="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-line bg-white/[0.06] text-muted"
                onClick={() => setFiltersOpen(false)}
                type="button"
              >
                <X className="h-4 w-4" aria-hidden />
              </button>
            </div>
            <div className="mt-5 grid gap-4">
              <label className="grid gap-2 text-sm text-muted">
                Limite
                <select
                  className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
                  disabled={loading}
                  onChange={(event) => setLimit(Number(event.target.value))}
                  value={limit}
                >
                  {LIMIT_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {option} resultados
                    </option>
                  ))}
                </select>
              </label>

              <label className="grid gap-2 text-sm text-muted">
                Dormitorios
                <select
                  className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
                  disabled={loading}
                  onChange={(event) => setBedroomsMin(bedroomsValue(event.target.value))}
                  value={bedroomsMin === null ? "Todos" : `${bedroomsMin}+`}
                >
                  {BEDROOM_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </label>

              <label className="grid gap-2 text-sm text-muted">
                Tipo de propiedad
                <input
                  className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
                  disabled={loading}
                  onChange={(event) => setPropertyType(event.target.value)}
                  placeholder="Departamento"
                  value={propertyType}
                />
              </label>

              <label className="grid gap-2 text-sm text-muted">
                Comuna
                <select
                  className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
                  disabled={loading}
                  onChange={(event) => setCommune(event.target.value)}
                  value={commune}
                >
                  <option value="">Todas las comunas</option>
                  {communeOptions.map((option) => <option key={option.slug} value={option.slug}>{option.name}</option>)}
                </select>
              </label>

              <label className="grid gap-2 text-sm text-muted">
                Presupuesto maximo UF
                <input
                  className="min-h-11 rounded-lg border border-line bg-black/25 px-3 text-sm font-semibold text-ink outline-none transition focus:border-brand-500/60"
                  disabled={loading}
                  inputMode="decimal"
                  min="1"
                  onChange={(event) => setMaxPriceUf(event.target.value)}
                  placeholder="Opcional"
                  type="number"
                  value={maxPriceUf}
                />
              </label>

              <Button disabled={loading} onClick={search} type="button">
                {loading ? <Loader2 className="h-4 w-4 animate-spin" aria-hidden /> : <Search className="h-4 w-4" aria-hidden />}
                {loading ? "Buscando..." : "Aplicar y buscar"}
              </Button>
            </div>
          </div>
        </div>
      ) : null}

      <div className="lg:hidden">
        <StatusNote tone="info">
          Feed bajo demanda con publicaciones confirmadas recientemente. Los filtros estan disponibles sin ocupar la lectura principal.
        </StatusNote>
      </div>

      <div className="hidden lg:block">
        <StatusNote>
          Las oportunidades se filtran por publicaciones confirmadas recientemente. Beta: Valoria no reemplaza una tasacion profesional ni garantiza disponibilidad en tiempo real.
        </StatusNote>
      </div>

      <div className="hidden lg:block">
        <StatusNote tone="info">
          Filtros avanzados proximamente. En esta beta puedes ajustar limite y dormitorios.
        </StatusNote>
      </div>

      {slow ? (
        <StatusNote tone="warning">
          Radar puede tardar mientras calcula oportunidades. Seguimos preparando los resultados.
        </StatusNote>
      ) : null}
      {message ? <StatusNote tone="success">{message}</StatusNote> : null}
      {error ? <StatusNote tone="warning">{error}</StatusNote> : null}

      {hasSearched && items.length ? (
        <Card>
          <div className="grid gap-3 sm:grid-cols-4">
            <SummaryFact label="Score mediano" value={summary.score} />
            <SummaryFact label="Descuento mediano" value={summary.discount} />
            <SummaryFact label="Precio mediano" value={summary.price} />
            <SummaryFact label="Comunas" value={summary.comunas} />
          </div>
        </Card>
      ) : null}

      {loading ? (
        <Card>
          <div className="flex min-h-56 items-center justify-center gap-3 text-sm text-muted">
            <Loader2 className="h-5 w-5 animate-spin" aria-hidden />
            Ejecutando Radar...
          </div>
        </Card>
      ) : hasSearched && items.length ? (
        <section className="grid gap-4 xl:grid-cols-2">
          {items.map((item, index) => (
            <OpportunityCard
              item={item}
              key={item.listing_id ?? `${item.title}-${index}`}
              onSave={() => save(item)}
              rank={index + 1}
              saveState={item.listing_id ? saveState[item.listing_id] : undefined}
            />
          ))}
        </section>
      ) : hasSearched ? (
        <Card>
          <div className="flex min-h-64 items-center justify-center rounded-lg border border-dashed border-line bg-black/20 p-8 text-center">
            <div>
              <Radar className="mx-auto h-9 w-9 text-brand-500" aria-hidden />
              <h3 className="mt-4 text-lg font-semibold text-ink">Sin oportunidades para estos parametros</h3>
              <p className="mt-2 max-w-lg text-sm leading-6 text-muted">
                No encontramos resultados para estos parametros. Puedes ampliar el limite o quitar el filtro de dormitorios.
              </p>
              <div className="mt-5">
                <ButtonLink href="/app/portfolio" variant="secondary">
                  <WalletCards className="h-4 w-4" aria-hidden />
                  Ver portfolio
                </ButtonLink>
              </div>
            </div>
          </div>
        </Card>
      ) : (
        <Card>
          <div className="flex min-h-64 items-center justify-center rounded-lg border border-dashed border-line bg-black/20 p-8 text-center">
            <div>
              <ShieldCheck className="mx-auto h-9 w-9 text-accent-500" aria-hidden />
              <h3 className="mt-4 text-lg font-semibold text-ink">Radar listo para ejecutar</h3>
              <p className="mt-2 max-w-lg text-sm leading-6 text-muted">
                La busqueda no se dispara al cargar esta pantalla. Presiona el boton para consultar oportunidades.
              </p>
            </div>
          </div>
        </Card>
      )}
    </div>
  );
}

function OpportunityCard({
  item,
  onSave,
  rank,
  saveState,
}: {
  item: RadarOpportunity;
  onSave: () => void;
  rank: number;
  saveState?: SaveState;
}) {
  const estimatedUf = item.estimated_value_uf ?? item.estimated_price_uf;
  const area = item.usable_area_m2 ?? item.built_area_m2 ?? item.m2;
  const program = [
    programPart(item.bedrooms, "D"),
    programPart(item.bathrooms, "B"),
    programPart(item.parking, "E"),
  ].filter(Boolean);

  return (
    <Card className="flex flex-col lg:min-h-96">
      <div className="flex items-start justify-between gap-4">
        <div className="min-w-0">
          <p className="text-xs font-semibold uppercase tracking-wide text-brand-500">Oportunidad #{rank}</p>
          <h3 className="mt-2 text-base font-semibold leading-6 text-ink">{item.title || "Oportunidad Radar"}</h3>
          <p className="mt-1 text-sm text-muted">
            {formatText(item.comuna)} · {formatPropertyType(item.property_type)}
          </p>
        </div>
        <div className="rounded-lg border border-accent-500/25 bg-accent-500/10 px-3 py-2 text-right">
          <p className="text-xs text-emerald-100">Score</p>
          <p className="text-lg font-bold text-ink">{formatScore(item.score)}</p>
        </div>
      </div>

      <div className="mt-5 grid grid-cols-3 gap-2 lg:hidden">
        <Fact label="Descuento" value={formatDiscount(item.discount_pct, estimatedUf - item.price_uf)} />
        <Fact label="Precio" value={formatUf(item.price_uf)} />
        <Fact label="Confianza" value={formatConfidence(item.confidence_score ?? item.confidence_label ?? item.confidence)} />
      </div>

      <div className="mt-5 hidden gap-3 sm:grid-cols-2 lg:grid">
        <Fact label="Precio publicado" value={`${formatUf(item.price_uf)} / ${formatClp(item.price_clp)}`} />
        <Fact label="Valor estimado" value={`${formatUf(estimatedUf)} / ${formatClp(item.estimated_value_clp)}`} />
        <Fact label="Brecha estimada" value={formatDiscount(item.discount_pct, estimatedUf - item.price_uf)} />
        <Fact label="Superficie" value={formatM2(area)} />
        <Fact label="Programa" value={program.length ? program.join(" / ") : "No disponible"} />
        <Fact label="Confianza" value={formatConfidence(item.confidence_score ?? item.confidence_label ?? item.confidence)} />
        <Fact label="Comparables" value={formatNumber(item.comparables_used, 0)} />
        <Fact label="Calidad precio" value={formatText(item.price_data_quality || item.price_basis_used)} />
        <Fact label="Fuente precio" value={formatText(item.price_uf_source || item.price_currency)} />
        <Fact label="Estado beta" value={formatText(item.radar_scope_label || item.beta_scope_status || item.radar_verdict)} />
      </div>

      {item.radar_verdict_message || item.beta_scope_message ? (
        <p className="mt-4 rounded-lg border border-line bg-white/[0.04] px-3 py-2 text-sm leading-6 text-muted">
          {item.radar_verdict_message || item.beta_scope_message}
        </p>
      ) : null}

      <div className="mt-auto flex flex-wrap gap-3 pt-5">
        {item.url ? (
          <a
            className="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-line bg-white/[0.06] px-4 py-2 text-sm font-semibold text-ink transition hover:border-brand-500/45 hover:bg-brand-500/10"
            href={item.url}
            rel="noreferrer"
            target="_blank"
          >
            <ExternalLink className="h-4 w-4" aria-hidden />
            Abrir publicacion
          </a>
        ) : null}
        {item.listing_id ? (
          <Button disabled={saveState === "saving" || saveState === "saved"} onClick={onSave} type="button" variant="secondary">
            {saveState === "saving" ? <Loader2 className="h-4 w-4 animate-spin" aria-hidden /> : <WalletCards className="h-4 w-4" aria-hidden />}
            {saveLabel(saveState)}
          </Button>
        ) : null}
        <ButtonLink href="/app/portfolio" variant="ghost">
          <ArrowRight className="h-4 w-4" aria-hidden />
          Portfolio
        </ButtonLink>
      </div>
    </Card>
  );
}

function SummaryFact({ label, value }: { label: string; value: string }) {
  return (
    <div className="rounded-lg border border-line bg-white/[0.04] p-3">
      <p className="text-xs font-medium uppercase tracking-wide text-muted">{label}</p>
      <p className="mt-2 break-words text-sm font-semibold text-ink">{value}</p>
    </div>
  );
}

function Fact({ label, value }: { label: string; value: string }) {
  return (
    <div className="rounded-lg border border-line bg-white/[0.04] p-3">
      <p className="text-xs font-medium uppercase tracking-wide text-muted">{label}</p>
      <p className="mt-2 break-words text-sm font-semibold text-ink">{value}</p>
    </div>
  );
}

function bedroomsValue(value: string): number | null {
  if (value === "Todos") return null;
  return Number(value.replace("+", ""));
}

function optionalNumber(value: string): number | null {
  const parsed = Number(value);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
}

function strategyFiltersSummary(propertyType: string, commune: string, maxPriceUf: string): string | null {
  const parts: string[] = [];
  if (propertyType.trim()) {
    parts.push(strategyPropertyTypeLabel(propertyType));
  }
  if (commune) {
    parts.push(commune);
  }
  const budget = optionalNumber(maxPriceUf);
  if (budget != null) {
    parts.push(`Hasta ${formatNumber(budget, 0)} UF`);
  }
  return parts.length ? parts.join(" · ") : null;
}

function communeLabel(slug: string, options: RadarCommune[]): string {
  return options.find((option) => option.slug === slug)?.name ?? slug;
}

function strategyPropertyTypeLabel(value: string): string {
  const normalized = value.trim().toLowerCase();
  if (["apartment", "apartamento", "departamento", "depto", "dpto"].includes(normalized)) {
    return "Departamento";
  }
  return formatPropertyType(value);
}

function isRequestedTypeOutsideScope(value: string): boolean {
  const normalized = value.trim().toLowerCase();
  return Boolean(normalized) && !["apartment", "apartamento", "departamento", "depto", "dpto"].includes(normalized);
}

function isHouse(value: string | null | undefined): boolean {
  const normalized = String(value ?? "").trim().toLowerCase();
  return normalized === "house" || normalized === "casa";
}

function programPart(value: number | null | undefined, suffix: string): string | null {
  return typeof value === "number" && Number.isFinite(value) && value > 0
    ? `${formatNumber(value, 0)}${suffix}`
    : null;
}

function formatDiscount(discountPct: number, savingsUf: number): string {
  const discount = Number.isFinite(discountPct) ? `${formatNumber(discountPct, 1)}%` : "No disponible";
  const savings = Number.isFinite(savingsUf) && savingsUf > 0 ? ` · ${formatUf(savingsUf)} bajo estimacion` : "";
  return `${discount}${savings}`;
}

function formatScore(score: number): string {
  if (!Number.isFinite(score)) return "N/D";
  return score <= 1 ? formatNumber(score * 100, 0) : formatNumber(score, 0);
}

function saveLabel(state: SaveState | undefined): string {
  if (state === "saving") return "Guardando...";
  if (state === "saved") return "Guardado";
  if (state === "error") return "Reintentar guardar";
  return "Guardar";
}

function buildSummary(items: RadarOpportunity[]) {
  return {
    score: formatMedian(items.map((item) => (item.score <= 1 ? item.score * 100 : item.score))),
    discount: formatMedian(items.map((item) => item.discount_pct), "%"),
    price: formatUf(median(items.map((item) => item.price_uf))),
    comunas: String(new Set(items.map((item) => item.comuna).filter(Boolean)).size),
  };
}

function formatMedian(values: number[], suffix = ""): string {
  const value = median(values);
  return value == null ? "No disponible" : `${formatNumber(value, 1)}${suffix}`;
}

function median(values: number[]): number | null {
  const clean = values.filter((value) => Number.isFinite(value)).sort((a, b) => a - b);
  if (!clean.length) return null;
  const mid = Math.floor(clean.length / 2);
  return clean.length % 2 ? clean[mid] : (clean[mid - 1] + clean[mid]) / 2;
}

function errorText(error: unknown, fallback: string): string {
  if (!(error instanceof ApiError)) return fallback;
  if (error.status === 0) return "No pudimos conectar con Valoria. Intenta nuevamente en unos minutos.";
  if (error.status === 401 || error.status === 403) return "Tu sesion no esta vigente o no tiene permisos para Radar.";
  if (error.status === 404) return "Radar no esta disponible en este momento.";
  if (error.status === 400 || error.status === 422) return "Los parametros enviados a Radar no son validos.";
  if (error.status >= 500) return "Radar tuvo un problema. Intenta nuevamente mas tarde.";
  return error.message;
}
