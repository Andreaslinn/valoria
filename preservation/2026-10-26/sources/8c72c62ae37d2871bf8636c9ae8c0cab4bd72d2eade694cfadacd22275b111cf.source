from pathlib import Path
p=Path('frontend-v2/src/features/radar/radar.tsx');s=p.read_text(encoding='utf-8').replace('"use client";','"use client";\nimport {saveAnalyzerPrefill} from "@/features/listing-url/prefill";',1).replace('Abre el análisis existente de Valoria 1.x. Copia la URL de esta propiedad para pegarla en el formulario.','Abre Analizar URL de Valoria V2 con esta publicación. Podrás confirmar o editar la URL antes de consultar.').replace('await navigator.clipboard.writeText(detail.item!.url!);location.assign(legacyRoute("Analizar URL")!);','saveAnalyzerPrefill(detail.item!.url!);location.assign(legacyRoute("Analizar URL")!);').replace('No se pudo copiar. Copia la URL mostrada y abre Analizar URL.','No se pudo preparar la URL. Copia el enlace mostrado para continuar.').replace('Copiar URL y abrir análisis','Abrir con esta URL').replace('en Valoria 1.x','en Valoria V2');p.write_text(s,encoding='utf-8')
