from pathlib import Path
p=Path('work/github-release/netlify.toml');s=p.read_text();s=s.replace('# The modern Netlify OpenNext adapter is detected automatically.','# The modern OpenNext adapter; use the maintained current version.');s+='\n[[plugins]]\n  package = "@netlify/plugin-nextjs"\n';p.write_text(s,encoding='utf-8')
