import subprocess,tarfile,io,json,difflib
from pathlib import Path
r=Path(r'C:\Users\heiko\Documents\Codex\2026-09-05\vamos-a-ped\valoria-reconciled');w=Path(r'C:\Users\heiko\Documents\Codex\2026-10-12\files-pasted-by-the-user-valoria\work')
paths=['api/main.py']+[f'api/v1/{n}.py' for n in ['alerts','health','listings','patrimony','radar','valuations','watchlist']]+['domain/radar/detector.py','infrastructure/db/models.py','infrastructure/db/repositories/alert_repo.py']+[f'services/{n}.py' for n in ['listing_analysis','listing_url_lookup','market_dashboard_overview','patrimony_alerts','portfolio','radar','reports','valuation','v2_contract','portfolio_snapshots']]+['core/normalization/publication_identity.py','core/normalization/property_consistency.py','core/assessment/warnings.py','core/assessment/warning_definitions.json','scripts/check_v2_contract.py','ui/components/risk_report_html.py','alembic/versions/0021_listing_observations.py','alembic/versions/0022_alert_reads.py']
(w/'overlay-paths.json').write_text(json.dumps(paths,indent=2),encoding='utf-8')
ssh=[r'C:\Windows\System32\OpenSSH\ssh.exe','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes','-o','ConnectTimeout=15','-i',r'C:\Users\heiko\Downloads\ssh-key-2026-07-07 (1).key','ubuntu@161.153.201.245']
code="import tarfile,sys,pathlib\nwith tarfile.open(fileobj=sys.stdout.buffer,mode='w|') as t:\n for name in "+repr(paths)+":\n  p=pathlib.Path('/app')/name\n  if p.is_file():t.add(p,arcname=name,recursive=False)\n"
remote="import subprocess,sys\np=subprocess.run(['docker','exec','-i','valoria_oracle_beta-api-1','python','-B','-'],input="+repr(code.encode())+",capture_output=True,timeout=30)\nsys.stdout.buffer.write(p.stdout)\nsys.exit(p.returncode)"
a=subprocess.run(ssh+['python3 -B -'],input=remote.encode(),capture_output=True,timeout=45);a.check_returncode()
(w/'oracle-overlay-before.tar').write_bytes(a.stdout)
o=w/'oracle-overlay-before';o.mkdir(exist_ok=True)
with tarfile.open(fileobj=io.BytesIO(a.stdout)) as t:t.extractall(o,filter='data')
diffs=[]
for path in paths:
 old=o/path
 if old.exists():
  lines=list(difflib.unified_diff(old.read_text(encoding='utf-8').splitlines(True),(r/path).read_text(encoding='utf-8').splitlines(True),fromfile='oracle/'+path,tofile='candidate/'+path))
  if lines:diffs+=lines;print(path,len(lines),'diff lines')
 else:print(path,'NEW')
(w/'oracle-overlay-review.diff').write_text(''.join(diffs),encoding='utf-8')
