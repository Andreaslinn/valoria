sii_table=table(['#','Rol','Dirección catastral','Fecha FE','UF','Cerrados m²','Terreno m²','Score','Peso %'],[[r['rank'],r['rol'],r['direccion'],r['fecha'],n(r['precio_UF_motor']),r['construccion_cerrada_m2'],r['terreno_m2'],n(r['score'],6),n(r['normalized_weight']*100)] for r in selected])
pub_table=table(['#','ID','Construidos / genéricos m²','Terreno m²','Precio UF','Geo','Similitud','Peso %'],[[r['rank'],r['listing_id'],r['construccion_m2'] if r['construccion_m2'] is not None else str(r['m2_generico'])+' (genérico)',r['terreno_m2'] if r['terreno_m2'] is not None else 'ND',n(r['precio_UF_nativo']),r['geocode_precision'],n(r['similarity'],6),n(r['normalized_weight']*100)] for r in pubs])
