import json,hashlib,subprocess,shutil,ast,csv,re,html,zipfile
from pathlib import Path
from datetime import datetime,timezone
ROOT=Path(__file__).resolve().parent;REPO=ROOT/'valoria';OUT=ROOT.parent/'outputs/auditoria-vitacura-1261-6'
def load(n):return json.loads((OUT/n).read_text(encoding='utf8'))
def save(n,o):(OUT/n).write_text(json.dumps(o,indent=2,ensure_ascii=False,default=str),encoding='utf8')
summary=load('hallazgos-verificados.json');selected=load('cierres-SII-10.json');pubs=load('publicaciones-20-enriquecidas.json');sens=load('sensibilidad-verificada.json')
def table(headers,rows):return '| '+' | '.join(headers)+' |\n| '+' | '.join('---' for _ in headers)+' |\n'+'\n'.join('| '+' | '.join(str(v) for v in row)+' |' for row in rows)
def n(x,d=2):return f'{float(x):,.{d}f}'.replace(',','X').replace('.',',').replace('X','.')
files=['api/v1/tasar.py','api/v1/valuations.py','api/sii_closing_contract.py','services/valuation.py','services/sii/role_lookup.py','services/sii/address_details.py','services/sii/closing_opinion.py','services/sii/closing_knn.py','services/sii/closing_confidence.py','services/sii/rebuild.sql','services/sii/parsing.py','services/sii/jobs.py','scripts/validate_sii_closing.py','scripts/export_sii_address_facts.py','domain/valuation/engines/canonical_comparables.py','domain/valuation/canonical_price.py','domain/valuation/comparables.py','domain/valuation/scoring.py','domain/valuation/robust_price_m2.py','domain/valuation/price_surface.py','domain/valuation/product_classification.py','core/entities/listing.py','config/constants.py','config/valuation_flags.py','frontend-v2/src/features/valuation/property-form.tsx','frontend-v2/src/features/valuation/address-autofill.tsx','frontend-v2/src/features/valuation/result.tsx','frontend-v2/src/features/valuation/sii-closing-opinion.tsx','infrastructure/db/repositories/listing_repo.py']
files+=['tests/unit/test_valuation_service.py','scripts/compare_sii_canonical.py']
code_manifest=[];traces=[]
for rel in files:
    p=REPO/rel
    if not p.is_file():continue
    dest=OUT/'codigo'/rel;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,dest)
    digest=hashlib.sha256(p.read_bytes().replace(b'\r\n',b'\n')).hexdigest();code_manifest.append({'file':rel,'sha256_LF':digest})
    if p.suffix=='.py':
        for node in ast.walk(ast.parse(p.read_text(encoding='utf-8-sig'))):
            if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef)):
                traces.append({'file':rel,'function':node.name,'line':node.lineno,'end_line':node.end_lineno})
save('code-manifest.json',code_manifest);save('code-functions.json',traces)
original_hashes=load('canonical-snapshot-provenance.json')['code_sha256']
assert all(next(x['sha256_LF'] for x in code_manifest if x['file']==f)==v for f,v in original_hashes.items())
head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=REPO,text=True).strip();status=subprocess.check_output(['git','status','--porcelain'],cwd=REPO,text=True).strip()
assert status=='',status
data_files=[ROOT/'closing-validation-final/address-index.sqlite',ROOT/'closing-validation-final/address-details.sqlite',ROOT/'closing-validation-final/closings.json',ROOT/'closing-confidence-20261019/canonical-pool-verified-local.json',REPO/'reports/sii/closing_confidence_20261019/frozen-rule.json']
inputs=[]
for p in data_files:
    h=hashlib.sha256()
    with p.open('rb') as f:
        while b:=f.read(1024*1024):h.update(b)
    inputs.append({'path':str(p),'bytes':p.stat().st_size,'sha256':h.hexdigest()})
save('execution-manifest.json',{'audit_utc':datetime.now(timezone.utc).isoformat(),'git_head':head,'git_worktree_clean':True,'inputs':inputs,'database_control':load('database-control.json'),'code_matches_captured_baseline':True,'production_accessed':False,'algorithms_modified':False,'parameters_modified':False,'original_files_modified':False,'prior_report_used_as_ground_truth':False})
for name in ('audit_1261_target.py','verify_audit_1261.py','audit_1261_sources.py','audit_1261_canonical.py','audit_1261_http.py','audit_1261_analyse.py','audit_1261_verify_files.py','build_audit_1261_report.py'):
