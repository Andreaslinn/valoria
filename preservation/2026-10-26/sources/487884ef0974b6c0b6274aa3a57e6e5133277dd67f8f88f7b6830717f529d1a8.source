from pathlib import Path
import sys
root=Path('outputs/valoria').resolve()
sys.path.insert(0,str(root))
from infrastructure.db.property_life import metadata
from sqlalchemy.schema import CreateTable, CreateIndex
from sqlalchemy.dialects.postgresql import dialect
tables=list(metadata.sorted_tables)
sql=[str(CreateTable(table).compile(dialect=dialect())).strip() for table in tables]
sql.extend(str(CreateIndex(index).compile(dialect=dialect())) for table in tables for index in sorted(table.indexes,key=lambda x:x.name))
body='''"""Frozen initial DDL for the isolated property_life schema."""
from alembic import op

revision = 'life_0001'
down_revision = None
branch_labels = None
depends_on = None

DDL = [
'''
body+=''.join('    '+repr(statement)+',\n' for statement in sql)+']\n\n\ndef upgrade():\n    for statement in DDL:\n        op.execute(statement)\n\n\ndef downgrade():\n'
body+=''.join(f'    op.drop_table({table.name!r}, schema="property_life")\n' for table in reversed(tables))
(root/'infrastructure/db/property_life_migrations/versions/0001_property_life.py').write_text(body,encoding='utf-8')
print(f'Frozen {len(tables)} PostgreSQL tables and their indexes.')
