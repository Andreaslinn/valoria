import json,pathlib,math
root=pathlib.Path('outputs/discovery-final-redeploy-20261016')
p=json.loads((root/'heartbeat_20261017_readonly.py.private.log').read_text())
lines=['# Verificación programada — 17 octubre 2026','', 'Producción: `29eaa0b3f354`. Auditoría exclusivamente en lectura; sin ingestas manuales ni cambios remotos.','', 'UF programada: 04:34–04:34:09 UTC, salida 0, 313 días guardados. UF de hoy: 41.173,33 CLP (SII). Portal 07:49–07:52 UTC y Yapo 06:21–06:26 UTC: éxito. Timers activos; ledger y lanzadores coinciden; stderr íntegro conservado. /health OK, sin PORTAL_SESSION_EXPIRED.','', 'Portal: 24 insertados, 342 actualizados, 18/18 altas objetivo con detalle. Yapo: 48 insertados, 367 actualizados, 13/13 altas objetivo con detalle; 13 descartes de validación, cero errores inesperados. Ambas fuentes: cero HTTP 302/403/429.','', '## Cobertura de campos publicados en departamentos activos de las ocho comunas','', '| Fuente | Activos | published_fields | Con detalle | Coordenadas | Útil | Total | Edad/año | Piso | Dirección exacta |','|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|']
for source,c in p['db']['coverage'].items():
 vals=[f"{c[k]} ({100*c[k]/c['active']:.2f}%)" for k in ['published','detail','coordinates','useful','total','age_year','floor','exact_address']]
 lines.append('| '+source+' | '+str(c['active'])+' | '+' | '.join(vals)+' |')
lines+=['','published_fields incluye tarjeta, ficha y mezcla; «con detalle» exige snapshot con stage detail. Coordenadas indica presencia publicada, no garantiza precisión utilizable; útil/total y demás campos ausentes no se imputan. No confundir 46 eventos geo_enriched de Portal con 46 fichas nuevas. Observaciones de hoy: Portal 377 listing_seen y 46 geo_enriched; Yapo 551 listing_seen.','', 'El despliegue actual enriquece altas dentro de discovery; el supuesto anterior de solo cinco fichas totales al día ya no corresponde. Para el stock pendiente de detalle, el mínimo teórico a cinco reparaciones efectivas diarias sería Portal '+str(math.ceil((591-70)/5))+' días y Yapo '+str(math.ceil((1479-21)/5))+' días. No es una fecha garantizada: otras comunas/tipos, rechazos, reintentos y nuevas altas consumen solicitudes y pueden dejar cero cupo de mantenimiento. Hoy Yapo consumió ese cupo con las altas y solicitó cero reparaciones.','', 'No se ejecutó rollback: la salud actual es correcta y la excepción antigua a c55f4b6 corresponde a otro commit.']
out=root/'heartbeat-20261017.md';out.write_text('\n'.join(lines),encoding='utf8');print(out.resolve())
