"use client";
import { useEffect, useRef, useState, type FormEvent } from "react";
import { ArrowRight, Building2, House, BriefcaseBusiness, MapPin, SlidersHorizontal } from "lucide-react";
import { Button, Card } from "@/components/ui/primitives";
import { formatCommuneName } from "@/lib/formatters";
import type { PropertyType, ValuationRequest } from "@/types/valuation";
import { consumeTasarPrefill } from "./prefill";

import { useSiiClosingCapability } from "./sii-closing-opinion";
import { AddressAutofillNote, PropertySearch, useAddressDetails, type SearchMode } from "./address-autofill";
import { NearbySales } from "./nearby-sales";
import type { SiiQuery } from "./sii-geographic-estimate";

const communes=["santiago","providencia","nunoa","las_condes","vitacura","lo_barnechea","la_reina","macul","san_miguel","estacion_central","independencia","recoleta","san_joaquin","la_florida"];
const types=[{value:"apartment",label:"Depto.",icon:Building2},{value:"house",label:"Casa",icon:House},{value:"office",label:"Oficina",icon:BriefcaseBusiness}] as const;
const initial={rol:"",address:"",comuna:"",area:"",land:"",beds:"",baths:"",parking:"",priceUf:"",priceClp:"",reference:""};
const number=(value:string)=>value.trim()!=="" && Number.isFinite(Number(value))?Number(value):null;
export function PropertyForm({busy,hasResult,onChange,onSubmit,onSiiQueryChange}:{busy:boolean;hasResult:boolean;onChange:()=>void;onSubmit:(payload:ValuationRequest)=>Promise<void>;onSiiQueryChange?:(query:SiiQuery)=>void}) {
  const siiEnabled=useSiiClosingCapability();
  const [searchMode,setSearchMode]=useState<SearchMode>("address");
  const [siiRefreshKey,setSiiRefreshKey]=useState(0);
  const autoArea=useRef<string|null>(null), autoLand=useRef<string|null>(null), typeEdited=useRef(false), autoType=useRef(false);
  const [type,setType]=useState<PropertyType>("apartment"),[values,setValues]=useState(initial),[imported,setImported]=useState(false),[targetId,setTargetId]=useState<number|undefined>(),[currency,setCurrency]=useState("UF"),[error,setError]=useState("");
  useEffect(()=>{const p=consumeTasarPrefill();if(!p)return;autoArea.current=null;autoLand.current=null;autoType.current=false;typeEdited.current=true;const n=(v:unknown)=>typeof v==="number"&&Number.isFinite(v)?String(v):"";setImported(true);setTargetId(p.targetListingId);setType(p.propertyType??"apartment");setCurrency(p.publishedPriceUf==null&&p.publishedPriceClp!=null?"CLP":"UF");setValues({rol:"",address:"",comuna:p.comuna??"",area:n(p.propertyType==="apartment"?(p.usableAreaM2??p.builtAreaM2):(p.builtAreaM2??p.usableAreaM2)),land:n(p.landAreaM2),beds:n(p.dormitorios),baths:n(p.banos),parking:n(p.estacionamientos),priceUf:n(p.publishedPriceUf),priceClp:n(p.publishedPriceClp),reference:p.reference??""});},[]);
  const lookup=useAddressDetails(siiEnabled&&!busy,searchMode==="rol"?values.rol:values.address,values.comuna,searchMode);
  const pureSii=siiEnabled&&values.comuna==="vitacura";
  useEffect(()=>{onSiiQueryChange?.({enabled:pureSii,address:searchMode==="address"?values.address:"",rol:searchMode==="rol"?values.rol:undefined,comuna:values.comuna,refreshKey:siiRefreshKey});},[pureSii,searchMode,values.address,values.rol,values.comuna,siiRefreshKey,onSiiQueryChange]);
  useEffect(()=>{
    const data=lookup.data;if(data?.status!=="resolved")return;
    const area=data.fields.closed_area_m2;
    const changed=(typeof area==="number"&&area>0&&values.area==="")||(typeof data.fields.land_area_m2==="number"&&data.fields.land_area_m2>0&&values.land==="")||Boolean(data.fields.property_type&&!typeEdited.current&&data.fields.property_type!==type);
    if(typeof area==="number"&&area>0&&values.area===""){autoArea.current=String(area);setValues(v=>v.area===""?{...v,area:String(area)}:v);}
    const land=data.fields.land_area_m2;
    if(typeof land==="number"&&land>0&&values.land===""){autoLand.current=String(land);setValues(v=>v.land===""?{...v,land:String(land)}:v);}
    if(data.fields.property_type&&!typeEdited.current){autoType.current=true;setType(data.fields.property_type);}
    if(changed)onChange();
  },[lookup.data]); // A new resolved address may fill empty fields, never manual edits.
  const update=(key:keyof typeof initial,value:string)=>{
    const clearArea=(key==="address"||key==="rol"||key==="comuna")&&autoArea.current!==null;
    const clearLand=(key==="address"||key==="rol"||key==="comuna")&&autoLand.current!==null;
    if(clearLand||key==="land")autoLand.current=null;
    if(clearArea||key==="area")autoArea.current=null;
    if(key==="address"||key==="rol"||key==="comuna"){if(autoType.current){autoType.current=false;setType("apartment");}if(key==="address"||key==="rol"){setTargetId(undefined);setImported(false);}}
    setValues(v=>({...v,...(clearArea?{area:""}:{}),...(clearLand?{land:""}:{}),[key]:value}));onChange();
  };
  async function submit(event:FormEvent<HTMLFormElement>) {
    event.preventDefault();setError("");const area=number(values.area),land=number(values.land);
    if(pureSii){if(!(searchMode==="rol"?values.rol:values.address).trim()){setError("Ingresa una dirección o un rol para consultar el SII.");return;}setSiiRefreshKey(v=>v+1);return;}
    if(!values.comuna||area==null||area<=0||(type==="house"&&(land==null||land<=0))){setError("Revisa la comuna y las superficies de la propiedad.");return;}
    await onSubmit({target_listing_id:targetId,comuna:values.comuna,property_type:type,m2:area,built_area_m2:area,usable_area_m2:type==="apartment"&&autoArea.current===null?area:null,land_area_m2:type==="house"?land:null,dormitorios:number(values.beds),banos:number(values.baths),estacionamientos:number(values.parking),precio_publicado_uf:currency==="UF"?number(values.priceUf):null,precio_publicado_clp:currency==="CLP"?number(values.priceClp):null,...(siiEnabled&&searchMode==="rol"&&values.rol.trim()?{sii_rol:values.rol.trim()}:siiEnabled&&searchMode==="address"&&values.address.trim()?{address:values.address.trim()}:{})});
  }
  return <Card label="Ficha de la propiedad" className={`tasar-input${siiEnabled?" tasar-input--address":""}`}><div className="tasar-card-title"><div><span className="tasar-eyebrow">01 / LA PROPIEDAD</span><h2>Define el punto de partida.</h2></div><SlidersHorizontal size={19}/></div>
    <form onSubmit={submit}><fieldset disabled={busy}>
      {imported&&<p className="tasar-note">Datos importados. Revísalos antes de tasar.</p>}
      <div className="tasar-type" role="group" aria-label="Tipo de propiedad">{types.map(({value,label,icon:Icon})=><button key={value} type="button" aria-pressed={type===value} onClick={()=>{typeEdited.current=true;autoType.current=false;setType(value);onChange();}}><Icon size={19}/>{label}</button>)}</div>
      {type==="office"&&<p className="tasar-note">Cobertura de oficinas limitada. La tasación requiere al menos cinco comparables válidos; si faltan, no se generará una estimación.</p>}
      <label className="tasar-field"><span><MapPin size={14}/> Comuna</span><select required value={values.comuna} onChange={e=>update("comuna",e.target.value)}><option value="">Selecciona una comuna</option>{Array.from(new Set([...communes,...(values.comuna?[values.comuna]:[])])).map(c=><option key={c} value={c}>{formatCommuneName(c)}</option>)}</select></label>
      {siiEnabled&&<PropertySearch mode={searchMode} onModeChange={mode=>{if(mode===searchMode)return;setSearchMode(mode);update(mode==="rol"?"rol":"address",mode==="rol"?values.rol:values.address);}} address={values.address} onAddressChange={value=>update("address",value)} rol={values.rol} onRoleChange={value=>update("rol",value)}/>}
      <AddressAutofillNote lookup={lookup}/>
      <NearbySales enabled={siiEnabled&&!busy} comuna={values.comuna} address={searchMode==="address"?values.address:""} rol={searchMode==="rol"?values.rol:undefined}/>
      {siiEnabled&&lookup.data?.status==="resolved"&&<div className="address-section-title">Superficies <span>Puedes corregirlas</span></div>}
      <div className="tasar-surface">
        <label className="tasar-field"><span>{autoArea.current!==null?"Construcción":type==="apartment"?"Superficie útil":"Superficie construida"}{autoArea.current!==null&&<b className="address-field-source">SII</b>}</span><div className="tasar-unit"><input aria-label={autoArea.current!==null?"Superficie cerrada SII":type==="apartment"?"Superficie útil":"Superficie construida"} required={!pureSii} type="number" min="0.1" step="any" placeholder="Ej. 75" value={values.area} onChange={e=>update("area",e.target.value)}/><span>m²</span></div>{autoArea.current!==null&&<small className="address-field-caption">Superficie cerrada</small>}</label>
        {type==="house"&&<label className="tasar-field"><span>Terreno {autoLand.current!==null&&<b className="address-field-source">SII</b>}</span><div className="tasar-unit"><input aria-label="Superficie de terreno" required={!pureSii} type="number" min="0.1" step="any" placeholder="Ej. 250" value={values.land} onChange={e=>update("land",e.target.value)}/><span>m²</span></div>{autoLand.current!==null&&<small className="address-field-caption">Terreno registrado</small>}</label>}
      </div>
      {siiEnabled&&lookup.data?.status==="resolved"&&<><div className="address-section-title">Completa tu ficha <span>Opcional</span></div><p className="address-missing-note">Añade datos que conozcas.</p></>}
      <div className="tasar-rooms">{([{key:"beds",label:"Dormitorios"},{key:"baths",label:"Baños"},{key:"parking",label:"Estacionam."}] as const).map(({key,label})=><label className="tasar-field" key={key}><span>{siiEnabled&&key==="parking"?"Estacionamientos":label}</span><input type="number" min="0" step="1" placeholder={siiEnabled&&lookup.data?.status==="resolved"?"Sin dato":"—"} value={values[key]} onChange={e=>update(key,e.target.value)}/></label>)}</div>
      <div className="tasar-price-input"><div className="tasar-inline"><label htmlFor="tasar-published">Precio publicado <small>Opcional</small></label><select aria-label="Moneda del precio publicado" value={currency} onChange={e=>{setCurrency(e.target.value);onChange();}}><option>UF</option><option>CLP</option></select></div><input id="tasar-published" type="number" min="0" step={currency==="UF"?"any":"1"} placeholder="Compara lo que piden con lo que vale" value={currency==="UF"?values.priceUf:values.priceClp} onChange={e=>update(currency==="UF"?"priceUf":"priceClp",e.target.value)}/></div>
      <details className="tasar-reference"><summary>Añadir una referencia personal</summary><label className="tasar-field"><span>Referencia</span><input value={values.reference} onChange={e=>update("reference",e.target.value)} placeholder="Ej. Departamento de calle Italia"/></label><p>Solo para identificar la propiedad aquí. No interviene en el cálculo.</p></details>
      {error&&<p className="tasar-notice" role="alert">{error}</p>}
      <Button type="submit" className="tasar-submit" disabled={busy}>{pureSii?"Consultar tasación SII":busy?"Analizando comparables…":hasResult?"Actualizar tasación":"Obtener estimación"}<ArrowRight size={17}/></Button>
      <p className="tasar-footnote">{busy?"El cálculo puede tardar hasta dos minutos.":"Los campos sin completar se envían como desconocidos."}</p>
    </fieldset></form>
    <div className="tasar-input-footer"><span className="tasar-dot"/> Datos reales · Sin precios de ejemplo</div>
  </Card>;
}
