import subprocess
code='''import asyncio,json
from sqlalchemy import text
from infrastructure.db.database import get_session_factory
async def main():
 async with get_session_factory()() as s:
  r=await s.execute(text("select id,external_id,url,comuna from listings where source='portalinmobiliario' and status='active' order by id limit 5"))
  print(json.dumps([dict(x) for x in r.mappings()]))
asyncio.run(main())
'''
r=subprocess.run(['docker','exec','valoria_oracle_beta-api-1','python','-B','-c',code],capture_output=True,text=True);print(r.stdout,r.stderr)
