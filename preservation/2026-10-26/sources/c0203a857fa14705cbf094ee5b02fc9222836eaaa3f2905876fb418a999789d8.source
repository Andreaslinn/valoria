from pathlib import Path
import difflib
repo=Path(r'C:\Users\heiko\Documents\Codex\2026-09-05\vamos-a-ped\valoria-reconciled')
base=Path('work/oracle-runtime')
for name in ['api/v1/listings.py','api/v1/radar.py','api/v1/watchlist.py','api/main.py']:
