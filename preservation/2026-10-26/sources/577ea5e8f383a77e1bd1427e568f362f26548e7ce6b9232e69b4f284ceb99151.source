from pathlib import Path
W=Path(__file__).parent
for src,dst in [('package_candidate_v4.py','package_candidate_v5.py'),('check_candidate_image_v4.py','check_candidate_image_v5.py')]:
 s=(W/src).read_text().replace('release-overlay-v4','release-overlay-v5').replace('candidate-20261012-v4','candidate-20261012-v5')
 (W/dst).write_text(s,encoding='utf-8')
