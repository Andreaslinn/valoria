import pathlib,subprocess,json,datetime
B=pathlib.Path('/home/ubuntu/apps/valoria/private/discovery-redeploy-20261016')
for source in ['portal','yapo']:
 name='valoria-'+source+'-session-job'
 check=subprocess.run(['docker','inspect',name],capture_output=True,text=True)
 if check.returncode==0 and json.loads(check.stdout)[0]['State']['Running']:
  log=subprocess.run(['docker','logs',name],capture_output=True,text=True)
  p=B/(source+'-interrupted-private.log');p.write_text(log.stdout+log.stderr);p.chmod(0o600)
  subprocess.run(['docker','stop','--time','10',name],capture_output=True,timeout=30)
 subprocess.run(['sudo','-n','systemctl','stop','valoria-'+source+'-discovery.service'],capture_output=True,timeout=90)
print(json.dumps({'reason':'Acceptance gate failed or deadline reached','rollback_required':True,'timers_unchanged':True,'at':datetime.datetime.now(datetime.timezone.utc).isoformat()}))
