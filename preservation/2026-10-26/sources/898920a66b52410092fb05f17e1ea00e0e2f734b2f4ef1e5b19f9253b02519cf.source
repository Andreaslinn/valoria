r=subprocess.run(args,input=blob,capture_output=True,timeout=120);assert r.returncode==0,'Upload failed'
s=pathlib.Path('work/published_build_remote.py').read_text().replace('published-fields-deploy-20261016','discovery-final-redeploy-20261016').replace('80bd8a9aae5c1af733778f524ce880efcb5d815e',commit).replace('valoria-published-fields:','valoria-discovery:').replace('f1958e27da8224a9e2fd93d7de56211320ff0eea8277d659d416884729bc4ebb',sha)
