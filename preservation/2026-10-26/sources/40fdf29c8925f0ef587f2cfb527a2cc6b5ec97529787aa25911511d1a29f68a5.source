"""Offline analysis of a bounded, read-only PR5 inventory/history export.

Preserves uncertainty: an attempted request does not prove a successful read,
and an absent snapshot does not prove the portal does not publish a field.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import sys
from collections import Counter, defaultdict
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.audit_sii_linkage_readiness import (  # noqa: E402
    COMMUNES,
    bound,
    facts,
    normalized,
    source_name,
    summarize,
)

CUTOFF = datetime(2026, 10, 16, 8, 51, tzinfo=UTC)  # PR5 merge, not an assumed deploy time.


def timestamp(value):
    if not value:
        return None
    try:
        parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        return parsed.replace(tzinfo=UTC) if parsed.tzinfo is None else parsed.astimezone(UTC)
    except (ValueError, TypeError):
        return None


def after_cutoff(value):
    t = timestamp(value)
    return t is not None and t >= CUTOFF


def cause(row, observations):
    history = [o for o in observations if after_cutoff(o.get("observed_at"))
               and source_name(o.get("source")) == source_name(row["source"])
               and str(o.get("external_id")) == str(row["external_id"])]
    detail_reads = [o for o in history if o.get("stage") in {"detail", "structured_detail"}
                    or (o.get("geo_origin") == "detail" and o.get("geo_fields"))]
    # Parse/persistence gaps are proven only with a successful detail-stage record.
    if detail_reads:
        retained = any(bound(o.get(k), row) for o in detail_reads
                       for k in ("raw_fields", "parsed_fields", "detail_fields", "geo_fields"))
        return "detalle_con_campos_no_retenidos" if retained else "detalle_leido_sin_snapshot"
    if after_cutoff(row.get("detail_attempted_at")) or after_cutoff(row.get("last_refresh_attempted_at")):
        return "intento_sin_resultado_trazable"
    if any(o.get("event_kind") == "listing_seen" for o in history) or after_cutoff(row.get("last_seen_at")):
        return "relectura_listado_sin_detalle_trazable"
    return "sin_relectura_ficha_registrada"


def analyze(inventory):
    history = defaultdict(list)
    for obs in inventory["observations"]:
        history[obs["listing_id"]].append(obs)
    rows = []
    for original in inventory["rows"]:
        comuna = normalized(original["comuna"])
        comuna = "santiago" if comuna == "santiago_centro" else comuna
        if comuna not in COMMUNES:
            continue
        r = {**original, "comuna": comuna, "portal": source_name(original["source"])}
        r["facts"] = facts(r)
        r["cause"] = None if r["facts"]["snapshot_PR5"] else cause(r, history[r["id"]])
        r["map_only_observations"] = sum(o.get("geo_origin") == "search_map" for o in history[r["id"]])
        rows.append(r)

    def counts(group):
        missing = [r for r in group if r["cause"]]
        observed = [r for r in group if not r["cause"]]
        return {"active": len(group), "missing": len(missing), "with_snapshot": len(observed),
                "causes": dict(Counter(r["cause"] for r in missing)),
                "confirmed_portal_does_not_publish": 0,
                "missing_with_search_map_only": sum(r["map_only_observations"] > 0 for r in missing),
                "conditional_observed_coverage": summarize(observed),
                "current_coverage": summarize(group)}

    return {"as_of_utc": inventory["as_of_utc"], "transaction_read_only": inventory["transaction_read_only"],
            "cutoff_merge_utc": CUTOFF.isoformat(), "total": counts(rows),
            "by_portal": [{"portal": p, **counts([r for r in rows if r["portal"] == p])}
                          for p in ("portal", "yapo")],
            "by_commune_portal": [{"comuna": c, "portal": p,
                                   **counts([r for r in rows if r["comuna"] == c and r["portal"] == p])}
                                  for c in COMMUNES for p in ("portal", "yapo")],
            "missing_rows": [{k: r[k] for k in ("id", "source", "external_id", "url", "comuna",
                                                "scraped_at", "last_seen_at", "detail_attempted_at", "cause",
                                                "map_only_observations")} for r in rows if r["cause"]]}


def sample(rows, n=50):
    """Freeze a deterministic uniform pseudo-random sample within each portal."""
    result = []
    for p in ("portal", "yapo"):
        group = [r for r in rows if source_name(r["source"]) == p and not facts(r)["snapshot_PR5"]]
        result.extend(sorted(group, key=lambda r: hashlib.sha256(
            ("PR10-backfill-20261019:" + p + ":" + str(r["external_id"])).encode()
        ).hexdigest())[:n])
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("inventory", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--sample", type=Path)
    args = parser.parse_args()
    inventory = json.loads(args.inventory.read_text(encoding="utf-8-sig"))
    result = analyze(inventory)
    args.output.write_text(json.dumps(result, ensure_ascii=False, indent=2, default=str), encoding="utf-8")
    if args.sample:
        args.sample.write_text(json.dumps({"as_of_utc": inventory["as_of_utc"],
                                          "rows": sample(inventory["rows"])}, ensure_ascii=False, default=str), encoding="utf-8")
    print(json.dumps({k: v for k, v in result.items() if k != "missing_rows"}, ensure_ascii=False))


if __name__ == "__main__":
    main()
