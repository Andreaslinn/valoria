import json,os,time
from pathlib import Path
from datetime import datetime,UTC,timedelta
import httpx
from jose import jwt
from playwright.sync_api import sync_playwright,expect

ROOT=Path(os.getenv('VALORIA_E2E_OUTPUT',str(Path(__file__).parent/'artifacts')));ROOT.mkdir(exist_ok=True)
BASE=os.getenv('VALORIA_E2E_BASE_URL','http://127.0.0.1:3003')
API=os.getenv('VALORIA_E2E_API_URL','http://127.0.0.1:8013')
from urllib.parse import urlparse
assert all(urlparse(u).hostname in {'127.0.0.1','localhost'} for u in [BASE,API]), 'Synthetic destructive tests require loopback services'
results=[]
with httpx.Client(base_url=API,timeout=90) as c,sync_playwright() as pw:
 r=c.post('/api/v1/auth/login',data={'username':'candidate-b@example.test','password':'[REDACTED]'});r.raise_for_status();token=r.json()['access_token'];c.headers['Authorization']='Bearer '+token
 b=pw.chromium.launch(headless=True);ctx=b.new_context(viewport={'width':1440,'height':1000});ctx.tracing.start(screenshots=True,snapshots=True);page=ctx.new_page();page.set_default_timeout(20000)
 page.goto(BASE+'/resumen');page.evaluate('(t)=>localStorage.setItem("valoria_access_token",t)',token)
 def test(name,fn):
  try:fn();results.append({'name':name,'status':'PASS'});print('PASS',name,flush=True)
  except Exception as e:
   results.append({'name':name,'status':'FAIL','error':str(e)});page.screenshot(path=str(ROOT/(name+'-failure.png')),full_page=True);print('FAIL',name,str(e)[:300],flush=True)
 def deletion():
  page.goto(BASE+'/portfolio',wait_until='networkidle');page.get_by_role('button',name='Quitar de mi cartera',exact=True).click();page.get_by_role('dialog').get_by_role('button',name='Quitar del seguimiento',exact=True).click();expect(page.get_by_role('dialog')).not_to_be_visible()
  ids=[lid for lid in [1130,298,3633] if c.get(f'/api/v1/watchlist/{lid}/status').json()['saved'] is False];assert len(ids)==1
  other=c.post('/api/v1/auth/login',data={'username':'candidate-a@example.test','password':'[REDACTED]'}).json()['access_token'];assert httpx.get(API+f'/api/v1/watchlist/{ids[0]}/status',headers={'Authorization':'Bearer '+other}).json()['saved'] is True
  r=c.post(f'/api/v1/watchlist/{ids[0]}');r.raise_for_status();assert r.json()['listing_id']==ids[0]
 test('14-real-delete-and-other-user-isolation',deletion)
 def map_selection():
  page.goto(BASE+'/radar',wait_until='networkidle');page.get_by_role('button',name='Buscar oportunidades',exact=True).click();marker=page.get_by_role('button',name='Seleccionar Fixture departamento Independencia 1130, independencia',exact=True);expect(marker).to_be_visible(timeout=45000);marker.click(force=True);expect(marker).to_have_attribute('aria-pressed','true');page.screenshot(path=str(ROOT/'map-selection.png'),full_page=True)
 test('15-map-marker-selection',map_selection)
 def expired():
  payload=jwt.get_unverified_claims(token);payload['exp']=int((datetime.now(UTC)-timedelta(minutes=5)).timestamp());expired_token=jwt.encode(payload,'isolated-remediation-fixture-key-20261012',algorithm='HS256')
  assert c.get('/api/v1/auth/me',headers={'Authorization':'Bearer '+expired_token}).status_code==401
  page.evaluate('(t)=>localStorage.setItem("valoria_access_token",t)',expired_token);page.goto(BASE+'/portfolio',wait_until='networkidle');page.wait_for_function('localStorage.getItem("valoria_access_token")===null');expect(page.locator('body')).not_to_contain_text('Fixture departamento');expect(page.locator('body')).to_contain_text('Inicia sesión')
 test('16-signed-expired-session-clears-data',expired)
 ctx.tracing.stop(path=str(ROOT/'candidate-final-trace.zip'));ctx.close();b.close()
(ROOT/'final-results.json').write_text(json.dumps(results,indent=2),encoding='utf-8')
raise SystemExit(any(x['status']=='FAIL' for x in results))
