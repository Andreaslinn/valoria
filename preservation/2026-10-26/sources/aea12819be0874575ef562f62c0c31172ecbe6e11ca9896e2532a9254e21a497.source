from pathlib import Path
r=Path('frontend-v2/src')
for name in ['types/radar.ts','types/watchlist.ts']:
 p=r/name;s='import type {ThumbnailRef} from "./thumbnail";\n'+p.read_text(encoding='utf-8');s=s.replace(' = {\n',' = {\n  thumbnail?: ThumbnailRef;\n',1);p.write_text(s,encoding='utf-8')
p=r/'types/listing.ts';s='import type {ThumbnailRef} from "./thumbnail";\n'+p.read_text(encoding='utf-8');s=s.replace('export type ListingLookupData = {','export type ListingLookupData = {\n  thumbnail?: ThumbnailRef;');p.write_text(s,encoding='utf-8')
p=r/'features/radar/model.ts';s='import type {ThumbnailRef} from "@/types/thumbnail";\n'+p.read_text(encoding='utf-8');s=s.replace('photo?: string','thumbnail?:ThumbnailRef; photo?: string').replace('return { id: item.listing_id,','return { thumbnail:item.thumbnail, id: item.listing_id,');p.write_text(s,encoding='utf-8')
p=r/'features/radar/radar.tsx';s=p.read_text(encoding='utf-8').replace('"use client";','"use client";\nimport {PropertyPhoto} from "@/components/ui/property-photo";',1);start=s.index('function Photo(');end=s.index('\nfunction Confidence',start);s=s[:start]+'function Photo({item,small=false}:{item:RadarItem;small?:boolean}) {return <PropertyPhoto thumbnail={item.thumbnail} title={item.title} small={small} className={small?"property-photo-row":"property-photo-detail"} illustrativeSrc={item.photo}/>;}'+s[end:];p.write_text(s,encoding='utf-8')
for name in ['features/portfolio/workspace.tsx','features/listing-url/workspace.tsx']:
 p=r/name;s=p.read_text(encoding='utf-8').replace('"use client";','"use client";\nimport {PropertyPhoto} from "@/components/ui/property-photo";',1)
 s=s.replace('<span className="portfolio-row-icon"><Building2 size={21}/></span>','<PropertyPhoto thumbnail={item.thumbnail} title={item.title} small className="property-photo-row"/>').replace('<Card label="Ficha de la publicación" className="analyze-property">','<Card label="Ficha de la publicación" className="analyze-property"><PropertyPhoto thumbnail={data.thumbnail} title={data.title??"Publicación"} className="property-photo-detail"/>');p.write_text(s,encoding='utf-8')
p=r/'components/ui/property-photo.tsx';s=p.read_text(encoding='utf-8');start=s.index('export function thumbnailSrc');end=s.index('\nexport function PropertyPhoto',start);fn=s[start:end];(r/'lib/thumbnail.ts').write_text('import {API_BASE_URL} from "@/lib/config";\nimport type {ThumbnailRef} from "@/types/thumbnail";\n'+fn+'\n',encoding='utf-8');s=s[:start]+'import {thumbnailSrc} from "@/lib/thumbnail";\n'+s[end:];s=s.replace('const [failed,setFailed]=useState(false);','const [failed,setFailed]=useState(false),[loaded,setLoaded]=useState(false);').replace('data-photo-state={src&&!failed?"image":"fallback"}','data-photo-state={src&&!failed?(loaded?"image":"loading"):"fallback"} aria-busy={!!src&&!failed&&!loaded}').replace('onError={()=>setFailed(true)}','onLoad={()=>setLoaded(true)} onError={()=>setFailed(true)}');p.write_text(s,encoding='utf-8')
p=Path('tests/unit/test_listing_url_lookup_endpoint.py');s=p.read_text(encoding='utf-8').replace('"listing_data": {\n            "title": "Depto Yapo",','"listing_data": {\n            "thumbnail": None,\n            "title": "Depto Yapo",');p.write_text(s,encoding='utf-8')
