from pathlib import Path
import json,httpx

def netlify_client():
 d=json.loads((Path.home()/'AppData/Roaming/netlify/Config/config.json').read_text());user=d['users'][d['userId']]
 token=user['auth']['token'];assert token
 return httpx.Client(base_url='https://api.netlify.com/api/v1',headers={'Authorization':'Bearer '+token},timeout=60)
if __name__=='__main__':
 with netlify_client() as c:
  res=c.get('/accounts');res.raise_for_status();accounts=[{k:x.get(k) for k in ['id','name','slug','type','type_name','type_id','capabilities']} for x in res.json()]
  print(json.dumps({'accounts':accounts},indent=2));Path(__file__).with_name('netlify-account-plan.json').write_text(json.dumps(accounts,indent=2))
  site=c.get('/sites/346587ad-56cc-4a1c-afd3-218d750a2183');site.raise_for_status();b=site.json()['build_settings'];print(json.dumps({'build_setting_keys':list(b),'link_fields':{k:b.get(k) for k in ['id','provider','repo_path','repo_branch','installation_id','deploy_key_id','repo_id']},'site_link_keys':[k for k in site.json() if 'repo' in k or 'install' in k]},indent=2))
