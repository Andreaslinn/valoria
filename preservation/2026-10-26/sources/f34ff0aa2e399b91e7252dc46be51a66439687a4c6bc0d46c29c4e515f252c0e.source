"""Price-free source text; only alphabetic tokens, no URL/IDs or numeric amounts."""
from models import *
from sklearn.feature_extraction.text import TfidfVectorizer
from avm01.monetary_text import sanitize
STOP=['clp','clf','precio','valor','pesos','millones','millon','millón','mlc','venta','departamento','departamentos','dormitorios','baños','bano','baño','para','con','del','las','los','una','uno','por','que','este','esta','sus','muy','desde','hasta']
def text(r):
 p=r.canonical_target if hasattr(r,'canonical_target') else r.canonical_listing;m=p.get('raw_metadata') or {}
 return sanitize(' '.join(str(v or '') for v in [p.get('title'),m.get('title'),m.get('description'),m.get('address_label'),m.get('street_hint'),m.get('location_text')]))
def text_matrix(rows):return np.column_stack([matrix(rows),[text(r) for r in rows]])
class TextModel:
 def __init__(self,batch,alpha=10.,weight=1.):
  self.batch=require_batch(batch);self.targets={t.row_id:digest(asdict(t)) for t in batch.targets}
  nums=Pipeline([('impute',SimpleImputer(strategy='median',keep_empty_features=True)),('scale',StandardScaler())])
  prep=ColumnTransformer([('numeric',nums,list(range(7))),('commune',OneHotEncoder(handle_unknown='ignore'),[7]),('text',TfidfVectorizer(min_df=2,max_features=2000,ngram_range=(1,2),sublinear_tf=True,token_pattern=r'(?u)\b[^\W\d_]{3,}\b',stop_words=STOP),8)],transformer_weights={'text':weight},sparse_threshold=1.)
  self.pipeline=Pipeline([('preprocess',prep),('ridge',Ridge(alpha=alpha,solver='lsqr',tol=1e-8,max_iter=5000))])
  with threadpool_limits(limits=1):self.pipeline.fit(text_matrix(batch.rows),np.log([r.price_uf for r in batch.rows]))
 def predict_log(self,targets):
  if any(self.targets.get(t.row_id)!=digest(asdict(t)) for t in targets):raise InvalidExperiment('Modified text inference')
  with threadpool_limits(limits=1):return self.pipeline.predict(text_matrix(targets))
