"""Write conclusions from ingestion evidence, never predictive performance."""
import json,csv,collections,subprocess,sys,zipfile
from common import H,BASE,REPO,read,save,sha,table,inventory,research_inventory
from ingestion import cohort
def md(name,text): (H/name).write_text(text.strip()+'\n',encoding='utf-8')
def run():
    result=read(H/'results.json');metrics=result['identity']['metrics'];o=read(H/'private/oracle_current_snapshot.json');l=read(H/'private/local_current_snapshot.json')
    rows=[r for r in o['listings'] if r['property_type']=='apartment' and cohort(r)['modern_avm_usable']]
    cov=list(csv.DictReader((H/'signal_coverage.csv').open(encoding='utf-8')))
    def c(source,signal):return next(r for r in cov if r['universe']=='oracle_modern_apartment_usable' and r['source']==source and r['signal']==signal)
    table('surface_semantics.csv',[dict(source=s,N=sum(r['source']==s for r in rows),persisted_usable_area=sum(bool(r.get('usable_area_m2')) for r in rows if r['source']==s),explicit_source_usable_area=sum(r['raw_metadata'].get('usable_area_parse_source')=='raw.usable_area_m2' for r in rows if r['source']==s),normalization_origin='raw.built_area_m2' if s=='yapo' else 'raw.m2.fallback') for s in ['yapo','portalinmobiliario']])
    md('modern_cohort_definition.md','''# Definición de cohorte moderna v1
No se usa fecha de corte, ni errores/modelos. Función exacta: `ingestion.py::cohort` / `is_modern_ingestion`.

**Procedencia moderna**: Yapo con `raw_metadata.parser_source` en `yapo_search_payload`, `yapo_search_dom`, `yapo_detail_payload`; Portal con `portal_card_first` o `accepted_rm`. En nuevas observaciones experimentales: fuente Yapo/Portal, stage live_card/live_detail, versión identity-evidence-v1, hash de RAW y hash de build. Los fixtures no ingresan al benchmark.

**Candidato AVM**: procedencia anterior + source/external_id/URL + moneda original explícita + precio positivo nativo UF o CLP publicado >=10.000.000 (límite productivo existente) + área disponible 10..1000 m² + baños positivos + dormitorios positivos o estudio explícito. El universo principal de esta fase se restringe a departamentos activos del snapshot Oracle. No se cambia el precio ni se ejecuta conversión nueva. UF permanece en UF, CLP permanece en CLP: antes de entrenar deberá registrarse una conversión fechada verificable; aquí NO se construye un target común con una tasa fija.

Se excluyen precios recuperados/estimados, `legacy_unrecoverable` y UF sin monto nativo positivo. No se reconstruye legacy. Sin marcador verificable: `unverified`, aunque el precio sea utilizable. `area_parser_v2`, schema 0020, created_at/updated_at y `price_uf_source=scraped` solos NO prueban origen moderno. Los marcadores actuales no son firma histórica: metadata puede mezclarse entre observaciones; la cohorte se considera candidata, no dataset certificado.

Historia verificable: Yapo 6f6ce4e (29/09) introdujo estructura moderna; 49c1c83 preservó UF sin conversión; 5288dde corrigió agrupación DOM. Portal 462c133 (17/07) y 32f23a6 (23/07) introdujeron HTTP y card-first; c7e63d7 (28/09) añadió coordenadas. Se verificaron hashes de 9 archivos desplegados contra local (normalizando LF): todos coinciden. Estos commits explican comportamiento; no convierten fechas en criterio de selección.

Resultados: 4.908 activos, 2.082 con procedencia moderna (todos los tipos). Departamentos: 897 modernos, 1.147 legacy, 282 no verificables. 892 modernos cumplen filtros físicos/monetarios: 447 Yapo + 445 Portal. Cinco modernos quedan fuera de aptitud física. 788 están cotizados en UF y 104 en CLP. No se asume que CLP sea ya comparable con UF.

Sensibilidad sin performance (`cohort_boundary_sensitivity.csv`): excluyendo DOM Yapo quedan 328 Yapo + 445 Portal =773; permitiendo precio nativo sin procedencia de parser (solo techo exploratorio) serían 709+445=1.154. No se congela este techo. El snapshot local contiene 4.196 activos y ningún marcador de parser moderno Yapo: no se mezcla automáticamente con Oracle ni se usa para completar evidencia ausente.

Precaución de área: los 447 Yapo obtienen usable_area de raw.built_area_m2 y los 445 Portal de raw.m2.fallback. 100% de campo poblado NO equivale a 100% superficie útil declarada. `surface_semantics.csv` separa presencia de semántica. Antes de benchmark se debe preregistrar qué área representa el target físico y qué incertidumbre se admite, sin inferir contra performance.
''')
    md('identity_aware_ingestion_design.md','''# Ingesta experimental identity-aware
Implementado exclusivamente en sandbox: `ingestion.py`, `replay.py`, `private/fixture_replay_v2/observations.jsonl` y blob RAW direccionado por SHA256. 20 cards modernas Yapo, 48 cards Portal y 2 detalles Portal reproducidos con parsers actuales. `fixture_replay/` es una revisión preliminar obsoleta: NO usar para cobertura (en v2 cada imagen de Portal se atribuye a su card, nunca a toda la página).

Cada observación conserva source, external_id, URL de solicitud, URL parser, timestamp, etapa card/detail, hash del cuerpo, build parser, salida original del parser y evidencia adicional RAW+PARSED. No se llama clean_listing, mapper, microzonas, motor AVM, repo de escritura ni Redis. No se modifica property_id. Una nueva revisión de parser puede reutilizar el mismo blob sin solicitar fuente.

Yapo: conservar item completo, images/principalImage, orden, sufijos remotos, location completa incluyendo zoom, square/lotSize/usableArea raw y precio/moneda originales. No llamar square «útil» ni lotSize «total» sin confirmar semántica. Campos adicionales seller/address/date solo cuando existen: no inventarlos. El retorno temprano del detalle estructurado puede omitir description/meta; el HTML queda preservado para resolverlo con evidencia futura.

Portal cards: conservar imagen vinculada al external_id y atributos raw. Detalle: guardar JSON-LD/Nordic, gallery.pictures[].id (19 y 23 en fixtures), picture_config, technical_specs, bookmark attrs, quotable_models, location.content_rows y description. No seguir acciones de contacto ni solicitar APIs privadas. No se descargan imágenes.

Pérdida adicional: portal_detail_to_raw entrega description/location en top-level y omite seller; clean_listing no los incorpora a raw_metadata, salvo usos auxiliares en extracción. Por eso preservar esos campos antes del adapter. UNIT_NAME/MODEL_NAME/UNIT_FLOOR en publicaciones de proyecto NO prueban número de departamento ni vivienda única. `priceValidUntil` NO es publicación. id=seller_profile NO es seller ID. Los mapas tampoco prueban precisión address-grade.

Patch propuesto `proposed_yapo_capture.patch`: solo agrega copia profunda del item original y campos RAW a metadata en adapt_item. Validado en 20 items con igualdad exacta del resto de salida. NO aplicado a producto. No agrega historia ni resuelve pérdidas de Portal; la integración completa requeriría aprobar por separado el almacén de evidencia y un hook previo a normalización. El archivo `proposed_parser/yapo_modern.py` es la copia parcheada aislada.

Prioridad: captura antes de acumular; nuevo historial; preservar distinción proyecto/unidad y área declarada/genérica; luego adquisición por fuentes operativas respetando pausa Portal. Nombres/textos/ubicación/URLs quedan en private/, no en informes compartibles. No publicar ese directorio; controles de acceso y retención deben definirse antes de integrar el almacén.
''')
    md('observation_history_design.md','''# Historial de observaciones
Estado actual, inspección de pipeline/_update_existing, modelos/mappers y refresh worker:

| t1→t2→t3 mismo source/external_id | Qué ocurre |
|---|---|
| título, URL, atributos, precio, procedencia monetaria | se sobrescriben con nueva normalización |
| metadata | merge superficial, nuevos valores ganan; puede retener evidencia antigua no reobservada; se eliminan warnings/hints obsoletos según reglas |
| coordenadas/precisión | protección por calidad; no sustituir con None/inferior; no conserva versiones completas |
| scraped_at / last_seen_at | valor de la última observación |
| created_at | nacimiento de fila DB; no garantiza primer avistamiento de publicación si cambia source/external_id por fingerprint |
| precio distinto | PriceHistory guarda precio anterior y observed_at previo; no todos los atributos ni toda observación |
| mismo precio, distintos atributos | no snapshot completo del estado anterior |
| refresh | última tentativa/status; 404→removed, inactividad explícita→inactive, ciertos redirects→removed; bloqueos/429 no prueban desaparición |
| publicación sin source/external_id encontrado | fallback fingerprint puede actualizar fila y reemplazar identidad fuente; sin ledger de alias |

Diseño futuro, NO migración ejecutada:
`fetch_events(fetch_id, source, request_url, final_url, fetched_at, http_status, page_state, scope, complete_scan, raw_blob_sha256)`.
`listing_observations(observation_id, source, external_listing_id, fetch_id, observed_at, observation_kind, original_url, source_updated_at, source_publication_at, evidence_origin)`.
`parsed_revisions(parse_revision_id, observation_id, parser_build_sha256, parser_version, parsed_at, attrs, raw_field_paths, quality_flags)`.
`raw_blobs(sha256, restricted_path, media_type, byte_length)`.
Clave natural de publicación = source+external_id; NO property_id. Observaciones y revisiones separadas evitan confundir replay con un nuevo avistamiento. No updates/deletes sobre historia. El prototipo JSONL es single-writer; comprueba idempotencia de parse_revision_id. No promete atomicidad multiwriter: integración requeriría transacción/constraints/outbox y política de retención, pendientes de aprobación.

first_seen/last_seen=min/max tiempos de observación real, no replay. Cambios físicos y precio comparan observaciones ordenadas con moneda/procedencia retenidas. Una ausencia en búsqueda parcial NO determina desaparición: registrar solo evidencia explícita de detalle retirado o censo con cobertura certificada. Una respuesta 403/429/challenge NO determina desaparición. Reaparición exige nueva observación válida tras evidencia explícita; republicación con otro ID exige links offline, no heurística automática. Duración observada es censurada por ambos extremos; no confundir con tiempo real de venta ni fecha de publicación.

Implementado y probado offline: t1/t2/t3 permanecen en JSONL, tres blobs intactos, timestamps/atributos distinguibles e idempotencia de la misma revisión. No se reparó ni migró el historial existente. Los 12.583 price_history del backup anterior no se usaron como ledger completo ni como verdad de dependencia.
''')
    md('identity_readiness_report.md',f'''# Identity readiness — decisión: IMPROVE_INGESTION
Secundario: IDENTITY_LIMITED. No READY ni groupings certificados.

892 candidatos modernos: 447 Yapo +445 Portal. Identidad se calcula con proyección allowlist de la metodología previa, sin precio/UF/m², property_id ni fingerprint. Cambio explícito de evidencia: se desactiva trusted_geo cuando solo hay pin de origen o etiqueta productiva address sin verificación; no se ajustan radios ni reglas para fabricar grupos.

| Señal | Yapo N=447 | Portal N=445 |
|---|---:|---:|
| Coordenadas válidas, precisión no certificada | 337 (75,39%) | 0 |
| Imagen principal persistida | 447 (100%) | 0 |
| Descripción persistida | 12 (2,68%) | 0 |
| ID estable vendedor | 0 | 0 |
| Fecha de publicación verificable | 0 | 0 |
| >=2 familias identity útiles | 12 (2,68%) | 0 |

La última métrica solo cuenta dirección raw con número, unidad explícita, imágenes, seller ID, descripción sustantiva, o geo address verificada. Atributos físicos, precio y pin no verificado no cuentan. Es densidad de evidencia, NO probabilidad de identity correcta. La cobertura de campos estructurados street_number/unit es 0; leyendo títulos/hints conservadoramente aparecen 9 números de calle y 11 unidades, pero 0 con dirección completa+unidad juntas. No se completa dirección adivinando.

Se evaluaron {metrics['candidate_pairs']} pares candidatos (bloqueo por publicación, dirección/imagen exacta o comuna+pin <=1km; ubicación solo sirve para investigar, no acepta links). {metrics['cannot_links']} incompatibilidades físicas/textuales; no son bugs de identidad ni vínculos previamente confirmados. 0 strong links, 1 candidato medium por dirección (no certificado), 0 matches de imágenes, 0 links cross-source confirmados, 0 vínculos de seller/proyecto acreditados, 0 republicaciones acreditadas temporalmente. Las familias se mantienen separadas: coincidencia de edificio no equivale a unidad.

No hay componentes físicos certificados: tamaños/transitividad/absurdidad geográfica son NO EVALUABLES, no «cero riesgo». Publicaciones observadas serían 100% singletons si solo se aceptara evidencia cierta; NO implica viviendas independientes. No se producen G_liberal/G_preferred/G_conservative porque solo variar etiquetas singleton daría una falsa garantía para CV. `identity_pair_evidence.csv` y `identity_cannot_links.csv` permiten revisar candidatos sin precios.

Adquisición: primer intento aislado falló en conexión del sandbox; única solicitud efectiva a Yapo devolvió 403. Se detuvo sin retry de fuente ni evasión. N_new=0, N_reobserved=0 y cobertura de nueva adquisición indefinida (denominador 0, no 0%). Portal: 0 solicitudes, timer disabled/inactive confirmado en lectura. Fixtures no son nuevas observaciones de mercado y no inflan N.

Conclusión: mejorar preservación antes de aumentar volumen; luego adquirir datos por el pipeline autorizado y volver a medir identidad. No puede afirmarse todavía si la fuente ofrece suficientes unidades/direcciones porque detalle Yapo quedó sin acceso y los 2 detalles Portal son proyectos, no muestra general de reventa. IDENTITY_LIMITED es provisional, no prueba que los datos útiles no existan en origen. Las 892 filas son candidatos monetarios/físicos, no dataset/targets ni groupings congelados. Nada se entrenó o comparó por performance.
''')
    md('README.md','''# Investigación aislada de ingesta moderna — Valoria
**Decisión: IMPROVE_INGESTION**, con limitación actual de identidad y adquisición bloqueada desde este cliente. No entrenar todavía.

Entregables: modern_cohort_definition.md; source_signal_audit.md (102 filas field-by-field); signal_coverage.csv; parser_loss_map.csv; identity_aware_ingestion_design.md; observation_history_design.md; acquisition_rounds.csv; identity_readiness_report.md. Patch propuesto: proposed_yapo_capture.patch, sin aplicar. Integridad: integrity_before/after.json, verification.json, output_manifest.csv. Datos privados de listings y RAW: private/; no compartir públicamente.

Reproducir offline desde este directorio:
```
python -B -m unittest discover -s . -p test_ingestion.py -v
python -B analyze.py
python -B make_patch.py
python -B report.py
python -B common.py
python -B verify.py
```
Requiere Python, beautifulsoup4/lxml/httpx y parsers productivos cuya identidad se registra por hash. No requiere BD ni red para análisis/replay. source_snapshot.zip preserva los módulos de parser importados y los archivos inspeccionados (sin .env ni claves); source_files_manifest.csv permite verificarlo.

No ejecutar extract_local.py / extract_oracle.py / acquire.py al reproducir: son adquisición, no replay; se niegan a sobrescribir snapshots y a reintentar una fuente bloqueada. `replay.py` niega duplicar la salida existente; para nueva reproducción usar un sandbox separado y salida nueva. `private/fixture_replay_v2` es la versión corregida válida; v1 se conserva para trazabilidad de instrumentación y no participa en resultados.

Los snapshots actuales son Oracle 4.908 activos y dev local 4.196; Oracle es solo SELECT en READ ONLY/ROLLBACK. No se importan motores AVM, no se ejecuta clean_listing/microzonas, no se hacen migraciones o matching productivo. Los campos geo históricos solo se inventarían; no se calculan nuevos.
''')
    # Minimal source bundle for replay and review; no settings values, env or credentials.
    import replay
    imported={Path(m.__file__).resolve() for m in list(sys.modules.values()) if getattr(m,'__file__',None) and str(Path(m.__file__).resolve()).startswith(str(REPO.resolve())) and str(m.__file__).endswith('.py')}
    extra=['domain/ingestion/data_cleaning.py','domain/ingestion/pipeline.py','infrastructure/db/models.py','infrastructure/db/mappers.py','scripts/portal_canary.py','scripts/portal_card_first.py','workers/refresh_scraper.py']
    imported.update(REPO/p for p in extra)
    records=[]
    with zipfile.ZipFile(H/'source_snapshot.zip','w',zipfile.ZIP_DEFLATED) as z:
        for p in sorted(imported):
            name=str(p.relative_to(REPO)).replace('\\','/');z.write(p,name);records.append(dict(path=name,sha256=sha(p.read_bytes())))
    table('source_files_manifest.csv',records)
    before=read(H/'oracle_runtime_before.json');
    save('deployed_parser_comparison.json',{p:dict(deployed=h,local=sha((REPO/p).read_bytes().replace(b'\r\n',b'\n')),matches=h==sha((REPO/p).read_bytes().replace(b'\r\n',b'\n'))) for p,h in before['parser_hashes_normalized_LF'].items()})
    save('input_provenance.json',dict(local=sha((H/'private/local_current_snapshot.json').read_bytes()),oracle=sha((H/'private/oracle_current_snapshot.json').read_bytes()),source='current read-only DB snapshots; existing source fixtures; one blocked Yapo request',previous_prices_repaired=False,monetary_imputation=False,models_run=[],cohort_rule_file_sha256=sha((H/'ingestion.py').read_bytes())))
    print('Reports and source replay bundle generated')
from pathlib import Path
if __name__=='__main__':run()
