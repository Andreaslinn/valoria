import subprocess,json
code='''import asyncio,json
from sqlalchemy import text
from infrastructure.db.database import get_session_factory
async def main():
 async with get_session_factory()() as s:
  await s.execute(text('SET TRANSACTION READ ONLY'))
  out={}
  for name,q in [('uf_today',"SELECT date,value,source,fetched_at FROM ingestion_uf_calendar WHERE date=CURRENT_DATE"),('observations',"SELECT source,event_kind,count(*) FROM listing_observations WHERE observed_at >= '2026-10-17 00:00:00+00' GROUP BY source,event_kind ORDER BY source,event_kind")]:
   out[name]=[dict(r) for r in (await s.execute(text(q))).mappings().all()]
  print(json.dumps(out,default=str))
asyncio.run(main())'''
print(subprocess.check_output(['docker','exec','valoria_oracle_beta-api-1','python','-B','-c',code],text=True))
print(subprocess.check_output(['journalctl','-u','valoria-uf-calendar.service','--since','2026-10-17 04:30:00 UTC','--until','2026-10-17 04:45:00 UTC','--no-pager','-o','short-iso'],text=True))
