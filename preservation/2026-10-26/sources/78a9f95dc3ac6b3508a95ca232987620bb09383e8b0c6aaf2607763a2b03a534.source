from __future__ import annotations
from contextlib import contextmanager
from dataclasses import dataclass
import hashlib
import json
import multiprocessing
import os
from pathlib import Path
import sqlite3
import threading
import time
import uuid

from .normalize import normalize, Thumbnail
from .security import source_url, fetch, Rejected
from .metrics import peak_rss_bytes

SURFACES = frozenset({'portfolio', 'radar', 'watchlist', 'detail'})
TTL = 90 * 86400
LEASE = 30
JOB_TIMEOUT = 20
ASSET_QUOTA = 2 * 1024**3


@dataclass(frozen=True)
class Context:
    surface: str
    visible: bool
    authorized: bool
    owner: str


def should_have_thumbnail(listing: dict, context: Context) -> bool:
    return (context.surface in SURFACES and context.visible and context.authorized
            and bool(context.owner) and isinstance(listing.get('listing_id'), int)
            and not isinstance(listing['listing_id'], bool) and listing['listing_id'] > 0
            and listing.get('source') in ('yapo', 'portal', 'portalinmobiliario')
            and not any(listing.get(k) for k in ('historical', 'comparable', 'discarded')))


def references(listing: dict) -> list[str]:
    def mapping(value): return value if isinstance(value,dict) else {}
    metadata = mapping(listing.get('raw_metadata'))
    evidence = mapping(listing.get('_source_evidence'))
    if 'raw_state' in listing:
        evidence = mapping(mapping(listing.get('raw_state')).get('_source_evidence')) or evidence
        metadata = mapping(mapping(listing.get('parsed_state')).get('raw_metadata')) or metadata
    candidates = [metadata.get('main_image_url')]
    urls = mapping(evidence.get('parsed_signals')).get('image_urls')
    candidates += urls[:16] if isinstance(urls,list) else []
    # Portal gallery entries often contain only IDs; og:image is preserved in
    # meta_raw and is an exact source URL, preferable to inventing a CDN URL.
    metas = mapping(evidence.get('raw')).get('meta_raw')
    for meta in metas[:16] if isinstance(metas,list) else []:
        if isinstance(meta,dict) and meta.get('property') == 'og:image':
            candidates.append(meta.get('content'))
    result = []
    for url in candidates[:16]:
        try:
            source_url(url)
        except Rejected:
            continue
        if url not in result:
            result.append(url)
    return result[:3]  # bounded fallback, never download an album


def attach_visible(store, listing, context):
    """Best-effort presentation enrichment; storage failure cannot hide listing data."""
    try:
        reference = store.request(listing,context)
    except (OSError,sqlite3.Error):
        reference = None
    return {**listing,'thumbnail':reference}


class Store:
    def __init__(self, root: Path, quota_bytes=ASSET_QUOTA):
        self.quota_bytes = quota_bytes
        self.root = Path(root).resolve()
        self.root.mkdir(parents=True, exist_ok=True)
        self.assets = self.root/'assets'
        self.assets.mkdir(exist_ok=True)
        self.db = self.root/'thumbnail.sqlite3'
        self._lock = threading.RLock()
        self._db = sqlite3.connect(self.db,timeout=2,check_same_thread=False)
        self._db.row_factory = sqlite3.Row
        with self.connection() as db:
            db.executescript('''
            PRAGMA journal_mode=WAL;
            PRAGMA synchronous=NORMAL;
            CREATE TABLE IF NOT EXISTS thumbnails (
                listing_id INTEGER PRIMARY KEY, source TEXT NOT NULL,
                status TEXT NOT NULL, asset_key TEXT, content_hash TEXT,
                format TEXT, width INTEGER, height INTEGER, bytes INTEGER,
                source_hash TEXT, created_at REAL, refreshed_at REAL,
                last_seen REAL NOT NULL, failure TEXT, version INTEGER DEFAULT 1,
                metrics TEXT);
            CREATE TABLE IF NOT EXISTS memberships (
                listing_id INTEGER NOT NULL, owner TEXT NOT NULL, surface TEXT NOT NULL,
                last_seen REAL NOT NULL, PRIMARY KEY(listing_id, owner, surface));
            CREATE TABLE IF NOT EXISTS jobs (
                listing_id INTEGER PRIMARY KEY, refs TEXT NOT NULL,
                attempt INTEGER NOT NULL DEFAULT 0, due REAL NOT NULL,
                lease_until REAL, token TEXT);
            CREATE INDEX IF NOT EXISTS jobs_due ON jobs(due, lease_until);
            CREATE INDEX IF NOT EXISTS thumbnails_seen ON thumbnails(last_seen);
            CREATE INDEX IF NOT EXISTS thumbnails_asset ON thumbnails(asset_key);
            ''')

    @contextmanager
    def connection(self):
        # One small local-cache connection per process avoids open/checkpoint on
        # every visible card. The lock is never held during fetching/encoding.
        with self._lock:
            try:
                yield self._db
                self._db.commit()
            except BaseException:
                self._db.rollback()
                raise

    def close(self):
        with self._lock:
            self._db.close()

    def request(self, listing: dict, context: Context, now=None):
        """Called only on authorized selected results. Never fetches/decodes."""
        if not should_have_thumbnail(listing, context):
            return None
        now = time.time() if now is None else now
        lid = listing['listing_id']
        refs = references(listing)
        with self.connection() as db:
            db.execute('BEGIN IMMEDIATE')
            row = db.execute('SELECT * FROM thumbnails WHERE listing_id=?', (lid,)).fetchone()
            if row and row['source'] != listing['source']:
                return None  # never reuse a mismatched source identity
            db.execute('INSERT OR REPLACE INTO memberships VALUES (?,?,?,?)',
                       (lid, context.owner, context.surface, now))
            if row:
                db.execute('UPDATE thumbnails SET last_seen=? WHERE listing_id=?', (now,lid))
                if row['status'] == 'ready' and self.valid_asset(dict(row)):
                    return self.reference(dict(row))
                if row['status'] == 'failed' and now - (row['refreshed_at'] or 0) < 86400:
                    return None
            else:
                db.execute('INSERT INTO thumbnails(listing_id,source,status,last_seen) VALUES (?,?,?,?)',
                           (lid, listing['source'], 'missing', now))
            if refs:
                db.execute('INSERT OR IGNORE INTO jobs(listing_id,refs,due) VALUES (?,?,?)',
                           (lid,json.dumps(refs),now))
                db.execute("UPDATE thumbnails SET status='pending' WHERE listing_id=?",(lid,))
            else:
                db.execute("UPDATE thumbnails SET status='missing',failure='no_source' WHERE listing_id=?",(lid,))
        return None

    def reference(self, row):
        return {'url': '/sandbox/assets/'+row['asset_key'], 'width': row['width'],
                'height': row['height'], 'bytes': row['bytes'], 'hash': row['content_hash']}

    def lookup(self, listing_id):
        with self.connection() as db:
            row = db.execute("SELECT * FROM thumbnails WHERE listing_id=? AND status='ready'",(listing_id,)).fetchone()
            return self.reference(dict(row)) if row and self.valid_asset(dict(row)) else None

    def valid_asset(self, row):
        path = self.assets/row['asset_key'] if row.get('asset_key') else None
        return bool(path and path.is_file() and path.stat().st_size == row['bytes']
                    and hashlib.sha256(path.read_bytes()).hexdigest() == row['content_hash'])

    def claim(self, now=None):
        now = time.time() if now is None else now
        with self.connection() as db:
            db.execute('BEGIN IMMEDIATE')
            job = db.execute('SELECT * FROM jobs WHERE due<=? AND (lease_until IS NULL OR lease_until<=?) ORDER BY due LIMIT 1', (now,now)).fetchone()
            if not job:
                return None
            token = uuid.uuid4().hex
            db.execute('UPDATE jobs SET token=?,lease_until=? WHERE listing_id=?',
                       (token,now+LEASE,job['listing_id']))
            return {**dict(job), 'token':token}

    def finish(self, job, thumb: Thumbnail, source_hash: str, now=None):
        now = time.time() if now is None else now
        key = thumb.digest + ('.webp' if thumb.format == 'webp' else '.jpg')
        temp = self.assets/(uuid.uuid4().hex+'.tmp')
        try:
            with temp.open('xb') as output:
                output.write(thumb.data)
                output.flush()
                os.fsync(output.fileno())
            with self.connection() as db:
                db.execute('BEGIN IMMEDIATE')
                current = db.execute('SELECT token FROM jobs WHERE listing_id=?',(job['listing_id'],)).fetchone()
                if not current or current['token'] != job['token']:
                    return False
                used = db.execute('SELECT COALESCE(SUM(bytes),0) FROM (SELECT MAX(bytes) bytes FROM thumbnails WHERE asset_key IS NOT NULL GROUP BY asset_key)').fetchone()[0]
                exists = db.execute('SELECT 1 FROM thumbnails WHERE asset_key=? LIMIT 1',(key,)).fetchone()
                if used + (0 if exists else len(thumb.data)) > self.quota_bytes:
                    raise Rejected('storage_budget')
                os.replace(temp,self.assets/key)
                db.execute('''UPDATE thumbnails SET status='ready',asset_key=?,content_hash=?,format=?,
                    width=?,height=?,bytes=?,source_hash=?,created_at=COALESCE(created_at,?),
                    refreshed_at=?,failure=NULL,metrics=? WHERE listing_id=?''',
                    (key,thumb.digest,thumb.format,thumb.width,thumb.height,len(thumb.data),
                     source_hash,now,now,json.dumps(thumb.metrics),job['listing_id']))
                db.execute('DELETE FROM jobs WHERE listing_id=?',(job['listing_id'],))
            return True
        finally:
            temp.unlink(missing_ok=True)

    def fail(self, job, code: str, now=None):
        now = time.time() if now is None else now
        transient = code in ('timeout','network_failure','worker_timeout','worker_crash','http_429','http_500','http_502','http_503','http_504')
        with self.connection() as db:
            db.execute('BEGIN IMMEDIATE')
            current = db.execute('SELECT token FROM jobs WHERE listing_id=?',(job['listing_id'],)).fetchone()
            if not current or current['token'] != job['token']:
                return
            attempt = job['attempt']+1
            if transient and attempt < 3:
                db.execute('UPDATE jobs SET attempt=?,due=?,lease_until=NULL,token=NULL WHERE listing_id=?',
                           (attempt,now+(5,30)[attempt-1],job['listing_id']))
            else:
                db.execute('DELETE FROM jobs WHERE listing_id=?',(job['listing_id'],))
                db.execute("UPDATE thumbnails SET status='failed',failure=?,refreshed_at=? WHERE listing_id=?",(code,now,job['listing_id']))

    def leave(self, listing_id, context, now=None):
        with self.connection() as db:
            db.execute('DELETE FROM memberships WHERE listing_id=? AND owner=? AND surface=?',
                       (listing_id,context.owner,context.surface))

    def gc(self, now=None):
        now = time.time() if now is None else now
        with self.connection() as db:
            db.execute('BEGIN IMMEDIATE')
            # Every membership expires after 90d without re-observation. Leaving
            # a surface removes its pin; last_seen still provides grace.
            db.execute('DELETE FROM memberships WHERE last_seen<?',(now-TTL,))
            db.execute('''DELETE FROM thumbnails WHERE last_seen<?
                AND listing_id NOT IN (SELECT listing_id FROM memberships)
                AND listing_id NOT IN (SELECT listing_id FROM jobs WHERE lease_until>?)''',(now-TTL,now))
            db.execute('DELETE FROM jobs WHERE listing_id NOT IN (SELECT listing_id FROM thumbnails)')
            live = {r[0] for r in db.execute('SELECT asset_key FROM thumbnails WHERE asset_key IS NOT NULL')}
            deleted = 0
            for path in self.assets.iterdir():
                if path.name not in live and path.stat().st_mtime < now-86400:
                    path.unlink()
                    deleted += 1
            return deleted


def process_refs(refs, provider=None):
    started = time.perf_counter()
    cpu_start = time.process_time()
    last = 'no_source'
    for ref in refs:
        try:
            download = (provider or fetch)(ref)
            thumb = normalize(download.body, download.mime)
            thumb.metrics.update(download_ms=download.elapsed_ms,
                                 total_ms=(time.perf_counter()-started)*1000,
                                 cpu_ms=(time.process_time()-cpu_start)*1000,
                                 peak_rss_bytes=peak_rss_bytes())
            return thumb, download.source_hash
        except Rejected as exc:
            last = str(exc)
            if last in ('timeout','network_failure'):
                break
    raise Rejected(last)


def _child(refs, pipe):
    try:
        if os.name == 'posix':
            import resource
            resource.setrlimit(resource.RLIMIT_AS,(512*1024*1024,512*1024*1024))
            resource.setrlimit(resource.RLIMIT_CPU,(15,15))
        pipe.send(('ok',process_refs(refs)))
    except Rejected as exc:
        pipe.send(('error',str(exc)))
    except Exception:
        pipe.send(('error','worker_crash'))
    finally:
        pipe.close()


def bounded_process(refs, timeout=JOB_TIMEOUT, target=_child):
    context = multiprocessing.get_context('spawn')
    parent, child = context.Pipe(duplex=False)
    process = context.Process(target=target,args=(refs,child))
    process.start()
    child.close()
    try:
        if not parent.poll(timeout):
            raise Rejected('worker_timeout')
        try:
            status, payload = parent.recv()
        except EOFError as exc:
            raise Rejected('worker_crash') from exc
        if status != 'ok':
            raise Rejected(payload)
        return payload
    finally:
        if process.is_alive():
            process.terminate()
        process.join(timeout=2)
        parent.close()


def work_one(store: Store, provider=None, now=None):
    job = store.claim(now)
    if not job:
        return False
    try:
        refs = json.loads(job['refs'])
        if provider is not None:  # deterministic offline replay only
            result = process_refs(refs, provider)
        else:
            result = bounded_process(refs)
        store.finish(job,*result,now=now)
    except Rejected as exc:
        store.fail(job,str(exc),now=now)
    except (OSError, sqlite3.Error):
        # If metadata is itself unavailable the lease expires and restart retries.
        try:
            store.fail(job,'storage_or_worker_failure',now=now)
        except (OSError,sqlite3.Error):
            pass
    return True
