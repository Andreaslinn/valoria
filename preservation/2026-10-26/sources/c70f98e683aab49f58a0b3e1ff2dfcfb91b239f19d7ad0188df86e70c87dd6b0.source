FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000

WORKDIR /app

COPY pyproject.toml README.md ./
COPY alembic.ini ./
COPY alembic ./alembic
COPY api ./api
COPY audits ./audits
COPY config ./config
COPY core ./core
COPY domain ./domain
COPY infrastructure ./infrastructure
COPY scripts ./scripts
COPY services ./services
COPY workers ./workers
# Shared HTML report rendering used by the API.
COPY ui/__init__.py ui/formatting.py ./ui/
COPY ui/components/__init__.py ui/components/risk_report_contract.py ui/components/risk_report_html.py ./ui/components/

RUN python -m pip install --upgrade pip && python -m pip install -e .

EXPOSE 8000

CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
