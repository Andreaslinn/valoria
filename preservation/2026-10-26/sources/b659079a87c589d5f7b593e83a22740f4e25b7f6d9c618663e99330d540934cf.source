import subprocess
from pathlib import Path
exec(Path(__file__).with_name('portal_runtime_inventory.py').read_text().split('inner=')[0])
code='''import subprocess,json,pathlib,re
root=pathlib.Path('/home/ubuntu/apps/valoria');x=json.loads(subprocess.check_output(['docker','inspect','valoria_oracle_beta-api-1']))[0]
args=['docker','compose','--project-name','valoria_oracle_beta','--env-file',str(root/'deploy/oracle.env')]
for f in x['Config']['Labels']['com.docker.compose.project.config_files'].split(','):args+=['-f',f]
for kind,a in [('original',args),('candidate',args+['-f',str(root/'deploy/remediation-portal-active.override.yml')])]:
 r=subprocess.run(a+['config','--format','json'],capture_output=True,text=True,cwd=root)
 safe=[]
 for line in r.stderr.splitlines():
  if any(k in line.lower() for k in ['password','cookie','token','secret','authorization']):continue
  safe.append(re.sub(r'https?://[^\\s]+','[url omitted]',line))
 print(json.dumps({'config':kind,'exit':r.returncode,'safe_diagnostics':safe}))
print(json.dumps({'active_image':x['Image'],'override_text':(root/'deploy/remediation-portal-active.override.yml').read_text()}))
'''
r=subprocess.run(ssh+['python3 -B -'],input=code,text=True,capture_output=True,timeout=45);Path(__file__).with_name('portal-release-config-diagnostic.json').write_text(r.stdout,encoding='utf-8');print(r.stdout);r.check_returncode()
