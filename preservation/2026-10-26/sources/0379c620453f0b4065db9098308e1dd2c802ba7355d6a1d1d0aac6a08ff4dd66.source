const fs=require('fs'),path=require('path'),assert=require('assert');
const {chromium}=require('C:/Users/heiko/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright');
async function main(){
 const result={checks:[],surfaces:{},imageRequests:[],errors:[]};
 const context=await chromium.launchPersistentContext(path.resolve('validation/edge-profile'),{channel:'msedge',headless:true,viewport:{width:1365,height:1000}});
 await context.addInitScript(()=>localStorage.setItem('valoria_access_token','offline-validation'));
 await context.route('**/*',route=>{const url=new URL(route.request().url());return ['127.0.0.1','localhost'].includes(url.hostname)?route.continue():route.abort();});
 const page=await context.newPage();page.setDefaultTimeout(30000);
 page.on('pageerror',e=>result.errors.push(e.message));
 page.on('request',r=>{if(r.url().includes('/thumbnails/'))result.imageRequests.push(r.url());});
 const check=(label,ok)=>{assert(ok,label);result.checks.push(label);};
 const loaded=async locator=>{await locator.waitFor();await page.waitForFunction(el=>el.complete&&el.naturalWidth>0,await locator.elementHandle());};
 try{
  await page.goto('http://127.0.0.1:3116/portfolio',{waitUntil:'networkidle',timeout:120000});
  await loaded(page.locator('.portfolio-row .property-photo img').first());
  await loaded(page.locator('.portfolio-detail .property-photo img'));
  check('Cartera rows and selected detail use real WebP',true);
  result.surfaces.portfolio={slots:await page.locator('.property-photo').count(),requests:result.imageRequests.length};
  const slot=page.locator('.portfolio-detail .property-photo');const before=await slot.boundingBox();
  await slot.locator('img').dispatchEvent('error');await page.waitForFunction(()=>document.querySelector('.portfolio-detail .property-photo')?.dataset.photoState==='fallback');
  const after=await slot.boundingBox();check('Load/decode failure keeps dimensions',before.width===after.width&&before.height===after.height);
  check('Failure replaces broken image immediately',await slot.locator('img').count()===0);
  await page.locator('.portfolio-row').filter({hasText:'Propiedad offline 3'}).click();await loaded(slot.locator('img'));
  check('Changed reference resets failed state',true);
  await page.locator('.portfolio-row').filter({hasText:'Propiedad offline 2'}).click();check('Cartera null fallback',await slot.getAttribute('data-photo-state')==='fallback');
  await page.screenshot({path:'validation/portfolio.png',fullPage:true});
  await page.goto('http://127.0.0.1:3116/radar',{waitUntil:'networkidle',timeout:120000});
  await page.getByRole('button',{name:'Buscar oportunidades',exact:true}).first().click();
  await loaded(page.locator('.radar-focus .property-photo img'));
  check('Radar API photo renders',true);
  const row=page.locator('.radar-row-property').filter({hasText:'Propiedad offline 2'});
  await row.click();check('Radar null fallback',await page.locator('.radar-focus .property-photo').getAttribute('data-photo-state')==='fallback');
  await page.locator('.radar-row-property').filter({hasText:'Propiedad offline 1'}).click();
  await loaded(page.locator('.radar-focus .property-photo img'));
  await page.getByRole('button',{name:'Guardados',exact:true}).click();
  await loaded(page.locator('.radar-focus .property-photo img'));check('Guardadas API photo renders',true);
  await page.locator('.radar-row-property').filter({hasText:'Propiedad offline 2'}).click();
  check('Guardadas shares null fallback',await page.locator('.radar-focus .property-photo').getAttribute('data-photo-state')==='fallback');
  await page.locator('.radar-row-property').filter({hasText:'Propiedad offline 1'}).click();
  await page.screenshot({path:'validation/radar.png',fullPage:true});
  result.surfaces.radar={slots:await page.locator('.property-photo').count()};
  await page.goto('http://127.0.0.1:3116/analizar-url',{waitUntil:'networkidle',timeout:120000});
  await page.locator('#analyze-url').fill('https://www.yapo.cl/offline/1');await page.getByRole('button',{name:'Consultar publicación',exact:true}).click();
  await loaded(page.locator('.analyze-property .property-photo img'));check('Ficha consumes listing_data.thumbnail',true);
  check('Lazy loading and asynchronous decoding',await page.locator('.analyze-property img').getAttribute('loading')==='lazy'&&await page.locator('.analyze-property img').getAttribute('decoding')==='async');
  await page.screenshot({path:'validation/ficha.png',fullPage:true});
  await page.route('**/api/v1/listings/lookup-url',async route=>{const response=await route.fetch();const data=await response.json();data.listing_data.thumbnail.url='https://invalid.example/image';await route.fulfill({response,json:data});});
  await page.getByRole('button',{name:'Consultar publicación',exact:true}).click();
  await page.waitForFunction(()=>document.querySelector('.analyze-property .property-photo')?.dataset.photoState==='fallback');check('Invalid image URL falls back without external request',true);
  await page.unroute('**/api/v1/listings/lookup-url');
  const watchlist=await (await context.request.get('http://127.0.0.1:8116/api/v1/watchlist')).json();
  const refs=watchlist.filter(item=>item.thumbnail).map(item=>item.thumbnail);
  let override=refs[0],mode='404',release;
  await page.route('**/api/v1/listings/lookup-url',async route=>{const response=await route.fetch();const data=await response.json();data.listing_data.thumbnail=override;await route.fulfill({response,json:data});});
  await page.route('**/api/v1/thumbnails/**',async route=>{
    if(mode==='404')return route.fulfill({status:404,body:'missing'});
    if(mode==='network')return route.abort('failed');
    if(mode==='decode')return route.fulfill({status:200,contentType:'image/webp',body:'invalid image body'});
    await new Promise(resolve=>{release=resolve});return route.continue();
  });
  for(const [i,kind] of ['404','network','decode'].entries()){
    mode=kind;override=refs[i];await page.getByRole('button',{name:'Consultar publicación',exact:true}).click();
    await page.waitForFunction(()=>document.querySelector('.analyze-property .property-photo')?.dataset.photoState==='fallback');
    check(`Native ${kind} image failure uses fallback`,await page.locator('.analyze-property .property-photo img').count()===0);
  }
  mode='loading';override=refs[0];await page.getByRole('button',{name:'Consultar publicación',exact:true}).click();
  await page.locator('.analyze-property .property-photo img').waitFor();
  const pendingBox=await page.locator('.analyze-property .property-photo').boundingBox();
  while(!release)await new Promise(resolve=>setTimeout(resolve,50));release();
  await loaded(page.locator('.analyze-property .property-photo img'));
  const loadedBox=await page.locator('.analyze-property .property-photo').boundingBox();
  check('Reserved loading slot matches loaded dimensions',pendingBox.width===loadedBox.width&&pendingBox.height===loadedBox.height);
  check('No JavaScript errors',result.errors.length===0);
 }finally{fs.writeFileSync('validation/v2-browser-results.json',JSON.stringify(result,null,2));await context.close();}
 console.log(JSON.stringify(result,null,2));
}
main().catch(e=>{console.error(e);process.exit(1)});
