"""Deterministic-value UF fixture; never call a real provider during reconciliation."""
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, HTTPServer
import json

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path != '/uf': self.send_error(404); return
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps({'serie': [{'valor': 41000, 'fecha': datetime.now(timezone.utc).isoformat()}]}).encode())

    def log_message(self, *args): pass

if __name__ == '__main__':
    HTTPServer(('0.0.0.0', 8080), Handler).serve_forever()
