from pathlib import Path
import json,httpx
from playwright.sync_api import sync_playwright,expect
ROOT=Path(__file__).parent/'e2e-portal';API='http://127.0.0.1:18013';BASE='http://127.0.0.1:3003';events=[]
r=httpx.post(API+'/api/v1/auth/login',data={'username':'portal-candidate@example.test','password':'[REDACTED]'});r.raise_for_status();token=r.json()['access_token']
with sync_playwright() as pw:
 b=pw.chromium.launch(headless=True);ctx=b.new_context(viewport={'width':1440,'height':1000});ctx.tracing.start(screenshots=True,snapshots=True);page=ctx.new_page()
 def forward(route):
  path=route.request.url.split('/api/v1/',1)[1];response=route.fetch(url=API+'/api/v1/'+path,timeout=90000)
  if path=='listings/lookup-url':events.append({'status':response.status,'payload':response.json()})
  route.fulfill(response=response)
 page.route('**/api/v1/**',forward);page.goto(BASE+'/analizar-url');page.evaluate('(t)=>localStorage.setItem("valoria_access_token",t)',token);page.reload(wait_until='networkidle')
 page.get_by_label('URL de la publicación',exact=True).fill('https://www.portalinmobiliario.com/MLC-123456789-publicacion-no-disponible-_JM');page.get_by_role('button',name='Consultar publicación',exact=True).click()
 page.wait_for_function("!document.querySelector('button[type=submit]') || true")
 expect(page.locator('.analyze-property')).not_to_be_visible()
 page.wait_for_timeout(1000)
 if not events:
  with page.expect_response(lambda r:'/listings/lookup-url' in r.url,timeout=90000):pass
 assert events and events[0]['status'] in [404,502,503,504],events
 assert events[0]['status']!=429,'Isolated test rate limit exhausted'
 detail=events[0]['payload'].get('detail',{});code=detail.get('code') if isinstance(detail,dict) else None
 if code:
  expect(page.locator('body')).to_contain_text(detail['message']);expect(page.locator('body')).not_to_contain_text('La tasa UF real no está disponible')
 expect(page.locator('.analyze-property')).not_to_be_visible();page.screenshot(path=str(ROOT/'20-unavailable-new-no-active-listing.png'),full_page=True)
 ctx.tracing.stop(path=str(ROOT/'portal-unavailable-trace.zip'));ctx.close();b.close()
(ROOT/'unavailable-result.json').write_text(json.dumps({'name':'20-new-unavailable-no-active-listing','status':'PASS','http_events':events},indent=2,ensure_ascii=False),encoding='utf-8');print('PASS20',events[0]['status'],code)
