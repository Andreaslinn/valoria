import pytest
from fastapi.testclient import TestClient


def test_flag_off_removes_route(monkeypatch):
    monkeypatch.setenv("PROPERTY_LIFE_ENABLED", "false")
    from api.main import create_app

    app = create_app()
    assert "/property/life" not in {r.path for r in app.routes}


def test_flag_on_validation_and_declared_price(monkeypatch):
    monkeypatch.setenv("PROPERTY_LIFE_ENABLED", "true")
    monkeypatch.setenv(
        "PROPERTY_LIFE_DATABASE_URL", "postgresql+psycopg://[USER]:[PASSWORD]@127.0.0.1:55439/property_life_local"
    )
    import api.property_life as router_module

    monkeypatch.setattr(
        router_module,
        "life",
        lambda direccion, comuna: {
            "direccion": direccion,
            "comuna": comuna,
            "terminologia": "precio de transacción declarado",
            "historial": [],
            "comparables": [],
            "confianza_conteo": {},
        },
    )
    from api.main import create_app

    client = TestClient(create_app())
    response = client.post(
        "/property/life", json={"direccion": "Samotracia 2071", "comuna": "Vitacura"}
    )
    assert response.status_code == 200
    assert response.json()["terminologia"] == "precio de transacción declarado"
    assert (
        client.post("/property/life", json={"direccion": "", "comuna": "Vitacura"}).status_code
        == 422
    )


def test_production_config_stops_before_app_creation(monkeypatch):
    monkeypatch.setenv("PROPERTY_LIFE_ENABLED", "true")
    monkeypatch.setenv("DATABASE_URL", "postgresql+asyncpg://[USER]:[PASSWORD]@production.example:5432/avm")
    from api.main import create_app

    with pytest.raises(RuntimeError, match="externa/producción"):
        create_app()
