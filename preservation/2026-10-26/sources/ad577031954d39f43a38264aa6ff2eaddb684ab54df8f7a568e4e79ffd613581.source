from sqlalchemy import text
from infrastructure.db.database import get_session_factory
async def main():
 async with get_session_factory()() as s:
  await s.execute(text("SET TRANSACTION READ ONLY"))
  rows=(await s.execute(text("SELECT id,title,source,external_id,property_type,status,m2,built_area_m2,usable_area_m2, raw_metadata->>'property_type' AS original_type, raw_metadata->>'category' AS category, raw_metadata->>'source_category' AS source_category FROM listings WHERE id=6842"))).mappings().all()
  print(json.dumps({"classification_fixture":[dict(r) for r in rows]},default=str))
  rows=(await s.execute(text("SELECT comuna,count(*) AS offices,count(*) FILTER (WHERE coalesce(built_area_m2,usable_area_m2,m2)>0 AND price_clp>0) AS valid_area_price FROM listings WHERE property_type='office' AND status='active' GROUP BY comuna ORDER BY offices DESC"))).mappings().all()
  print(json.dumps({"active_office_coverage":[dict(r) for r in rows]},default=str))
asyncio.run(main())
'''
