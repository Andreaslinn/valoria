import unittest,math,json,copy,socket
from dataclasses import replace,asdict
from decimal import Decimal
from unittest.mock import patch
from avm01.data import InvalidExperiment,RealExecutionBlocked,Record,Inference
from avm01.fixtures import synthetic
from avm01.splits import Split,make_plan,validate_split,inner_folds,validate_plan
from avm01.isolation import dependency_components,index_ids,LabelCustody,prepare_batch,FitBatch
from avm01.engines import FrozenA,LearnedEngine,Prediction,DEFAULTS
from avm01.harness import CONFIG,run,run_split,nested_tune_synthetic
from avm01.canonical_io import listing_from_payload
from core.entities.listing import Listing,Property
from core.value_objects.price import Price
from core.value_objects.location import Coordinates
from domain.valuation.engines.canonical_comparables import ComparablesCanonicalEngine
from domain.valuation.engines.contracts import EngineRequest,EngineContext
from domain.valuation.scoring import similarity_score
from config.constants import MIN_COMPARABLES,COMPARABLES_M2_TOLERANCE,TOP_N_COMPARABLES
from datetime import datetime

def altered(ds,i,**changes):
    return replace(ds,records=tuple(replace(r,**changes) if r.row_id==i else r for r in ds.records))

def direct_listing(payload):
    # Independent DTO construction, not the experimental conversion helper.
    p=copy.deepcopy(payload);p['price']=Price(Decimal(p['price']['clp']))
    if p.get('price_uf') is not None:p['price_uf']=Decimal(p['price_uf'])
    for k in ['scraped_at','last_seen_at','last_refresh_attempted_at']:
        if p.get(k):p[k]=datetime.fromisoformat(p[k])
    if p.get('coordinates'):p['coordinates']=Coordinates(**p['coordinates'])
    return Listing(**p)

def direct_target(payload):
    p=copy.deepcopy(payload)
    if p.get('coordinates'):p['coordinates']=Coordinates(**p['coordinates'])
    return Property(**p)

def mutate(ds,i,**values):
    r=ds.indexed()[i];f=dict(r.features);listing=copy.deepcopy(r.canonical_listing);target=copy.deepcopy(r.canonical_target)
    for k in ['comuna','bedrooms','bathrooms','parking']:
        if k in values:f[k]=values[k];listing[k]=target[k]=values[k]
    if 'area' in values:
        area=values['area'];f['log_area']=math.log(area)
        for p in [listing,target]:p['m2']=p['built_area_m2']=area
    listing.update(values.get('listing',{}));target.update(values.get('target',{}))
    xy=target.get('coordinates')
    if 'coordinates' in values.get('target',{}) and 'coordinates' not in values.get('listing',{}):listing['coordinates']=copy.deepcopy(xy)
    return altered(ds,i,features=f,canonical_listing=listing,canonical_target=target,latitude=xy['lat'] if xy else None,longitude=xy['lon'] if xy else None)

class CanonicalParity(unittest.TestCase):
    def setUp(self):
        self.ds=synthetic(30);self.ids=index_ids(self.ds);self.target=self.ids[-1];self.train=self.ids[:-1]
    def compare(self,ds=None,train=None):
        ds=ds or self.ds;train=self.train if train is None else train;split=Split(tuple(train),(self.target,))
        batch=prepare_batch(ds,split,CONFIG);adapter=FrozenA().fit(batch);pred=adapter.predict(batch.target(self.target));idx=ds.indexed()
        engine=ComparablesCanonicalEngine(name='comparables_canonical_outliers',variant='outliers')
        result=engine.valuate(EngineRequest(evaluation_id=self.target,engine_name=engine.name,published_price_provided=False),
            EngineContext(target=direct_target(idx[self.target].canonical_target),candidates=tuple(direct_listing(idx[i].canonical_listing) for i in sorted(train)),
                uf_to_clp=Decimal(CONFIG['uf_reference']['value']),valuation_date=datetime.fromisoformat(idx[self.target].prediction_at)))
        self.assertEqual(pred.trace['canonical_result'],result.to_dict())
        self.assertEqual(pred.status,result.status)
        self.assertEqual(pred.value_uf,float(result.estimated_price_uf) if result.is_successful else None)
        return pred,result
    def test_selection_top_n_scores_weights_and_estimate(self):
        pred,result=self.compare()
        self.assertEqual(result.comparables_used,TOP_N_COMPARABLES)
        idx=self.ds.indexed();target=direct_target(idx[self.target].canonical_target)
        mapping={(r.canonical_listing['id'],r.canonical_listing['fingerprint']):r for r in self.ds.records if r.row_id in self.train}
        for c in result.selected_comparables:
            self.assertEqual(c.score,round(similarity_score(target,direct_listing(mapping[c.listing_id,c.fingerprint].canonical_listing)).value,4))
        self.assertTrue(result.diagnostics['result']['comparable_weights'])
        self.assertGreater(result.estimated_price_uf,0)
    def test_comuna_and_inactive_exclusions(self):
        ds=mutate(self.ds,self.train[0],comuna='another-comuna');ds=mutate(ds,self.train[1],listing={'status':'inactive'})
        _,r=self.compare(ds)
        self.assertEqual(r.diagnostics['exclusions']['comuna_mismatch'],1);self.assertEqual(r.diagnostics['exclusions']['inactive'],1)
    def test_area_boundaries_exact_and_outside(self):
        area=self.ds.indexed()[self.target].canonical_target['built_area_m2']
        ds=self.ds
        for i,a in zip(self.train[:4],[area*(1-COMPARABLES_M2_TOLERANCE),area*(1+COMPARABLES_M2_TOLERANCE),area*(1-COMPARABLES_M2_TOLERANCE)-.01,area*(1+COMPARABLES_M2_TOLERANCE)+.01]):ds=mutate(ds,i,area=a)
        _,r=self.compare(ds)
        self.assertEqual(r.diagnostics['pool']['candidates_structurally_eligible'],len(self.train)-2)
    def test_precise_geo_filters_and_neutral_source_pin(self):
        xy={'lat':-33.45,'lon':-70.65};far={'lat':-33.6,'lon':-70.9}
        ds=mutate(self.ds,self.target,target={'coordinates':xy,'geocode_precision':'address'})
        ds=mutate(ds,self.train[0],target={'coordinates':far,'geocode_precision':'address'},listing={'coordinates':far,'geocode_precision':'address'})
        ds=mutate(ds,self.train[1],target={'coordinates':far,'geocode_precision':'comuna_centroid'},listing={'coordinates':far,'geocode_precision':'comuna_centroid'})
        _,r=self.compare(ds)
        self.assertEqual(r.diagnostics['pool']['candidates_structurally_eligible'],len(self.train)-1)
    def test_geo_metadata_projection_preserves_existing_score_contract(self):
        signals={'nearby_metro':'parque almagro','nearby_avenue':None,'neighborhood_hint':None,'intersection_hint':None,'landmark_tokens':['parque almagro'],'confidence':.8,'reason':'fixture'}
        ds=mutate(self.ds,self.target,target={'raw_metadata':{'geo_signals':signals}})
        ds=mutate(ds,self.train[0],listing={'raw_metadata':dict(self.ds.indexed()[self.train[0]].canonical_listing['raw_metadata'],geo_signals=signals)})
        self.compare(ds)
    def test_price_free_target_product_and_location_text_preserved(self):
        ds=mutate(self.ds,self.target,target={'raw_metadata':{'description':'Departamento para remodelar cerca de metro parque almagro','address_label':'Calle de fixture 120'}})
        self.compare(ds)
    def test_raw_metadata_currency_provenance_and_mixed_CLP_preserved(self):
        ds=mutate(self.ds,self.train[0],listing={'price_currency':'CLP','price_uf':None,'price_uf_source':None,'raw_metadata':{'currency_original':'CLP','opaque_source_payload':{'images':['one','two'],'address':'fixture street'}}})
        ds=mutate(ds,self.train[1],listing={'price_uf_source':'estimated','price_uf_confidence':'low'})
        ds=mutate(ds,self.train[2],listing={'price_uf_source':'legacy_unrecoverable'})
        before=copy.deepcopy(ds);_,r=self.compare(ds)
        self.assertEqual(ds,before)
        self.assertEqual(r.diagnostics['exclusions']['low_confidence_estimated'],1)
        self.assertEqual(r.diagnostics['exclusions']['legacy_unrecoverable'],1)
        payload=ds.indexed()[self.train[0]].canonical_listing
        native=listing_from_payload(payload)
        self.assertEqual(native.raw_metadata,payload['raw_metadata']);self.assertEqual(native.price_currency,'CLP');self.assertIsNone(native.price_uf)
    def test_original_fingerprint_dedup_is_preserved_not_replaced_by_group(self):
        fp=self.ds.indexed()[self.train[0]].canonical_listing['fingerprint']
        ds=mutate(self.ds,self.train[1],listing={'fingerprint':fp})
        _,r=self.compare(ds);self.assertEqual(r.diagnostics['exclusions']['duplicate'],1)
    def test_selection_trace_with_external_ID_only_preserves_lineage(self):
        ds=self.ds
        for i in self.train:ds=mutate(ds,i,listing={'id':None,'fingerprint':''})
        pred,r=self.compare(ds)
        from domain.valuation.comparables import score_and_rank
        idx=ds.indexed();target=direct_target(idx[self.target].canonical_target)
        ranked=score_and_rank(target,[direct_listing(idx[i].canonical_listing) for i in self.train])[:TOP_N_COMPARABLES]
        by_external={idx[i].canonical_listing['external_id']:i for i in self.train}
        self.assertEqual(pred.trace['selected_ids'],[by_external[c.external_id] for _,c in ranked])
        self.assertEqual(len(set(pred.trace['selected_ids'])),TOP_N_COMPARABLES)
    def test_robust_outlier_exclusion_and_surface_parity(self):
        ds=mutate(self.ds,self.train[0],listing={'price_uf':'500000','price':{'clp':str(Decimal('500000')*Decimal(CONFIG['uf_reference']['value']))}})
        _,r=self.compare(ds)
        self.assertGreater(r.diagnostics['high_outliers_excluded'],0);self.assertIn('surface',r.diagnostics['result'])
    def test_exact_minimum_and_abstention(self):
        pred,r=self.compare(train=self.train[:MIN_COMPARABLES]);self.assertIsNotNone(pred.value_uf)
        pred,r=self.compare(train=self.train[:MIN_COMPARABLES-1]);self.assertIsNone(pred.value_uf);self.assertEqual(r.status,'insufficient_data')
    def test_own_target_plus_four_independent_is_rejected(self):
        with self.assertRaisesRegex(InvalidExperiment,'partition|Group crosses'):prepare_batch(self.ds,Split(self.train[:4]+(self.target,),(self.target,)),CONFIG)
        with self.assertRaisesRegex(InvalidExperiment,'Group crosses'):prepare_batch(self.ds,Split(self.train[:4]+(self.target[:-1]+'1',),(self.target,)),CONFIG)
    def test_no_network_or_input_mutation(self):
        before=self.ds.hash()
        with patch.object(socket,'create_connection',side_effect=AssertionError('network forbidden')),patch.object(socket,'getaddrinfo',side_effect=AssertionError('network forbidden')),patch('config.settings.get_settings',side_effect=AssertionError('runtime settings forbidden')):
            a,_=self.compare();b,_=self.compare()
        self.assertEqual(a,b);self.assertEqual(before,self.ds.hash())
    def test_explicit_UF_context_not_adapter_constant(self):
        config=copy.deepcopy(CONFIG);config['uf_reference']['value']='42000'
        batch=prepare_batch(self.ds,Split(self.train,(self.target,)),config);p=FrozenA().fit(batch).predict(batch.target(self.target))
        self.assertEqual(p.trace['UF_reference']['value'],'42000')
        config['uf_reference']['available_at']='2026-02-01T00:00:00+00:00'
        batch=prepare_batch(self.ds,Split(self.train,(self.target,)),config)
        with self.assertRaisesRegex(InvalidExperiment,'Future UF'):FrozenA().fit(batch).predict(batch.target(self.target))

class IsolationRegression(unittest.TestCase):
    def setUp(self):self.ds=synthetic(18);self.ids=index_ids(self.ds);self.outer=Split(self.ids[:12],self.ids[12:]);self.hold=()
    def test_related_reservation_not_enumerated_in_split(self):
        with self.assertRaisesRegex(InvalidExperiment,'Holdout dependency'):validate_split(self.ds,Split(('fixture-000-1',),('fixture-001-0',)),('fixture-000-0',))
    def test_old_direct_inner_outer_crossing_rejected(self):
        outer=Split(('fixture-000-1',)+self.ids[1:8],('fixture-000-0',))
        with self.assertRaisesRegex(InvalidExperiment,'Group crosses'):inner_folds(self.ds,outer)
    def test_transitive_via_observation_outside_split(self):
        ds=replace(self.ds,dependency_links=(('fixture-000-0','fixture-001-1'),('fixture-001-1','fixture-002-0')))
        with self.assertRaisesRegex(InvalidExperiment,'Group crosses'):validate_split(ds,Split(('fixture-000-0',),('fixture-002-0',)))
        with self.assertRaisesRegex(InvalidExperiment,'Holdout dependency'):validate_split(ds,Split(('fixture-000-0',),('fixture-003-0',)),('fixture-002-0',))
    def test_external_alias_of_protected_group(self):
        ds=altered(self.ds,self.ids[0],dependency_aliases=('reviewed-cross-source-alias',));ds=altered(ds,self.ids[2],dependency_aliases=('reviewed-cross-source-alias',))
        with self.assertRaisesRegex(InvalidExperiment,'Holdout dependency'):validate_split(ds,Split((self.ids[2],),(self.ids[3],)),(self.ids[0],))
    def test_external_policy_accepted_not_property_id_truth(self):
        ds=replace(self.ds,grouping_policy='reviewed_dependency_fixture_v1',grouping_evidence_hash='reviewed-synthetic-evidence')
        plan=make_plan(ds);self.assertTrue(plan.folds)
        self.assertEqual(len(set(dependency_components(ds).values())),18)  # every raw property_id is 999
    def test_unassigned_historical_group_rejected(self):
        ds=altered(self.ds,'fixture-000-1',group_id=None)
        with self.assertRaisesRegex(InvalidExperiment,'dependency group'):validate_split(ds,self.outer)
    def test_new_relationship_invalidates_existing_plan(self):
        plan=make_plan(self.ds);ds=replace(self.ds,dependency_links=((plan.folds[0].train[0],plan.folds[0].test[0]),))
        with self.assertRaisesRegex(InvalidExperiment,'rebuild'):validate_plan(ds,plan)
    def test_custody_rejects_snapshot_or_policy_drift(self):
        custody=LabelCustody(self.ds)
        ds=replace(self.ds,dependency_links=((self.ids[0],self.ids[12]),))
        with self.assertRaisesRegex(InvalidExperiment,'changed'):custody.issue(ds,self.outer,CONFIG)
    def test_inner_direct_requires_outer_context(self):
        f=inner_folds(self.ds,self.outer)[0]
        with self.assertRaisesRegex(InvalidExperiment,'outer context'):prepare_batch(self.ds,f,CONFIG)
    def test_inner_outer_test_injected_rejected(self):
        f=inner_folds(self.ds,self.outer)[0];bad=replace(f,test=f.test+(self.outer.test[0],))
        with self.assertRaisesRegex(InvalidExperiment,'outer training'):prepare_batch(self.ds,bad,CONFIG,outer=self.outer)
    def test_unknown_duplicate_overlapping_folds_are_errors(self):
        for f in [Split(('unknown',),self.outer.test),Split((self.ids[0],self.ids[0]),self.outer.test),Split(self.outer.train,(self.ids[0],))]:
            with self.subTest(f=f),self.assertRaises(InvalidExperiment):run_split(self.ds,f,CONFIG)
    def test_oof_coverage_and_seed(self):
        p=make_plan(self.ds)
        with self.assertRaisesRegex(InvalidExperiment,'OOF'):validate_plan(self.ds,replace(p,folds=p.folds[:-1]+(p.folds[0],)))
        with self.assertRaisesRegex(InvalidExperiment,'seed'):validate_plan(self.ds,p,seed=43)
        with self.assertRaisesRegex(InvalidExperiment,'seed'):prepare_batch(self.ds,p.folds[0],dict(CONFIG,seed=43),p.holdout)
        with self.assertRaisesRegex(InvalidExperiment,'seed'):inner_folds(self.ds,p.folds[0],seed=43,reserved_holdout=p.holdout)
    def test_index_selection_is_explicit_price_free_and_does_not_inflate_N(self):
        p=make_plan(self.ds);self.assertEqual(len(p.development)+len(p.holdout),18);self.assertEqual(len(self.ds.records),36)
        ds=replace(self.ds,records=tuple(replace(r,price_uf=999999 if r.observation_id.endswith('0') else 1) for r in self.ds.records))
        self.assertEqual(index_ids(ds),index_ids(self.ds))
        self.assertTrue(all(i.endswith('1') for i in index_ids(replace(self.ds,index_policy='last_observation_v1'))))
        with self.assertRaisesRegex(InvalidExperiment,'index policy'):replace(self.ds,index_policy=None).validate()
    def test_nonindex_reobservation_cannot_be_training_sample(self):
        with self.assertRaisesRegex(InvalidExperiment,'Non-index'):prepare_batch(self.ds,Split(('fixture-000-1',),('fixture-001-0',)),CONFIG)
    def test_fit_requires_partition_for_all_engines(self):
        for engine in [FrozenA(),*[LearnedEngine(n) for n in DEFAULTS]]:
            with self.subTest(engine=engine.name),self.assertRaisesRegex(InvalidExperiment,'FitBatch'):engine.fit(self.ds,self.outer.train)
    def test_protected_target_in_statistic_or_A_auxiliary_pool_rejected(self):
        batch=prepare_batch(self.ds,self.outer,CONFIG);r=self.ds.indexed()[self.outer.test[0]]
        injected=replace(batch,rows=batch.rows+(replace(batch.rows[0],row_id=r.row_id,price_uf=r.price_uf),))
        for engine in [FrozenA(),*[LearnedEngine(n) for n in DEFAULTS]]:
            with self.assertRaisesRegex(InvalidExperiment,'modified'):engine.fit(injected)
    def test_config_seed_target_geo_and_parameters_bound(self):
        batch=prepare_batch(self.ds,self.outer,CONFIG)
        for engine in [LearnedEngine('C1',seed=43),LearnedEngine('C1',target='log_uf_m2'),LearnedEngine('C1',geo=True),LearnedEngine('C1',parameters={'alpha':1})]:
            with self.assertRaisesRegex(InvalidExperiment,'configuration'):engine.fit(batch)
    def test_prediction_unknown_id_or_modified_features_rejected(self):
        batch=prepare_batch(self.ds,self.outer,CONFIG);m=LearnedEngine('C1').fit(batch);t=batch.target(self.outer.test[0])
        for target in [replace(t,row_id=self.outer.train[0]),replace(t,features=dict(t.features,parking=99))]:
            with self.assertRaises(InvalidExperiment):m.predict(target)
    def test_fitting_does_not_receive_outer_or_holdout_labels(self):
        p=make_plan(self.ds);f=p.folds[0];sentinel=87654321.123
        ds=replace(self.ds,records=tuple(replace(r,price_uf=sentinel,canonical_listing=dict(r.canonical_listing,raw_metadata={'label_sentinel':str(sentinel)})) if r.row_id not in f.train else r for r in self.ds.records))
        f=Split(f.train,f.test)  # explicit fixture partition reauthorized against the perturbed snapshot
        seen=[]
        class Spy:
            def fit(self,batch):
                seen.append(batch);self.assert_no_labels(batch);return self
            def assert_no_labels(self,batch):
                if str(sentinel) in json.dumps(batch.payload()):raise AssertionError('retained label in adapter')
            def predict(self,target):return Prediction(4500,'ok',row_id=target.row_id)
        run_split(ds,f,dict(CONFIG,engines=['spy']),p.holdout,lambda *_:Spy())
        self.assertEqual({r.row_id for r in seen[0].rows},set(f.train));self.assertFalse(hasattr(seen[0],'records'));self.assertFalse(hasattr(seen[0],'dataset'))
    def test_metric_labels_sealed_until_complete_aligned_predictions(self):
        custody=LabelCustody(self.ds);batch=custody.issue(self.ds,self.outer,CONFIG)
        forged={n:{i:None for i in self.outer.test} for n in CONFIG['engines']}
        with self.assertRaisesRegex(InvalidExperiment,'sealed'):custody.complete(forged,self.outer.test)
        values,_=run_split(self.ds,self.outer,CONFIG,custody=custody)
        truth=custody.complete(values,self.outer.test);self.assertEqual(set(truth),set(self.outer.test))
        with self.assertRaisesRegex(InvalidExperiment,'foreign|Incomplete'):custody.complete({'A':values['A']},self.outer.test)
        altered_predictions=copy.deepcopy(values);altered_predictions['A'][self.outer.test[0]]=987654
        with self.assertRaisesRegex(InvalidExperiment,'receipt'):custody.complete(altered_predictions,self.outer.test)
    def test_final_holdout_not_released(self):
        p=make_plan(self.ds);custody=LabelCustody(self.ds,p.holdout)
        with self.assertRaises(InvalidExperiment):custody.complete({n:{i:None for i in p.holdout} for n in CONFIG['engines']},p.holdout)
    def test_labels_in_target_metadata_rejected(self):
        for metadata in [{'price_uf':4000},{'geo_signals':{'price_uf':4000}}]:
            r=self.ds.records[0];ds=altered(self.ds,r.row_id,canonical_target=dict(r.canonical_target,raw_metadata=metadata))
            with self.assertRaisesRegex(InvalidExperiment,'price-free'):ds.validate()
        r=self.ds.records[0];ds=altered(self.ds,r.row_id,canonical_target=dict(r.canonical_target,raw_metadata={'description':'Departamento UF 99999'}))
        with self.assertRaisesRegex(InvalidExperiment,'monetary text'):ds.validate()
    def test_prediction_wrong_id_and_isolation_exceptions_not_hidden(self):
        class Wrong:
            def fit(self,batch):return self
            def predict(self,target):return Prediction(4000,'ok',row_id='wrong')
        with self.assertRaisesRegex(InvalidExperiment,'ID mismatch'):run_split(self.ds,self.outer,dict(CONFIG,engines=['wrong']),factory=lambda *_:Wrong())
        class Leaky:
            def fit(self,batch):raise InvalidExperiment('leak detected')
        with self.assertRaisesRegex(InvalidExperiment,'leak detected'):run_split(self.ds,self.outer,dict(CONFIG,engines=['bad']),factory=lambda *_:Leaky())
    def test_feature_label_ID_misalignment_rejected(self):
        r=self.ds.records[0];ds=altered(self.ds,r.row_id,features=dict(r.features,parking=99))
        with self.assertRaisesRegex(InvalidExperiment,'alignment'):ds.validate()
    def test_future_preserved_metadata_cannot_enter_surface(self):
        r=self.ds.records[0]
        ds=altered(self.ds,r.row_id,canonical_listing=dict(r.canonical_listing,raw_metadata=dict(r.canonical_listing['raw_metadata'],updated_at='2026-02-01T00:00:00+00:00')))
        with self.assertRaisesRegex(InvalidExperiment,'declared availability'):prepare_batch(ds,self.outer,CONFIG)
    def test_inner_batches_cannot_access_outer_test_or_reserved(self):
        plan=make_plan(self.ds);outer=plan.folds[0];seen=[];original=LearnedEngine.fit
        def spy(engine,batch,*args):seen.append(batch);return original(engine,batch,*args)
        with patch.object(LearnedEngine,'fit',spy):nested_tune_synthetic(self.ds,outer,'C1',[{'alpha':10.0}],holdout=plan.holdout)
        blocked=set(outer.test)|set(plan.holdout)
        self.assertTrue(seen)
        for b in seen:
            self.assertFalse(({r.row_id for r in b.rows}|{r.row_id for r in b.targets})&blocked)
    def test_retained_label_perturbation_does_not_change_predictions(self):
        before,_=run_split(self.ds,self.outer,CONFIG)
        held=set(self.outer.test)
        ds=replace(self.ds,records=tuple(replace(r,price_uf=987654.321,canonical_listing=dict(r.canonical_listing,price_uf='987654.321',raw_metadata={'held_label':'987654.321'})) if r.row_id in held else r for r in self.ds.records))
        after,_=run_split(ds,self.outer,CONFIG)
        self.assertEqual(before,after)
    def test_foreign_canonical_module_cannot_silently_replace_baseline(self):
        import sys
        batch=prepare_batch(self.ds,self.outer,CONFIG)
        module=sys.modules[ComparablesCanonicalEngine.__module__]
        with patch.object(module,'__file__','C:/outside/canonical_comparables.py'):
            with self.assertRaisesRegex(InvalidExperiment,'Foreign canonical'):FrozenA().fit(batch)

class EndToEnd(unittest.TestCase):
    def test_multiple_publications_observations_and_determinism(self):
        ds=synthetic(18,publications_per_group=2);before=ds.hash();config=dict(CONFIG,n_folds=3,bootstrap_replicates=10)
        a=run(ds,config);b=run(ds,config)
        self.assertEqual(a['result_sha256'],b['result_sha256']);self.assertEqual(before,ds.hash())
        self.assertEqual(a['original_observations_n'],72);self.assertEqual(a['index_observations_n'],36)
        self.assertEqual(len(set(dependency_components(ds).values())),18)
        self.assertEqual(set(a['predictions']),{'A','C1','C1-flex','C2'})
        universe=set(a['plan']['development'])
        for values in a['predictions'].values():self.assertEqual(set(values),universe)
        self.assertFalse(a['holdout_evaluated']);self.assertTrue(a['comparison']['common_n'])
        for event in a['custody_audit']:
            if event['phase']=='training_release':self.assertFalse(event['retained_label_release'])
            else:self.assertFalse(event['holdout_release'])
    def test_abstention_visible_and_no_imputation_of_failed_A(self):
        ds=synthetic(12);ids=index_ids(ds);f=Split(ids[:4],ids[4:6]);v,t=run_split(ds,f,CONFIG)
        self.assertTrue(all(x is None for x in v['A'].values()))
        self.assertTrue(all(x['reason']=='insufficient_data' for x in t['A'].values()))
        self.assertTrue(all(x is not None for x in v['C1'].values()))
        custody=LabelCustody(ds);v,t=run_split(ds,f,CONFIG,custody=custody)
        from avm01.metrics import compare
        comparison=compare(custody.complete(v,f.test),v)
        self.assertEqual(comparison['per_engine']['A']['coverage'],0)
        self.assertEqual(comparison['common_n'],0);self.assertEqual(comparison['pairs']['C1__C2']['paired_n'],2)

if __name__=='__main__':unittest.main()
