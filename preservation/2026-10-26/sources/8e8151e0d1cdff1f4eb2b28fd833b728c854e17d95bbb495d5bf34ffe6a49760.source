s=s.replace("before=refs();save('production-references-before.json',before)","baseline_health=health()\nbefore=refs();save('production-references-before.json',before)\nlauncher=ROOT/'scripts/ingestion_launcher.py'\nlauncher_backup=B/'launcher-before.py';launcher_backup.write_bytes(launcher.read_bytes());launcher_backup.chmod(0o600)")
s=s.replace("for u in units:assert 'ActiveState=inactive' in run(['systemctl','show',u+'.service','--property=ActiveState'])", "for u in units:\n state=run(['systemctl','show',u+'.service','--property=ActiveState'])\n assert 'ActiveState=inactive' in state or (u=='valoria-portal-discovery' and 'ActiveState=failed' in state)")
