s=s.replace("live=health();assert live['status']=='ok'", "live=health()\n if live['status']!='ok':\n  assert baseline_health['status']=='degraded'\n  portal=live['sources']['portalinmobiliario']\n  assert live['sources']['yapo']['status']=='ok' and portal['last_run']['finished_at'] is None and not portal['last_run']['errors']\n  assert portal['last_run']['started_at']==baseline_health['sources']['portalinmobiliario']['last_run']['started_at']")
s=s.replace("if changed:\n  for p in paths:", "if changed:\n  launcher.write_bytes(launcher_backup.read_bytes())\n  for p in paths:")
s=s.replace("assert health()['status']=='ok'", "assert health()['status'] in {'ok','degraded'}")
