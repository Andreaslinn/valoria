pathlib.Path('work/redeploy_rollback_remote.py').write_text(s)
s=pathlib.Path('work/discovery_start_cycles_remote.py').read_text().replace('discovery-deploy-20261016','discovery-redeploy-20261016')
s=s.replace("import subprocess,json,pathlib,datetime", "import subprocess,json,pathlib,datetime,sys")
s=s.replace("snapshot=json.loads(run", "cycle=int(sys.argv[1]) if len(sys.argv)>1 else 1\nassert 1<=cycle<=3\nsnapshot=json.loads(run")
s=s.replace("p=B/'stock-before-cycles.json';p.write_text(json.dumps(snapshot));p.chmod(0o600)","p=B/('stock-before-cycle-'+str(cycle)+'.json');p.write_text(json.dumps(snapshot));p.chmod(0o600)\nif cycle==1:\n p=B/'stock-before-cycles.json';p.write_text(json.dumps(snapshot));p.chmod(0o600)")
s=s.replace("assert 'ActiveState=inactive' in run(['systemctl','show',unit,'--property=ActiveState'])", "state=run(['systemctl','show',unit,'--property=ActiveState'])\n assert 'ActiveState=inactive' in state or (source=='portal' and 'ActiveState=failed' in state)")
s=s.replace("'stock_before':len(snapshot['identities'])", "'stock_before':len(snapshot['identities']),'cycle':cycle")
