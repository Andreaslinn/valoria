from playwright.sync_api import sync_playwright
from pathlib import Path
with sync_playwright() as p:
 b=p.chromium.launch(headless=True)
 page=b.new_page(viewport={'width':1440,'height':1000})
 page.goto('http://127.0.0.1:3003/resumen',wait_until='networkidle')
 print(page.url)
 print(page.locator('body').inner_text()[:6500])
 print('BUTTONS',page.get_by_role('button').all_text_contents())
 page.screenshot(path=r'C:\Users\heiko\Documents\Codex\2026-10-12\files-pasted-by-the-user-valoria\work\candidate-guest.png',full_page=True)
 b.close()
