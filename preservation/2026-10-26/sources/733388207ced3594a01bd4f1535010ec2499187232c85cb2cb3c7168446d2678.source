(ROOT/(name+'.private.log')).write_text(r.stdout+r.stderr,encoding='utf8')
if name=='final_collect_cycles_remote.py' and r.returncode==0:
 value=json.loads(r.stdout)
 print(json.dumps({'health':value['health']['status'],'disk_free_bytes':value['disk_free_bytes'],
  'sources':{k:{'service':v['service'],'new':v['new_apartments'],'complete':v['with_detail'],
