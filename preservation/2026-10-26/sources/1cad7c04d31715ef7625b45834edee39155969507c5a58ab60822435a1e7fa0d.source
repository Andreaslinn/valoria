"""Offline benchmark on preserved real images; per-case fresh process RSS peak."""
import csv
import ctypes
import io
import json
import math
import platform
from pathlib import Path
import statistics
import subprocess
import sys
import time
import numpy as np
from PIL import Image, ImageOps, ImageDraw, features
from .normalize import normalize
from .pipeline import Store, Context, work_one
from .server import replay_provider, fixture_rows

CONFIGS = [('WEBP',55,320),('WEBP',60,320),('WEBP',65,320),('WEBP',60,360),
           ('JPEG',60,320),('JPEG',70,320),('AVIF',45,320),('AVIF',55,320)]
HERE = Path(__file__).parent
OUT = HERE/'results'


def peak_rss():
    if sys.platform == 'win32':
        from ctypes import wintypes
        class Counters(ctypes.Structure):
            _fields_=[('cb',wintypes.DWORD),('PageFaultCount',wintypes.DWORD),
                ('PeakWorkingSetSize',ctypes.c_size_t),('WorkingSetSize',ctypes.c_size_t),
                ('QuotaPeakPagedPoolUsage',ctypes.c_size_t),('QuotaPagedPoolUsage',ctypes.c_size_t),
                ('QuotaPeakNonPagedPoolUsage',ctypes.c_size_t),('QuotaNonPagedPoolUsage',ctypes.c_size_t),
                ('PagefileUsage',ctypes.c_size_t),('PeakPagefileUsage',ctypes.c_size_t)]
        counters=Counters(); counters.cb=ctypes.sizeof(counters)
        kernel=ctypes.WinDLL('kernel32'); psapi=ctypes.WinDLL('psapi')
        kernel.GetCurrentProcess.restype=wintypes.HANDLE
        psapi.GetProcessMemoryInfo.argtypes=[wintypes.HANDLE,ctypes.POINTER(Counters),wintypes.DWORD]
        if not psapi.GetProcessMemoryInfo(kernel.GetCurrentProcess(),ctypes.byref(counters),counters.cb):
            raise ctypes.WinError()
        return counters.PeakWorkingSetSize
    import resource
    value=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
    return value if sys.platform=='darwin' else value*1024


def quality_scores(reference, candidate):
    a=np.asarray(reference.convert('L'),dtype=np.float64)
    b=np.asarray(candidate.convert('L'),dtype=np.float64)
    mse=float(np.mean((a-b)**2))
    psnr=99.0 if mse==0 else 10*math.log10(255**2/mse)
    values=[]
    for y in range(0,a.shape[0]-7,8):
        for x in range(0,a.shape[1]-7,8):
            aa=a[y:y+8,x:x+8]; bb=b[y:y+8,x:x+8]
            ma,mb=aa.mean(),bb.mean(); va,vb=aa.var(),bb.var(); cov=((aa-ma)*(bb-mb)).mean()
            values.append(((2*ma*mb+6.5025)*(2*cov+58.5225))/((ma*ma+mb*mb+6.5025)*(va+vb+58.5225)))
    return psnr,float(np.mean(values)) if values else 1.0


def case(index,format,quality,width):
    item=json.loads((HERE/'fixtures/manifest.json').read_text())[index]
    blob=(HERE/'fixtures'/item['file']).read_bytes()
    normalize(blob,item['mime'],format=format,quality=quality,width=width)  # warmup
    results=[]; cpu=[]; output_decode=[]
    for _ in range(10):
        started=time.process_time()
        thumb=normalize(blob,item['mime'],format=format,quality=quality,width=width)
        cpu.append((time.process_time()-started)*1000)
        results.append(thumb.metrics)
        started=time.perf_counter()
        decoded=Image.open(io.BytesIO(thumb.data)); decoded.load()
        output_decode.append((time.perf_counter()-started)*1000)
    with Image.open(io.BytesIO(blob)) as source:
        original_size=source.size
        reference=ImageOps.exif_transpose(source).convert('RGB').resize((thumb.width,thumb.height),Image.Resampling.LANCZOS)
    psnr,ssim=quality_scores(reference,decoded)
    ext={'WEBP':'webp','JPEG':'jpg','AVIF':'avif'}[format]
    name=f"{item['listing_id']}-{format}-{quality}-{width}.{ext}"
    (OUT/name).write_bytes(thumb.data)
    return {'listing_id':item['listing_id'],'source':item['source'],'input_mime':item['mime'],
            'original_width':original_size[0],'original_height':original_size[1],
            'format':format,'quality':quality,'max_width':width,'width':thumb.width,'height':thumb.height,
            'original_bytes':len(blob),'bytes':len(thumb.data),'download_ms_observed':item['download_ms'],
            'decode_ms':statistics.mean(r['decode_ms'] for r in results),
            'resize_ms':statistics.mean(r['resize_ms'] for r in results),
            'encode_ms':statistics.mean(r['encode_ms'] for r in results),
            'processing_ms':statistics.mean(r['processing_ms'] for r in results),
            'cpu_ms':statistics.mean(cpu),'peak_rss_bytes':peak_rss(),
            'output_decode_ms':statistics.mean(output_decode),'psnr_luma_db':psnr,
            'ssim_8x8_luma':ssim,'compression_ratio':len(blob)/len(thumb.data),
            'repeats':10,'filename':name}


def percentile(values,p):
    a=sorted(values); k=(len(a)-1)*p; low=int(k); high=min(low+1,len(a)-1)
    return a[low]*(high-k)+a[high]*(k-low) if high!=low else a[low]


def benchmark():
    OUT.mkdir(exist_ok=True)
    manifest=json.loads((HERE/'fixtures/manifest.json').read_text())
    rows=[]
    for index,item in enumerate(manifest):
        if item['status']!='ok': continue
        for fmt,q,w in CONFIGS:
            raw=subprocess.check_output([sys.executable,'-m','thumbnail_lab.benchmark','--case',str(index),fmt,str(q),str(w)])
            rows.append(json.loads(raw))
        print(f"Benchmarked fixture {item['listing_id']}",flush=True)
    with (OUT/'FORMAT_BENCHMARK.csv').open('w',newline='',encoding='utf-8') as f:
        writer=csv.DictWriter(f,fieldnames=list(rows[0])); writer.writeheader(); writer.writerows(rows)
    summaries=[]
    for fmt,q,w in CONFIGS:
        group=[r for r in rows if (r['format'],r['quality'],r['max_width'])==(fmt,q,w)]
        summaries.append({'format':fmt,'quality':q,'width':w,'n':len(group),
            'median_bytes':statistics.median(r['bytes'] for r in group),
            'p95_bytes':percentile([r['bytes'] for r in group],.95),
            'mean_encode_ms':statistics.mean(r['encode_ms'] for r in group),
            'mean_processing_ms':statistics.mean(r['processing_ms'] for r in group),
            'max_peak_rss_bytes':max(r['peak_rss_bytes'] for r in group),
            'mean_ssim':statistics.mean(r['ssim_8x8_luma'] for r in group)})
    summary={'platform':platform.platform(),'machine':platform.machine(),'python':sys.version,
        'pillow':Image.__version__,'avif':features.check('avif'),'webp':features.check('webp'),
        'configuration_summary':summaries}
    (OUT/'benchmark-summary.json').write_text(json.dumps(summary,indent=2))
    # Contact sheet at native thumbnail size, labels separate from the pixels.
    sheet=Image.new('RGB',(340*5,300*len(CONFIGS)), '#eceff3'); draw=ImageDraw.Draw(sheet)
    for iy,(fmt,q,w) in enumerate(CONFIGS):
        for ix,item in enumerate(manifest):
            row=next(r for r in rows if r['listing_id']==item['listing_id'] and (r['format'],r['quality'],r['max_width'])==(fmt,q,w))
            image=Image.open(OUT/row['filename']).convert('RGB')
            image.thumbnail((320,250))
            x,y=ix*340+10,iy*300+35
            sheet.paste(image,(x,y))
            draw.text((x,iy*300+8),f"{item['source']} {item['listing_id']} | {fmt} q{q} {w}px | {row['bytes']/1024:.1f} KiB",fill='black')
    sheet.save(OUT/'quality-contact-sheet.jpg',quality=92)
    print(json.dumps(summaries,indent=2))


if __name__ == '__main__':
    if len(sys.argv)>1 and sys.argv[1]=='--case':
        print(json.dumps(case(int(sys.argv[2]),sys.argv[3],int(sys.argv[4]),int(sys.argv[5]))))
    else:
        benchmark()
