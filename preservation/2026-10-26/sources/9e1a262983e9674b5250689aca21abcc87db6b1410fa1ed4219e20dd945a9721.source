"use client";
import dynamic from "next/dynamic";
import { useEffect, useMemo, useRef, useState, type FormEvent } from "react";
import { Bookmark, Building2, ChevronRight, ShieldCheck, SlidersHorizontal, X, ArrowUpRight } from "lucide-react";
import { AppShell } from "@/components/layout/app-shell";
import { Badge, Button, Card, Tabs } from "@/components/ui/primitives";
import { formatNumber, formatConfidence, formatDate } from "@/lib/formatters";
import { legacyRoute } from "@/lib/navigation";
import { errorText } from "@/features/summary/use-summary";
import { useRadar } from "./use-radar";
import type { RadarItem } from "./model";
import "./radar.css";
const RadarMap=dynamic(()=>import("./radar-map").then(module=>module.RadarMap),{ssr:false,loading:()=> <div className="data-state">Cargando mapa…</div>});
const uf=(value:number|null)=>value==null?"—":`${formatNumber(value,0)} UF`;
function Photo({item,small=false}:{item:RadarItem;small?:boolean}) {return item.photo?<img className={small?"radar-thumb":"radar-photo"} src={item.photo} alt={`Interior ilustrativo · ${item.title}`}/>:<div className={small?"radar-thumb radar-no-photo":"radar-photo radar-no-photo"}><Building2 size={small?20:48}/>{!small&&<span>Fotografía no disponible</span>}</div>;}
function Confidence({value}:{value:string}){const level=value==="high"?3:value==="medium"?2:value==="low"?1:0;return <span className="radar-confidence"><span>{formatConfidence(value)}</span><i>{[1,2,3,4].map(n=><b key={n} className={n<=level?"lit":""}/>)}</i></span>;}
export function Radar(){
 const model=useRadar();const [tab,setTab]=useState<"Oportunidades"|"Guardados">("Oportunidades"),[selection,setSelection]=useState<number|null>(null),[commune,setCommune]=useState(""),[price,setPrice]=useState(""),[beds,setBeds]=useState(""),[extra,setExtra]=useState(false),[confidence,setConfidence]=useState(""),[detail,setDetail]=useState<{title:string;text:string;mode?:"login"|"analyze";item?:RadarItem}|null>(null),[dialogError,setDialogError]=useState(""),[submitting,setSubmitting]=useState(false);
 const dialog=useRef<HTMLDialogElement>(null);
 const savedIds=useMemo(()=>new Set(model.saved.map(item=>item.id)),[model.saved]);
 const pool=useMemo(()=>tab==="Oportunidades"?model.items:model.saved.map(saved=>model.items.find(item=>item.id===saved.id)??saved),[tab,model.items,model.saved]);
 const items=useMemo(()=>pool.filter(item=>(!commune||item.commune===commune)&&(!beds||(item.beds!=null&&item.beds>=Number(beds)))&&(!confidence||item.confidence===confidence)&&(!price||(item.price!=null&&(price==="low"?item.price<4000:price==="middle"?item.price>=4000&&item.price<=7000:item.price>7000)))),[pool,commune,beds,price,confidence]);
 const selected=items.find(item=>item.id===selection)??items[0]??null;
 const communes=Array.from(new Set([...model.items,...model.saved].map(item=>item.commune))).sort();
 useEffect(()=>{if(detail)dialog.current?.showModal();else dialog.current?.close();},[detail]);
 const showDetail=(title:string,text:string)=>{setDialogError("");setDetail({title,text});};
 const navigate=(label:string)=>{if(label==="Workspace personal"){if(model.phase==="auth")setDetail({title:"Iniciar sesión en Valoria",text:"Usa tu cuenta para consultar Radar y tus guardados.",mode:"login"});else showDetail("Tu cuenta",model.user);return;}const target=legacyRoute(label);if(target)location.assign(target);};
 async function login(event:FormEvent<HTMLFormElement>){event.preventDefault();if(submitting)return;setSubmitting(true);setDialogError("");const form=new FormData(event.currentTarget);try{await model.login(String(form.get("email")),String(form.get("password")));setDetail(null);}catch(e){setDialogError(errorText(e));}finally{setSubmitting(false);}}
 const openAnalysis=(item:RadarItem)=>{setDialogError("");setDetail({title:"Analizar propiedad",text:model.fixture?"Fixture visual: no se enviarán propiedades ficticias a la API.":"Abre el análisis existente de Valoria 1.x. Copia la URL de esta propiedad para pegarla en el formulario.",mode:"analyze",item});};
 const state=model.phase==="auth"?"Inicia sesión para explorar oportunidades reales.":model.phase==="idle"?"Radar se evalúa bajo demanda. Busca oportunidades para comenzar.":model.phase==="loading"?"Evaluando oportunidades reales. Puede tardar hasta dos minutos…":model.error;
 return <AppShell onNavigate={navigate} showDetail={showDetail} data={{user:model.user,alertCount:"—",searchItems:model.saved.map(item=>({id:item.id,title:item.title,description:item.commune,url:item.url})),searchStatus:"Busca entre tus propiedades guardadas.",locationNote:"Radar de departamentos en Santiago. Los marcadores usan las coordenadas disponibles de cada publicación."}}>
 <div className="radar-page"><header className="radar-heading"><div><p className="radar-eyebrow">RADAR DE MERCADO</p><h1>Tu próxima decisión, con ventaja.</h1><p>Precio, contexto y evidencia en una sola vista.</p></div><Badge subtle>{model.fixture?"Fixture visual · Solo desarrollo":"Radar · Datos Valoria"}</Badge></header>
 <div className="radar-ticker"><span>UF <strong>{model.uf?`$${formatNumber(model.uf,0)}`:"—"}</strong></span><span>EN SEGUIMIENTO <strong>{model.savedReady?model.saved.length:"—"}</strong></span><span>BAJO VALOR ESTIMADO <strong>{model.phase==="ready"?model.items.filter(item=>(item.discount??0)>0).length:"—"}</strong></span><span>RESULTADOS <strong>{model.phase==="ready"?model.items.length:"—"}</strong></span></div>
 <div className="radar-workspace"><Card label="Mapa de Radar" className="radar-map-panel"><RadarMap items={items} selected={selected?.id??null} onSelect={setSelection}/><div className="radar-filters"><span><Building2 size={16}/> Departamentos</span><select aria-label="Precio publicado" value={price} onChange={e=>setPrice(e.target.value)}><option value="">Cualquier precio</option><option value="low">Menos de 4.000 UF</option><option value="middle">4.000 – 7.000 UF</option><option value="high">Más de 7.000 UF</option></select><select aria-label="Dormitorios mínimos" value={beds} onChange={e=>setBeds(e.target.value)}><option value="">Dormitorios</option><option value="1">1+ dorm.</option><option value="2">2+ dorm.</option><option value="3">3+ dorm.</option></select><button onClick={()=>setExtra(!extra)} aria-expanded={extra}><SlidersHorizontal size={16}/> Filtros</button></div>{extra&&<div className="radar-extra-filters"><label>Comuna<select value={commune} onChange={e=>setCommune(e.target.value)}><option value="">Todas las comunas</option>{communes.map(name=><option key={name}>{name}</option>)}</select></label><label>Confianza<select value={confidence} onChange={e=>setConfidence(e.target.value)}><option value="">Todas</option><option value="high">Alta</option><option value="medium">Media</option><option value="low">Limitada</option></select></label><button onClick={()=>{setCommune("");setConfidence("");setBeds("");setPrice("");}}>Limpiar filtros</button></div>}</Card>
 <Card label="Oportunidad en foco" className="radar-focus"><div className="radar-focus-heading"><span>OPORTUNIDAD EN FOCO</span><button aria-label={selected&&savedIds.has(selected.id)?"Desguardar propiedad seleccionada":"Guardar propiedad seleccionada"} disabled={!selected||model.busy||!model.savedReady} onClick={()=>selected&&void model.toggle(selected)}><Bookmark size={21} fill={selected&&savedIds.has(selected.id)?"currentColor":"none"}/></button></div>
 {selected?<><Photo item={selected}/><h2 title={selected.title}>{selected.commune} · {selected.title}</h2><p className="radar-property-meta">Departamento · {selected.area??"—"} m² · {selected.beds??"—"} dorm. · {selected.baths??"—"} baños</p><div className="radar-prices"><div><strong>{uf(selected.price)}</strong><small>PRECIO PUBLICADO</small></div><div><span>Estimación Valoria</span><b>{uf(selected.estimate)}</b></div>{selected.discount!=null&&<Badge subtle>{formatNumber(selected.discount,1)}% bajo estimación</Badge>}</div>
 <div className="radar-price-compare"><div><span>Publicación <b>{uf(selected.price)}</b></span><span>Estimación <b>{uf(selected.estimate)}</b></span></div><div className="radar-comparison-track"><i style={{left:`${selected.price!=null&&selected.estimate!=null?selected.price / Math.max(selected.price,selected.estimate,1)*90:0}%`}}/><i style={{left:`${selected.estimate!=null&&selected.price!=null?selected.estimate / Math.max(selected.price,selected.estimate,1)*90:100}%`}}/></div><small>Comparación de valores · no representa un intervalo de confianza</small></div>
 <div className="radar-evidence"><span><SlidersHorizontal size={20}/><span><b>{selected.comparables??"—"} comparables</b><small>En propiedades similares</small></span></span><ShieldCheck size={21}/><Confidence value={selected.confidence}/></div><div className="radar-focus-actions"><button className="text-action" onClick={()=>showDetail("Evidencia de Radar",selected.evidence||"Sin advertencias adicionales.")}>Ver evidencia <ArrowUpRight size={14}/></button><Button className="radar-analyze" onClick={()=>openAnalysis(selected)}>Analizar propiedad <ChevronRight size={18}/></Button></div></>:<div className="data-state"><Building2 size={38}/><p>{model.phase==="auth"?state:tab==="Guardados"?(model.savedReady?"No hay propiedades guardadas que coincidan con los filtros.":model.saveError||"Cargando guardados…"):state||"No hay oportunidades que coincidan con los filtros."}</p>{model.phase==="auth"?<Button onClick={()=>navigate("Workspace personal")}>Iniciar sesión</Button>:model.phase==="error"?<Button onClick={model.refresh}>Reintentar</Button>:model.phase==="idle"?<Button onClick={model.search}>Buscar oportunidades</Button>:null}</div>}
 {model.saveError&&<p className="radar-error" role="alert">Guardados: {model.saveError}<button onClick={model.refresh}>Reintentar</button></p>}</Card></div>
 <Card label="Listado de oportunidades" className="radar-results"><div className="radar-results-heading"><h2>Tu selección, en perspectiva</h2><Tabs options={["Oportunidades","Guardados"] as const} value={tab} onChange={setTab} label="Resultados de Radar"/></div><div className="radar-table-scroll"><table><thead><tr><th>PROPIEDAD</th><th>PUBLICADO</th><th>ESTIMACIÓN</th><th>DIFERENCIA</th><th>CONFIANZA</th><th>ÚLTIMA OBSERVACIÓN</th><th><span className="radar-sr">Guardar</span></th></tr></thead><tbody>{items.map(item=><tr key={item.id} className={selected?.id===item.id?"selected":""} onClick={()=>setSelection(item.id)}><td><button className="radar-row-property" aria-pressed={selected?.id===item.id} onClick={()=>setSelection(item.id)}><Photo item={item} small/><span><strong>{item.title}, {item.commune}</strong><small>Departamento · {item.area??"—"} m² · {item.beds??"—"} dorm.</small></span></button></td><td>{uf(item.price)}</td><td>{uf(item.estimate)}</td><td className="accent">{item.discount==null?"—":`${formatNumber(-item.discount,1)}%`}</td><td><Confidence value={item.confidence}/></td><td>{formatDate(item.seen)}</td><td><button disabled={model.busy||!model.savedReady} aria-label={`${savedIds.has(item.id)?"Desguardar":"Guardar"} ${item.title}`} aria-pressed={savedIds.has(item.id)} onClick={event=>{event.stopPropagation();void model.toggle(item);}}><Bookmark size={18} fill={savedIds.has(item.id)?"currentColor":"none"}/></button></td></tr>)}</tbody></table></div>{!items.length&&<p className="radar-empty-list">{tab==="Oportunidades"?state||"Sin resultados para esta selección.":"No hay guardados para esta selección."}</p>}<p className="radar-results-note">{items.length} resultados visibles · filtros aplicados a {pool.length} propiedades {tab==="Oportunidades"?"evaluadas":"guardadas"}. {model.fixture?"Datos ilustrativos de desarrollo.":"Estimaciones, no precios de cierre."}</p></Card></div>
 <dialog ref={dialog} className="detail-dialog" onCancel={()=>setDetail(null)}><button className="dialog-close" aria-label="Cerrar" onClick={()=>setDetail(null)}><X size={20}/></button><h2>{detail?.title}</h2><p style={{whiteSpace:"pre-line"}}>{detail?.text}</p>{detail?.mode==="login"&&<form onSubmit={login}><label>Email<input name="email" type="email" autoComplete="username" required/></label><label>Contraseña<input name="password" type="password" autoComplete="current-password" required/></label><Button type="submit" disabled={submitting}>{submitting?"Conectando…":"Iniciar sesión"}</Button></form>}{detail?.mode==="analyze"&&!model.fixture&&<div className="radar-analysis-links">{detail.item?.url&&<><p>{detail.item.url}</p><Button onClick={async()=>{try{await navigator.clipboard.writeText(detail.item!.url!);location.assign(legacyRoute("Analizar URL")!);}catch{setDialogError("No se pudo copiar. Copia la URL mostrada y abre Analizar URL.");}}}>Copiar URL y abrir análisis <ArrowUpRight size={15}/></Button></>}<a className="text-action" href={legacyRoute(detail.item?.url?"Analizar URL":"Tasar")!}>Abrir {detail.item?.url?"Analizar URL":"Tasar"} en Valoria 1.x</a></div>}{dialogError&&<p role="alert">{dialogError}</p>}</dialog>
 </AppShell>;
}
