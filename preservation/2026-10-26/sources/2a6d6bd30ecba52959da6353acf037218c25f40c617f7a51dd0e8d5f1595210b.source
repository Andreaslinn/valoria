const { test } = require("node:test");
const assert = require("node:assert/strict");
const fs = require("node:fs");
const path = require("node:path");
const vm = require("node:vm");
const ts = require("typescript");

function loadPrefill() {
  const storage = new Map();
  const context = {
    exports: {},
    window: { sessionStorage: {
      setItem: (key, value) => storage.set(key, value),
      getItem: (key) => storage.get(key) ?? null,
      removeItem: (key) => storage.delete(key),
    } },
  };
  const source = fs.readFileSync(path.join(__dirname, "../src/features/valuation/prefill.ts"), "utf8");
  vm.runInNewContext(ts.transpileModule(source, {
    compilerOptions: { module: ts.ModuleKind.CommonJS },
  }).outputText, context);
  return context.exports;
}

test("URL-to-Tasar transfer preserves the exact listing ID", () => {
  const prefill = loadPrefill();
  prefill.saveTasarPrefillFromListing({ listing_id: 42, comuna: "nunoa", m2: 75 }, "https://example.test/42");
  const result = prefill.consumeTasarPrefill();
  assert.equal(result.targetListingId, 42);
  assert.equal(result.builtAreaM2, 75);
  assert.equal(prefill.consumeTasarPrefill(), null);
});

test("an unpersisted listing does not invent an identity", () => {
  const prefill = loadPrefill();
  prefill.saveTasarPrefillFromListing({ comuna: "nunoa" }, "https://example.test/new");
  assert.equal(prefill.consumeTasarPrefill().targetListingId, undefined);
});
