from pathlib import Path
import json
from netlify_bridge import netlify_client
with netlify_client() as c:
 d=c.get('/deploys/6acd29097a7c9cd9c0070726');d.raise_for_status();d=d.json();out={k:d.get(k) for k in ['id','build_id','state','context','branch','commit_ref','error_message','deploy_ssl_url','published_at','framework','created_at']};Path(__file__).with_name('netlify-cloud-preview-status.json').write_text(json.dumps(out,indent=2));print(json.dumps(out,indent=2))
