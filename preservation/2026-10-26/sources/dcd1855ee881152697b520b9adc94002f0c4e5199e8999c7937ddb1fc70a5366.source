with tarfile.open(fileobj=io.BytesIO(sys.stdin.buffer.read()),mode='r:gz') as t:t.extractall(root,filter='data')
r=subprocess.run(['docker','build','--label','org.opencontainers.image.revision=COMMIT','-t','valoria-remediation:candidate-20261012',str(root)],capture_output=True,text=True,timeout=90)
