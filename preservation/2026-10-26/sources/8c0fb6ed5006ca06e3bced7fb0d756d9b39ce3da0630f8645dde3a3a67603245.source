import subprocess,json
for args in [['systemctl','show','valoria-portal-discovery.service','--property=ActiveState,SubState,Result,ExecMainStatus'],['journalctl','-u','valoria-portal-discovery.service','--since','2026-10-11 21:40:00 UTC','--no-pager','-n','18']]:
 r=subprocess.run(args,capture_output=True,text=True);print(r.stdout)
