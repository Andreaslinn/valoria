async def main():
 assert not Path('/portal-session/reauth_required.json').exists(),'Official re-verification required'
 jar=load_session('/portal-session/session.json');events=[]
 async def event(r):events.append({'status':r.status_code,'host':r.url.host})
 async def missing(_):return None
 async with httpx.AsyncClient(cookies=jar,headers=DEFAULT_HEADERS,timeout=15,follow_redirects=False,event_hooks={'response':[event]}) as client:
  r=await lookup_listing_url('https://portalinmobiliario.com/MLC-3705880440-coronel-godoy-ingevec-_JM',listing_lookup=missing,http_client=client)
  print(json.dumps({'path':'production_verified_loader_readonly','events':events,'result':r.to_dict()},default=str))
asyncio.run(main())
'''
