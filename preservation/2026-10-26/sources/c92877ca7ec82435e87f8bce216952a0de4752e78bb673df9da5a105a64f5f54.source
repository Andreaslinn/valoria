"""Local imports, reports and audit. Run with python -m scripts.property_life."""

import argparse
import json
from datetime import date
from pathlib import Path

from services.property_life import audit, import_bundle, life


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    imp = sub.add_parser("import")
    imp.add_argument("--n", type=Path, required=True)
    imp.add_argument("--l", type=Path, required=True)
    imp.add_argument("--f2890", type=Path, required=True)
    imp.add_argument("--uf-dir", type=Path, required=True)
    imp.add_argument("--version-date", type=date.fromisoformat, required=True)
    for name in ["report", "audit"]:
        cmd = sub.add_parser(name)
        cmd.add_argument("--comuna", required=True)
        cmd.add_argument("--today", type=date.fromisoformat, default=date.today())
        if name == "report":
            cmd.add_argument("--direccion", required=True)
    args = parser.parse_args()
    if args.command == "import":
        result = import_bundle(
            args.n, args.l, args.f2890, list(args.uf_dir.glob("uf*.htm")), args.version_date
        )
    elif args.command == "report":
        result = life(args.direccion, args.comuna, today=args.today)
    else:
        result = audit(args.comuna, today=args.today)
    print(json.dumps(result, ensure_ascii=False, allow_nan=False, indent=2, default=str))


if __name__ == "__main__":
    main()
