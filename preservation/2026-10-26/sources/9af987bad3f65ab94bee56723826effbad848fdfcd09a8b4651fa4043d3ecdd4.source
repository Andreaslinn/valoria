import os,json,subprocess
from pathlib import Path
import httpx
root=Path(__file__).parent
repo=root/'valoria'
branch='feature/sii-closing-layer-20261019'
assert not subprocess.check_output(['git','status','--porcelain'],cwd=repo,text=True).strip()
sha=subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()
parent=subprocess.check_output(['git','rev-parse','HEAD^'],cwd=repo,text=True).strip()
assert parent=='765951adb167b739e35a15d34f8155bbc82d2756'
protected=['api/v1/valuations.py','services/valuation.py','services/sii/closing_knn.py','services/sii/closing_confidence.py','services/sii/closing_address.py','config/valuation_flags.py','reports/sii/closing_confidence_20261019/frozen-rule.json']
assert not subprocess.check_output(['git','diff',parent,'--name-only','--',*protected],cwd=repo,text=True).strip()
assert '160 passed' in (root/'sii-address-redesign-tests.log').read_text(encoding='utf8')
assert '34 passed' in (root/'sii-address-facts-final-tests.log').read_text(encoding='utf8')
os.environ['GIT_TERMINAL_PROMPT']='0';os.environ['GCM_INTERACTIVE']='never'
credential=subprocess.run(['git','credential','fill'],input='protocol=https\nhost=github.com\n\n',cwd=repo,text=True,capture_output=True,timeout=20)
if credential.returncode:raise SystemExit('Credential unavailable; sensitive output suppressed')
fields=dict(x.split('=',1) for x in credential.stdout.splitlines() if '=' in x)
token=fields.get('password')
if not token:raise SystemExit('Credential unavailable')
url='https://api.github.com/repos/Andreaslinn/valoria/pulls/11'
with httpx.Client(headers={'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'},timeout=30,follow_redirects=False) as client:
    response=client.get(url);response.raise_for_status();pr=response.json()
    assert pr['state']=='open' and pr['draft'] and not pr['merged_at']
    assert pr['head']['ref']==branch and pr['head']['sha'] in {parent,sha}
    assert pr['base']['ref']=='release/canonical-only-reproducible-20261013'
    body=pr['body']
    _,sep,rest=body.partition('\n\n')
    lead='Autocompleta **construcción y terreno de la casa identificada** y presenta tipo/año en una **ficha legible**, junto a la segunda opinión con cierres SII. `sii_closing_layer` sigue **apagado por defecto**; motor canónico, K, pesos, escalas y regla congelada permanecen iguales.'
    body=lead+(sep+rest if sep else '\n\n'+body)
    section=f'''### Autocompletado y ficha de propiedad

Se corrige una omisión del primer índice: **el terreno sí estaba en la base SII local**, pero no se había exportado a Tasar. Un archivo complementario privado incorpora terreno positivo de **194.518 casas**, para las **ocho versiones exactas de fuente** usadas por el índice. Exportación local `REPEATABLE READ READ ONLY`; el endpoint solo lee SQLite, sin consultar Postgres.

- Unión exacta de **rol y source ID**, sin mezclar semestres, seleccionar vecinos ni heredar terreno común de departamentos. Archivo opcional ausente, versión distinta o valor inválido: terreno desconocido.
- Ambas interfaces rellenan construcción/terreno disponibles y muestran tipo/año. Conservan correcciones manuales; al cambiar dirección/comuna retiran datos automáticos anteriores y descartan consultas antiguas.
- Tarjeta «Propiedad encontrada», origen por campo y valores destacados. Se eliminan los antiguos párrafos pequeños repetidos. La tarjeta y los campos se apilan en paneles estrechos para mostrar valores completos.
- Baños, dormitorios y estacionamientos se completan manualmente cuando no hay dato fiable. No se inventan ceros ni se copian atributos de avisos sin enlace exacto. La construcción cerrada se distingue de superficie útil.
- Nuevo endpoint autenticado `/api/v1/tasar/address-details`, 404 con flag apagado antes de abrir archivos y sin dependencia de los cierres. Sin roles ni direcciones de terceros en la proyección pública.

**160 pruebas en verde**, Ruff y TypeScript correctos en ambas interfaces. Revisión final adicional de 34 pruebas del endpoint y regresión exacta de la release. Incluye terreno de la misma fuente, versión distinta, valores inválidos, departamentos, lectura sin escrituras y las pruebas previas. Probado en el Tasar real local para casa, terreno, presentación en panel estrecho y conservación de correcciones manuales. Capturas y registros solo locales.

[Informe agregado de terreno y presentación](https://github.com/Andreaslinn/valoria/blob/{sha}/reports/sii/address_facts_20261020/report.md) · [Contrato y exportación local](https://github.com/Andreaslinn/valoria/blob/{sha}/docs/sii_tasar_closing_layer.md).

'''
    start=body.index('### Autocompletado por dirección')
    end=body.index('### Sesgo: mismos 1.142 casos emparejados',start)
    body=body[:start]+section+body[end:]
    body=body.replace('**153 pruebas en verde**','**160 pruebas en verde**')
    body=body.replace('Archivos privados `address-index.sqlite` y `closings.json`','Archivos privados `address-index.sqlite`, `address-details.sqlite` y `closings.json`')
    (root/'address-facts-pr-body.md').write_text(body,encoding='utf8')
    subprocess.run(['git','push','origin',branch],cwd=repo,check=True,timeout=90)
    response=client.patch(url,json={'title':'SII: ficha legible, terreno por dirección y segunda opinión en Tasar','body':body});response.raise_for_status()
    response=client.get(url);response.raise_for_status();pr=response.json()
    assert pr['draft'] and not pr['merged_at'] and pr['head']['sha']==sha
    result={'url':pr['html_url'],'sha':sha,'draft':True,'merged':False,'deployed':False,'flag_default':False,'tests':'160 passed','targeted_final':'34 passed','private_records_published':False}
    (root.parent/'outputs/SII_FICHA_MEJORADA_PR.json').write_text(json.dumps(result,indent=2),encoding='utf8')
    print(json.dumps(result))
