URL = 'https://photos.encuentra24.com/fixture'
CONTEXT = Context('watchlist',True,True,'user-1')

def local_temp():
    # Avoid system temp ACLs; all recursive cleanup stays within this sandbox.
    root = (Path(__file__).parent/'test-state').resolve()
    root.mkdir(exist_ok=True)
    class LocalTemp:
        def __init__(self):
            self.path = root/uuid.uuid4().hex
            self.path.mkdir()
            self.name = str(self.path)
        def __enter__(self): return self.name
        def __exit__(self,*args): self.cleanup()
        def cleanup(self):
            assert self.path.resolve().is_relative_to(root)
            shutil.rmtree(self.path)
    return LocalTemp()


def image_bytes(size=(640,480),format='JPEG',exif=None):
    image = Image.new('RGB',size,'#5b7997')
    image.paste('#cabf91',(0,0,size[0]//3,size[1]//2))
    blob = io.BytesIO()
    kwargs = {'exif':exif} if exif is not None else {}
    image.save(blob,format=format,**kwargs)
    return blob.getvalue()


def listing(lid=1,url=URL):
    return {'listing_id':lid,'source':'yapo','raw_metadata':{'main_image_url':url}}


def replay(url):
    return Download(image_bytes(),'image/jpeg',0,hashlib.sha256(url.encode()).hexdigest())

def stalled_child(refs, pipe):
    time.sleep(5)

def offline_child(refs, pipe):
    pipe.send(('ok',normalize(image_bytes(),'image/jpeg')))
    pipe.close()

def crashed_child(refs, pipe):
    pipe.close()

class SupervisorTests(unittest.TestCase):
    def test_hard_timeout_including_stalled_dns(self):
        started=time.perf_counter()
        with self.assertRaisesRegex(Rejected,'worker_timeout'):
            bounded_process([],timeout=.2,target=stalled_child)
        self.assertLess(time.perf_counter()-started,3)
    def test_spawned_offline_normalization(self):
        thumb=bounded_process([],timeout=5,target=offline_child)
        self.assertEqual(thumb.width,320)
    def test_worker_crash(self):
        with self.assertRaisesRegex(Rejected,'worker_crash'):
            bounded_process([],timeout=5,target=crashed_child)


def resolver(host,port,**kwargs):
    return [(socket.AF_INET,socket.SOCK_STREAM,6,'',('93.184.216.34',port))]


class Response:
    def __init__(self,status=200,body=None,headers=None):
        self.status = status
        self.body = io.BytesIO(image_bytes() if body is None else body)
        self.headers = headers or {'Content-Type':'image/jpeg'}
    def getheader(self,k): return self.headers.get(k)
    def read1(self,n): return self.body.read(n)


class Transport:
    def __init__(self,responses):
        self.responses = list(responses)
        self.pins = []
        self.sent_headers = []
    def __call__(self,host,address,timeout):
        self.pins.append((host,address,timeout))
        outer = self
        class Connection:
            sock = None
            def request(self,method,path,headers): outer.sent_headers.append(headers)
            def getresponse(self):
                value = outer.responses.pop(0)
                if isinstance(value,Exception): raise value
                return value
            def close(self): pass
        return Connection()


class EligibilityTests(unittest.TestCase):
    def test_all_surfaces(self):
        for surface in ('portfolio','radar','watchlist','detail'):
            self.assertTrue(should_have_thumbnail(listing(),Context(surface,True,True,'u')))
    def test_hidden_internal_history_rejected(self):
        for field in ('comparable','discarded','historical'):
            self.assertFalse(should_have_thumbnail(listing()|{field:True},CONTEXT))
        for ctx in (Context('inventory',True,True,'u'),Context('radar',False,True,'u'),
                    Context('radar',True,False,'u'),Context('radar',True,True,'')):
            self.assertFalse(should_have_thumbnail(listing(),ctx))
    def test_invalid_identity(self):
        for lid in (0,None,True,'1'):
            self.assertFalse(should_have_thumbnail(listing(lid),CONTEXT))
        self.assertFalse(should_have_thumbnail(listing()|{'source':'other'},CONTEXT))
    def test_reference_order_and_cap(self):
        row = listing()|{'_source_evidence':{'parsed_signals':{'image_urls':[URL,URL+'2',URL+'3',URL+'4']}}}
        self.assertEqual(references(row),[URL,URL+'2',URL+'3'])
    def test_portal_preserved_og_image(self):
        row = listing()|{'raw_metadata':{},'_source_evidence':{'raw':{'meta_raw':[
            {'property':'og:image','content':'https://http2.mlstatic.com/property.webp'}]}}}
        self.assertEqual(references(row),['https://http2.mlstatic.com/property.webp'])
    def test_observation_read_adapter(self):
        row = {'raw_state':{'_source_evidence':{'parsed_signals':{'image_urls':[URL]}}},
               'parsed_state':{'raw_metadata':{}}}
        self.assertEqual(references(row),[URL])
    def test_malformed_metadata_falls_back(self):
        self.assertEqual(references({'raw_metadata':[], '_source_evidence':[],
                                     'raw_state':'bad','parsed_state':'bad'}),[])
    def test_storage_error_keeps_listing_data(self):
        class Broken:
            def request(self,*args): raise OSError('disk full')
        row=listing()|{'title':'Still usable'}
        result=attach_visible(Broken(),row,CONTEXT)
        self.assertEqual(result['title'],'Still usable')
        self.assertIsNone(result['thumbnail'])


class SecurityTests(unittest.TestCase):
    def test_good_url(self): self.assertEqual(source_url(URL),('photos.encuentra24.com','/fixture'))
    def test_bad_urls(self):
        for url in ('http://photos.encuentra24.com/x','file:///etc/passwd','ftp://example.org/x',
                    'https://localhost/x','https://127.0.0.1/x','https://[::1]/x',
                    'https://10.0.0.1/x','https://169.254.169.254/x',
                    'https://photos.encuentra24.com.evil.org/x',
                    'https://[USER]:[PASSWORD]@photos.encuentra24.com/x',
                    'https://photos.encuentra24.com:8443/x',URL+'?token=secret',URL+'#fragment',
                    URL+'\n','https://photos.encuentra24.com\\@evil.org/x',None):
            with self.subTest(url=url),self.assertRaises(Rejected): source_url(url)
    def test_dns_private_reserved_mapped(self):
        for ip in ('127.0.0.1','10.2.3.4','172.16.1.1','192.168.1.1','169.254.169.254',
                   '0.0.0.0','100.64.0.1','192.0.2.1','::1','fe80::1','fc00::1','::ffff:127.0.0.1'):
            with self.subTest(ip=ip),self.assertRaises(Rejected):
                public_addresses('cdn',lambda *a,**k:[(0,0,0,'',(ip,443))])
    def test_mixed_dns_rejected(self):
        with self.assertRaises(Rejected):
            public_addresses('cdn',lambda *a,**k: resolver('cdn',443)+[(0,0,0,'',('10.0.0.1',443))])
    def test_dns_empty(self):
        with self.assertRaises(Rejected): public_addresses('cdn',lambda *a,**k:[])
    def test_connection_uses_validated_ip(self):
        calls = []
        def resolve(*a,**k): calls.append(1); return resolver(*a,**k)
        transport = Transport([Response()])
        result = fetch(URL,resolver=resolve,connection=transport)
        self.assertEqual(len(calls),1)
        self.assertEqual(transport.pins[0][1],'93.184.216.34')
        self.assertEqual(result.mime,'image/jpeg')
        self.assertNotIn('Authorization',transport.sent_headers[0])
        self.assertNotIn('Cookie',transport.sent_headers[0])
    def test_pinned_tls_sni(self):
        from unittest.mock import patch,Mock
        conn = PinnedHTTPS('photos.encuentra24.com','93.184.216.34',3)
        raw = Mock()
        tls = Mock()
        conn._context = tls
        with patch('infrastructure.thumbnails.security.socket.create_connection',return_value=raw) as dial:
            conn.connect()
        dial.assert_called_once_with(('93.184.216.34',443),3)
        tls.wrap_socket.assert_called_once_with(raw,server_hostname='photos.encuentra24.com')
    def test_redirect_safe(self):
        transport = Transport([Response(302,headers={'Location':'https://http2.mlstatic.com/fixture'}),Response()])
        fetch(URL,resolver=resolver,connection=transport)
        self.assertEqual(len(transport.pins),2)
    def test_redirect_forbidden(self):
        for dest in ('http://photos.encuentra24.com/x','https://127.0.0.1/x','https://evil.org/x'):
            with self.assertRaises(Rejected):
                fetch(URL,resolver=resolver,connection=Transport([Response(302,headers={'Location':dest})]))
    def test_redirect_dns_rechecked(self):
        calls = []
        def rebind(*a,**k):
            calls.append(1)
            return resolver(*a,**k) if len(calls)==1 else [(0,0,0,'',('127.0.0.1',443))]
        transport = Transport([Response(302,headers={'Location':'/other'})])
        with self.assertRaises(Rejected): fetch(URL,resolver=rebind,connection=transport)
        self.assertEqual(len(transport.pins),1)
    def test_redirect_limit(self):
        with self.assertRaisesRegex(Rejected,'redirect_limit'):
            fetch(URL,resolver=resolver,connection=Transport([Response(302,headers={'Location':'/x'}) for _ in range(3)]))
    def test_http_failures(self):
        for status in (403,404,410,429,500):
            with self.assertRaisesRegex(Rejected,'http_'+str(status)):
                fetch(URL,resolver=resolver,connection=Transport([Response(status)]))
    def test_timeout(self):
        with self.assertRaisesRegex(Rejected,'timeout'):
            fetch(URL,resolver=resolver,connection=Transport([socket.timeout()]))
    def test_slow_trickle_total_deadline(self):
        from unittest.mock import patch
        clock=[0.0]
        class Slow(Response):
            def read1(self,n):
                clock[0]+=4
                return b'x'
        with patch('infrastructure.thumbnails.security.time.perf_counter',side_effect=lambda:clock[0]):
            with self.assertRaisesRegex(Rejected,'timeout'):
                fetch(URL,resolver=resolver,connection=Transport([Slow()]))
    def test_non_image_and_compressed_body(self):
        for headers in ({'Content-Type':'text/html'},{'Content-Type':'image/svg+xml'},
                        {'Content-Type':'image/jpeg','Content-Encoding':'gzip'}):
            with self.assertRaisesRegex(Rejected,'mime_or_encoding'):
                fetch(URL,resolver=resolver,connection=Transport([Response(headers=headers)]))
    def test_declared_size_limit(self):
        for length in (str(MAX_BYTES+1),'-1','many'):
            with self.assertRaises(Rejected):
                fetch(URL,resolver=resolver,connection=Transport([Response(headers={'Content-Type':'image/jpeg','Content-Length':length})]))
    def test_unbounded_body_limit(self):
        with self.assertRaisesRegex(Rejected,'download_too_large'):
            fetch(URL,resolver=resolver,connection=Transport([Response(body=b'x'*(MAX_BYTES+1))]))
    def test_length_mismatch(self):
        with self.assertRaisesRegex(Rejected,'length_mismatch'):
            fetch(URL,resolver=resolver,connection=Transport([Response(body=b'x',headers={'Content-Type':'image/jpeg','Content-Length':'4'})]))


class NormalizationTests(unittest.TestCase):
    def test_resize_no_upscale_aspect(self):
        for size,expected in (((640,480),(320,240)),((12,8),(12,8)),((200,600),(200,600))):
            thumb = normalize(image_bytes(size),'image/jpeg')
            self.assertEqual((thumb.width,thumb.height),expected)
            self.assertEqual(Image.open(io.BytesIO(thumb.data)).format,'WEBP')
    def test_exif_orientation_metadata(self):
        exif = Image.Exif()
        exif[274] = 6
        exif[271] = 'Private camera'
        exif[315] = 'Private author'
        thumb = normalize(image_bytes((640,480),exif=exif),'image/jpeg')
        self.assertEqual((thumb.width,thumb.height),(320,427))
        out = Image.open(io.BytesIO(thumb.data))
        self.assertFalse(out.getexif())
        self.assertNotIn('icc_profile',out.info)
        self.assertNotIn('xmp',out.info)
    def test_metadata_stripped_png(self):
        from PIL.PngImagePlugin import PngInfo
        info = PngInfo(); info.add_text('comment','secret')
        blob = io.BytesIO(); Image.new('RGB',(30,30)).save(blob,format='PNG',pnginfo=info)
        out = normalize(blob.getvalue(),'image/png')
        self.assertNotIn(b'secret',out.data)
    def test_deterministic_hash(self):
        a = normalize(image_bytes(),'image/jpeg')
        b = normalize(image_bytes(),'image/jpeg')
        self.assertEqual(a.data,b.data)
        self.assertEqual(hashlib.sha256(a.data).hexdigest(),a.digest)
    def test_corrupt_html_and_weird_format(self):
        for body,mime in ((b'<html>blocked</html>','image/jpeg'),(b'corrupt','image/webp'),
                          (image_bytes(format='GIF'),'image/gif')):
            with self.assertRaises(Rejected): normalize(body,mime)
    def test_mime_signature_mismatch(self):
        with self.assertRaisesRegex(Rejected,'mime_signature_mismatch'):
            normalize(image_bytes(),'image/png')
    def test_huge_image_rejected_before_decode(self):
        blob = image_bytes((8193,1),format='PNG')
        with self.assertRaisesRegex(Rejected,'decoded_limit'): normalize(blob,'image/png')
        blob = image_bytes((4001,4000),format='PNG')
        with self.assertRaisesRegex(Rejected,'decoded_limit'): normalize(blob,'image/png')
    def test_animation_rejected(self):
        frames = [Image.new('RGB',(20,20),'red'),Image.new('RGB',(20,20),'blue')]
        blob = io.BytesIO()
        frames[0].save(blob,format='WEBP',save_all=True,append_images=frames[1:],duration=100)
        with self.assertRaisesRegex(Rejected,'animated_unsupported'): normalize(blob.getvalue(),'image/webp')
    def test_all_output_formats(self):
        for fmt in ('WEBP','JPEG','AVIF'):
            out = normalize(image_bytes(),'image/jpeg',format=fmt)
            self.assertEqual(Image.open(io.BytesIO(out.data)).format,fmt)


class StoreTests(unittest.TestCase):
    def setUp(self):
        self.temp = local_temp()
        self.store = Store(Path(self.temp.name))
    def tearDown(self):
        self.store.close()
        self.temp.cleanup()
    def test_ineligible_never_enqueues(self):
        self.store.request(listing(),Context('inventory',True,True,'u'))
        self.assertIsNone(self.store.claim())
    def test_cache_miss_hit_persistence(self):
        calls = []
        def provider(url): calls.append(url); return replay(url)
        self.assertIsNone(self.store.request(listing(),CONTEXT))
        self.assertTrue(work_one(self.store,provider))
        ref = self.store.request(listing(),CONTEXT)
        self.assertTrue(ref['url'].startswith('/api/v1/thumbnails/'))
        self.assertFalse(work_one(self.store,provider))
        self.assertEqual(len(calls),1)
        reopened=Store(self.store.root)
        try:
            self.assertEqual(reopened.lookup(1),ref)
        finally:
            reopened.close()
    def test_metadata_persistence(self):
        self.store.request(listing(),CONTEXT); work_one(self.store,replay)
        with self.store.connection() as db:
            row = dict(db.execute('SELECT * FROM thumbnails').fetchone())
            self.assertEqual(row['status'],'ready')
            self.assertEqual(row['format'],'webp')
            self.assertEqual(row['bytes'],(self.store.assets/row['asset_key']).stat().st_size)
            self.assertEqual(row['source_hash'],hashlib.sha256(URL.encode()).hexdigest())
            self.assertNotIn(URL,json.dumps(row))
            self.assertIn('decode_ms',json.loads(row['metrics']))
            self.assertEqual(db.execute('SELECT COUNT(*) FROM jobs').fetchone()[0],0)
    def test_storage_budget_fallback(self):
        self.store.quota_bytes=1
        self.store.request(listing(),CONTEXT); work_one(self.store,replay)
        self.assertIsNone(self.store.lookup(1))
        self.assertEqual(len(list(self.store.assets.glob('*.webp'))),0)
        with self.store.connection() as db:
            self.assertEqual(db.execute('SELECT failure FROM thumbnails').fetchone()[0],'storage_budget')
    def test_dedupe_different_listings(self):
        for lid in (1,2): self.store.request(listing(lid),CONTEXT)
        while work_one(self.store,replay): pass
        self.assertEqual(self.store.lookup(1)['hash'],self.store.lookup(2)['hash'])
        self.assertEqual(len(list(self.store.assets.glob('*.webp'))),1)
    def test_source_url_change_reuses_good_asset(self):
        self.store.request(listing(),CONTEXT); work_one(self.store,replay)
        ref = self.store.lookup(1)
        self.assertEqual(self.store.request(listing(url=URL+'new'),CONTEXT),ref)
        self.assertIsNone(self.store.claim())
    def test_same_id_different_source_rejected(self):
        self.store.request(listing(),CONTEXT); work_one(self.store,replay)
        self.assertIsNone(self.store.request(listing()|{'source':'portal'},CONTEXT))
    def test_no_source(self):
        self.store.request(listing()|{'raw_metadata':{}},CONTEXT)
        self.assertIsNone(self.store.claim())
        self.assertIsNone(self.store.lookup(1))
    def test_failure_fallback_and_cooldown(self):
        def bad(url): raise Rejected('http_403')
        self.store.request(listing(),CONTEXT,now=1000)
        work_one(self.store,bad,now=1000)
        self.assertIsNone(self.store.lookup(1))
        self.store.request(listing(),CONTEXT,now=2000)
        self.assertIsNone(self.store.claim(now=2000))
        self.store.request(listing(),CONTEXT,now=88000)
        self.assertIsNotNone(self.store.claim(now=88000))
    def test_retry_limit_and_backoff(self):
        def bad(url): raise Rejected('timeout')
        self.store.request(listing(),CONTEXT,now=1000)
        self.assertTrue(work_one(self.store,bad,now=1000))
        self.assertFalse(work_one(self.store,bad,now=1004))
        self.assertTrue(work_one(self.store,bad,now=1005))
        self.assertFalse(work_one(self.store,bad,now=1034))
        self.assertTrue(work_one(self.store,bad,now=1035))
        self.assertIsNone(self.store.claim(now=99999))
        with self.store.connection() as db:
            self.assertEqual(db.execute('SELECT status,failure FROM thumbnails').fetchone()[:],('failed','timeout'))
    def test_first_invalid_then_valid_source(self):
        row = listing()|{'_source_evidence':{'parsed_signals':{'image_urls':[URL+'good']}}}
        def provider(url):
            if url==URL: raise Rejected('http_404')
            return replay(url)
        self.store.request(row,CONTEXT); work_one(self.store,provider)
        self.assertIsNotNone(self.store.lookup(1))
    def test_concurrent_requests_workers_one_asset(self):
        with ThreadPoolExecutor(max_workers=8) as pool:
            list(pool.map(lambda _:self.store.request(listing(),CONTEXT),range(16)))
        calls = []
        def provider(url): calls.append(url); time.sleep(.02); return replay(url)
        with ThreadPoolExecutor(max_workers=8) as pool:
            list(pool.map(lambda _:work_one(self.store,provider),range(8)))
        self.assertEqual(len(calls),1)
        self.assertEqual(len(list(self.store.assets.glob('*.webp'))),1)
    def test_independent_worker_connections(self):
        self.store.request(listing(),CONTEXT)
        workers=[Store(self.store.root) for _ in range(8)]
        calls=[]
        def provider(url): calls.append(url); time.sleep(.03); return replay(url)
        try:
            with ThreadPoolExecutor(max_workers=8) as pool:
                list(pool.map(lambda store:work_one(store,provider),workers))
            self.assertEqual(len(calls),1)
            self.assertIsNotNone(self.store.lookup(1))
        finally:
            for store in workers: store.close()
    def test_interrupted_lease_and_stale_worker_cas(self):
        self.store.request(listing(),CONTEXT,now=1000)
        abandoned = self.store.claim(now=1000)
        self.assertIsNone(self.store.claim(now=1029))
        replacement = self.store.claim(now=1030)
        thumb = normalize(image_bytes(),'image/jpeg')
        self.assertFalse(self.store.finish(abandoned,thumb,'source-hash',now=1031))
        self.assertTrue(self.store.finish(replacement,thumb,'source-hash',now=1031))
        self.assertEqual(len(list(self.store.assets.glob('*.tmp'))),0)
    def test_gc_retains_referenced_shared_asset(self):
        self.store.request(listing(1),CONTEXT,now=1000)
        self.store.request(listing(2),CONTEXT,now=1000)
        while work_one(self.store,replay,now=1000): pass
        self.store.leave(1,CONTEXT)
        self.store.request(listing(2),CONTEXT,now=1000+TTL-1)
        self.store.gc(now=1000+TTL+1)
        self.assertIsNone(self.store.lookup(1))
        self.assertIsNotNone(self.store.lookup(2))
    def test_leave_return_grace_and_expiry(self):
        self.store.request(listing(),CONTEXT,now=1000); work_one(self.store,replay,now=1000)
        before = self.store.lookup(1)
        self.store.leave(1,CONTEXT)
        self.store.gc(now=1000+TTL-1)
        self.assertEqual(self.store.request(listing(),CONTEXT,now=1000+TTL-1),before)
        self.store.leave(1,CONTEXT)
        self.store.gc(now=1000+2*TTL)
        self.assertIsNone(self.store.lookup(1))
    def test_gc_orphan_and_tmp_grace(self):
        orphan = self.store.assets/('a'*64+'.webp'); orphan.write_bytes(b'orphan')
        temp = self.store.assets/'orphan.tmp'; temp.write_bytes(b'temp')
        self.assertEqual(self.store.gc(),0)
        self.assertEqual(self.store.gc(now=time.time()+86401),2)
    def test_gc_does_not_remove_active_lease(self):
        self.store.request(listing(),CONTEXT,now=1000)
        job = self.store.claim(now=1000+TTL+10)
        self.store.gc(now=1000+TTL+11)
        self.assertTrue(self.store.finish(job,normalize(image_bytes(),'image/jpeg'),'hash'))
    def test_corrupt_cached_asset_regenerates(self):
        self.store.request(listing(),CONTEXT); work_one(self.store,replay)
        path = next(self.store.assets.glob('*.webp'))
        path.write_bytes(b'x'*path.stat().st_size)
        self.assertIsNone(self.store.lookup(1))
        self.store.request(listing(),CONTEXT); work_one(self.store,replay)
        self.assertIsNotNone(self.store.lookup(1))


class HTTPTests(unittest.TestCase):
    def test_lazy_payload_cache_and_integrity(self):
        with local_temp() as folder:
            server = SandboxHTTP(('127.0.0.1',0),Store(Path(folder)))
            thread = threading.Thread(target=server.serve_forever,daemon=True); thread.start()
            conn = HTTPConnection('127.0.0.1',server.server_port,timeout=3)
            try:
                conn.request('GET','/api/v1/radar/opportunities?limit=1')
                response = conn.getresponse(); first=json.loads(response.read())
                self.assertEqual(len(first),1)
                with server.store.connection() as db:
                    self.assertEqual(db.execute('SELECT COUNT(*) FROM thumbnails').fetchone()[0],1)
                for _ in range(100):
                    if server.store.lookup(1): break
                    time.sleep(.01)
                ref = server.store.lookup(1); self.assertIsNotNone(ref)
                conn.request('GET',ref['url']); response=conn.getresponse(); body=response.read()
                self.assertEqual(response.status,200)
                self.assertEqual(len(body),ref['bytes'])
                self.assertEqual(response.getheader('X-Content-Type-Options'),'nosniff')
                etag=response.getheader('ETag')
                conn.request('GET',ref['url'],headers={'If-None-Match':etag})
                response=conn.getresponse(); self.assertEqual(response.status,304); self.assertEqual(response.read(),b'')
                conn.request('GET','/api/v1/thumbnails/../../secret')
                response=conn.getresponse(); self.assertEqual(response.status,404); response.read()
            finally:
                conn.close(); server.shutdown(); server.server_close()


if __name__ == '__main__': unittest.main(verbosity=2)
