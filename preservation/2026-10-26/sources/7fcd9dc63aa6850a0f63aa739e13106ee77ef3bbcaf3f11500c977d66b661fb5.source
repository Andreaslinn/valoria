import subprocess,json,pathlib,os,hashlib,time
root=pathlib.Path('/home/ubuntu/apps/valoria/private/published-fields-deploy-20261016');root.mkdir(mode=0o700,exist_ok=True)
def call(args,**kw):
 r=subprocess.run(args,capture_output=True,timeout=kw.pop('timeout',120),**kw)
 if r.returncode:raise RuntimeError('Controlled backup command failed: '+args[0]+' '+str(r.returncode))
 return r.stdout
api=json.loads(call(['docker','inspect','valoria_oracle_beta-api-1']))[0]
pg=json.loads(call(['docker','inspect','valoria_oracle_beta-postgres-1']))[0]
def private(name,data):
 p=root/name;p.write_bytes(data);p.chmod(0o600);return p
private('api-before-private.json',json.dumps(api).encode())
private('pg-before-private.json',json.dumps(pg).encode())
private('units-before.txt',call(['systemctl','cat','valoria-portal-discovery.service','valoria-portal-discovery.timer','valoria-yapo-discovery.service','valoria-yapo-discovery.timer']))
env=dict(x.split('=',1) for x in pg['Config']['Env'])
user,db=env.get('POSTGRES_USER','postgres'),env.get('POSTGRES_DB',env.get('POSTGRES_USER','postgres'))
backup=private('postgres-before.dump',call(['docker','exec','valoria_oracle_beta-postgres-1','pg_dump','-U',user,'-d',db,'-Fc','--no-owner','--no-acl'],timeout=180))
tables=['listings','users','saved_listings','alerts','uf_rates']
sql='SELECT json_build_object('+','.join("'%s',(SELECT COUNT(*) FROM %s)"%(t,t) for t in tables)+');'
counts=json.loads(call(['docker','exec','valoria_oracle_beta-postgres-1','psql','-U',user,'-d',db,'-Atc',sql]))
name='valoria-published-fields-restore'
call(['docker','run','-d','--name',name,'--network=none','--memory=384m','--memory-swap=384m','--cpus=0.25','--pids-limit=96','--tmpfs','/var/lib/postgresql/data:rw,nosuid,nodev,size=256m','-e','POSTGRES_HOST_AUTH_METHOD=trust','-e','POSTGRES_DB=valoria_restore',pg['Image']])
for _ in range(30):
 r=subprocess.run(['docker','exec',name,'pg_isready','-U','postgres'],capture_output=True)
 if r.returncode==0:break
 time.sleep(1)
else:raise RuntimeError('scratch postgres startup failed')
call(['docker','exec','-i',name,'pg_restore','-U','postgres','-d','valoria_restore','--exit-on-error','--no-owner','--no-acl'],input=backup.read_bytes(),timeout=180)
restored=json.loads(call(['docker','exec',name,'psql','-U','postgres','-d','valoria_restore','-Atc',sql]))
assert restored==counts
state={'backup_sha256':hashlib.sha256(backup.read_bytes()).hexdigest(),'backup_bytes':backup.stat().st_size,'counts_original':counts,'counts_restored':restored,'restore_verified':True,'scratch_pg':name,'production_image':api['Image'],'production_id':api['Id'],'started_at':api['State']['StartedAt']}
private('backup-proof.json',json.dumps(state,indent=2).encode())
print(json.dumps(state),flush=True)
