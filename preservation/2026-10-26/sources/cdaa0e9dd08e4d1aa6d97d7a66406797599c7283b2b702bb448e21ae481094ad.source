import json,httpx
from pathlib import Path
with httpx.Client(base_url='http://127.0.0.1:18013',timeout=120) as c:
 r=c.post('/api/v1/auth/login',data={'username':'portal-candidate@example.test','password':'[REDACTED]'});r.raise_for_status();c.headers['Authorization']='Bearer '+r.json()['access_token']
 r=c.get('/api/v1/radar/opportunities?limit=20');r.raise_for_status();radar=r.json();checked=[]
 for row in radar:
  price=row.get('price_uf');estimate=row.get('estimated_price_uf');discount=row.get('discount_pct')
  if price and estimate and discount is not None:
   assert abs((1-price/estimate)*100-discount)<0.1
   checked.append({'listing_id':row['listing_id'],'price_uf':price,'radar_estimate_uf':estimate,'discount_pct':discount})
 assert checked,'Need nonempty real Radar evidence'
 r=c.post('/api/v1/valuations',json={'target_listing_id':1130,'comuna':'independencia','property_type':'apartment','m2':52,'usable_area_m2':52,'built_area_m2':52,'dormitorios':2,'banos':1,'estacionamientos':1,'precio_publicado_uf':1520});r.raise_for_status();v=r.json();assert 1130 not in {x['listing_id'] for x in v['comparables']}
 out={'actual_candidate_model_flags':'matched_production','radar_rows_mathematically_consistent':checked,'tasar1130_estimate_uf':v['estimated_price_uf'],'tasar1130_self_excluded':True,'semantics':'Radar screening estimate/discount share method; detailed Tasar consensus is a separately labelled method'}
 Path(__file__).with_name('portal-cross-screen-http.json').write_text(json.dumps(out,indent=2),encoding='utf-8');print(json.dumps({'radar_rows_checked':len(checked),'tasar_self_excluded':True}))
