from pathlib import Path
p=Path('frontend-v2/src/features/alerts/use-alerts.ts');s=p.read_text(encoding='utf-8').replace('summaryApi.alerts({signal:abort.signal})','alertsApi.historyWatchlist(abort.signal)').replace('summaryApi.patrimonyAlerts({signal:abort.signal})','alertsApi.historyPatrimony(abort.signal)').replace('setPatrimony(p.value.items.filter(a=>!a.dismissed_at))','setPatrimony(p.value.items)').replace('setWatchlist(values=>values.filter(v=>v.id!==a.id))','setWatchlist(values=>values.map(v=>v.id===a.id?{...v,is_read:true}:v))');p.write_text(s,encoding='utf-8')
p=Path('frontend-v2/src/features/alerts/view-model.ts');s=p.read_text(encoding='utf-8').replace('read:boolean;','read:boolean;dismissed?:boolean;').replace('read:!!a.read_at,','read:!!a.read_at||!!a.dismissed_at,dismissed:!!a.dismissed_at,');p.write_text(s,encoding='utf-8')
p=Path('frontend-v2/src/features/alerts/workspace.tsx');s=p.read_text(encoding='utf-8').replace('[onlyUnread,setOnlyUnread]=useState(true),','[onlyUnread,setOnlyUnread]=useState(true),[showDismissed,setShowDismissed]=useState(false),').replace('all.filter(a=>(!onlyUnread||!a.read)', 'all.filter(a=>(showDismissed||!a.dismissed)&&(!onlyUnread||!a.read)').replace('Solo pendientes</label>','Solo pendientes</label><label><input type="checkbox" checked={showDismissed} onChange={e=>setShowDismissed(e.target.checked)}/>Incluir descartadas de Patrimonio</label>').replace('{a.read?"Leída":"Pendiente"}', '{a.dismissed?"Descartada":a.read?"Leída":"Pendiente"}').replace('Watchlist muestra hasta 100 alertas pendientes; su API no devuelve el historial de alertas leídas. Patrimonio incluye las señales disponibles que no han sido descartadas.', 'Watchlist muestra hasta 100 alertas recientes, incluidas las leídas. Patrimonio conserva señales leídas y descartadas; usa los filtros para revisarlas.');p.write_text(s,encoding='utf-8')
