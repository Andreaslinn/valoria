"""Bounded read-only pilot using the existing MVP's public SII lookup contract.
No F2890/catastro rebuild, enumeration, authenticated access or database writes.
"""
import json,time,uuid,hashlib,sys
from datetime import datetime,timezone
from pathlib import Path
import httpx
ROOT=Path(__file__).resolve().parent
OUT=ROOT.parent/'outputs/sii-cartografia-prueba-20261025'
OUT.mkdir(exist_ok=True)
BASE='https://www4.sii.cl'
URL=BASE+'/mapasui/services/data/mapasFacadeService/getPredioNacional'
roles=[(15160,1261,6),(15160,1261,20),(15160,1259,14),(15160,1263,1),(15160,1269,1)]
results=[]
with httpx.Client(timeout=30,follow_redirects=True,headers={'User-Agent':'Valoria-local-geography-feasibility-check/1.0','Origin':BASE,'Referer':BASE+'/mapasui/internet/'}) as client:
    try:
        b=client.get(BASE+'/mapasui/internet/')
        (OUT/'bootstrap.html').write_bytes(b.content)
        bootstrap={'status':b.status_code,'url':str(b.url),'bytes':len(b.content),'sha256':hashlib.sha256(b.content).hexdigest()}
        (OUT/'bootstrap.json').write_text(json.dumps(bootstrap,indent=2),encoding='utf8')
        print('BOOTSTRAP',json.dumps(bootstrap),flush=True)
        if b.status_code!=200:raise RuntimeError('Bootstrap unavailable; no alternate route or bypass attempted')
        for c,m,p in roles:
            payload={'metaData':{'namespace':'cl.sii.sdi.lob.bbrr.mapas.data.api.interfaces.MapasFacadeService/getPredioNacional','conversationId':'UNAUTHENTICATED-CALL','transactionId':'tx-'+str(int(time.time()*1000))+'-'+uuid.uuid4().hex[:8]},'data':{'predio':{'comuna':str(c),'manzana':str(m),'predio':str(p)},'servicios':[]}}
            record={'role':f'{c}-{m}-{p}','method':'POST','endpoint':URL,'payload':payload,'retrieved_at_utc':datetime.now(timezone.utc).isoformat()}
            try:
                r=client.post(URL,json=payload)
                rawname=f'response-{c}-{m}-{p}.json'
                try:body=r.json()
                except ValueError:body={'non_json_body':r.text}
                (OUT/rawname).write_text(json.dumps(body,indent=2,ensure_ascii=False),encoding='utf8')
                record.update(status=r.status_code,content_type=r.headers.get('content-type'),server_date=r.headers.get('date'),response_file=rawname,response_sha256=hashlib.sha256(r.content).hexdigest(),response_keys=list(body) if isinstance(body,dict) else None)
                data=body.get('data') if isinstance(body,dict) else None
                if isinstance(data,dict):
                    record['data_keys']=list(data)
                    record['ubicacionX']=data.get('ubicacionX');record['ubicacionY']=data.get('ubicacionY')
                    record['coordinate_valid']=bool(data.get('ubicacionX') and data.get('ubicacionY') and -56<float(data['ubicacionX'])<-17 and -76<float(data['ubicacionY'])<-66)
                results.append(record);print(json.dumps(record,ensure_ascii=True),flush=True)
                if r.status_code in (401,403,429):break
            except (httpx.HTTPError,ValueError) as e:
                record['error']=type(e).__name__+': '+str(e);results.append(record);print(json.dumps(record),flush=True);break
            time.sleep(1)
    except (httpx.HTTPError,RuntimeError) as e:
        results.append({'stage':'bootstrap','error':type(e).__name__+': '+str(e)})
(OUT/'pilot-results.json').write_text(json.dumps(results,indent=2,ensure_ascii=False),encoding='utf8')
