import subprocess
from pathlib import Path
exec(Path(__file__).with_name('portal_runtime_inventory.py').read_text().split('inner=')[0])
inner='''import asyncio,json,time
from sqlalchemy import text,select
from infrastructure.db.database import get_session_factory
from infrastructure.db.repositories import SqlAlchemyListingRepository
from infrastructure.db.models import UFRateORM
from domain.radar.detector import detect_opportunities
async def main():
 async with get_session_factory()() as s:
  await s.execute(text('SET TRANSACTION READ ONLY'))
  listings=await SqlAlchemyListingRepository(s).list_active()
  rate=(await s.execute(select(UFRateORM).order_by(UFRateORM.date.desc()).limit(1))).scalar_one().value_clp
  targets=[r for r in listings if r.property_type=='apartment' and r.m2 and r.m2>0][:30]
  start=time.perf_counter();result=detect_opportunities(targets,rate,comparable_universe=listings);elapsed=time.perf_counter()-start
  print(json.dumps({'targets':len(targets),'universe':len(listings),'elapsed_s':elapsed,'opportunities':len(result.opportunities)}))
asyncio.run(main())
'''
remote='''import subprocess,json
x=json.loads(subprocess.check_output(['docker','inspect','valoria-portal-candidate-api']))[0];out={}
for image in ['valoria-remediation-rollback:20261012','valoria-remediation:candidate-20261012-v5']:
 args=['docker','run','-i','--rm','--network','valoria-portal-candidate-net','--memory','384m','--cpus','0.5']
 for v in x['Config']['Env']:args+=['-e',v]
 args+=['--entrypoint','python',image,'-B','-']
 r=subprocess.run(args,input=INNER,capture_output=True,text=True,timeout=90);assert r.returncode==0,'Read-only timing comparison failed';out[image]=json.loads(r.stdout)
print(json.dumps(out,indent=2))
'''.replace('INNER',repr(inner))
r=subprocess.run(ssh+['python3 -B -'],input=remote,text=True,capture_output=True,timeout=195);Path(__file__).with_name('radar-baseline-comparison.json').write_text(r.stdout+r.stderr,encoding='utf-8');print(r.stdout);print(r.stderr);r.check_returncode()
