import os
os.environ['DATABASE_URL']='sqlite+aiosqlite:///:memory:'
os.environ['SYNC_DATABASE_URL']='sqlite:///:memory:'
os.environ['JWT_SECRET_KEY']='offline-persistence-key-no-production-32'
import json,sqlite3,time,sys
from pathlib import Path
from infrastructure.thumbnails.pipeline import Store,Context,work_one
from infrastructure.thumbnails.security import Download
folder=Path('validation/thumbnail_lab/fixtures');m=json.loads((folder/'manifest.json').read_text())[0]
store=Store(Path('/state'));ctx=Context('watchlist',True,True,'7')
def payload(i):return {'listing_id':i,'source':'yapo','raw_metadata':{'main_image_url':m['url']}}
mode=sys.argv[1]
if mode=='writer':
 for i in range(2,202):
  store.request(payload(i),ctx)
  assert work_one(store,lambda _:Download((folder/m['file']).read_bytes(),m['mime'],'offline',0))
 print(json.dumps({'writes':200,'assets':len(list(store.assets.glob('*.webp')))}))
elif mode=='reader':
 for _ in range(200):
  assert store.request(payload(1),ctx)
 print(json.dumps({'reads':200,'integrity':store._db.execute('PRAGMA integrity_check').fetchone()[0]}))
elif mode=='crash':
 store._db.execute('BEGIN IMMEDIATE');store._db.execute("UPDATE thumbnails SET failure='interrupted-uncommitted'")
 os._exit(19)
elif mode=='verify':
 with store.connection() as db:
  assert db.execute('PRAGMA integrity_check').fetchone()[0]=='ok'
  assert db.execute("SELECT count(*) FROM thumbnails WHERE failure='interrupted-uncommitted'").fetchone()[0]==0
  assert db.execute('SELECT count(*) FROM thumbnails').fetchone()[0]==201
  assert db.execute('SELECT count(*) FROM jobs').fetchone()[0]==0
 before=len(list(store.assets.glob('*.webp')));store.gc();assert before==len(list(store.assets.glob('*.webp')))==1
 backup=sqlite3.connect('/state/backup.sqlite3');store._db.backup(backup);assert backup.execute('PRAGMA integrity_check').fetchone()[0]=='ok';backup.close()
 print(json.dumps({'wal_crash_rollback':'ok','integrity':'ok','ready_rows':201,'unique_content_files':1,'gc_active_retained':True,'backup_integrity':'ok','uid':os.getuid(),'gid':os.getgid(),'root_mode':oct(store.root.stat().st_mode&0o777),'db_bytes':store.db.stat().st_size,'asset_bytes':sum(p.stat().st_size for p in store.assets.glob('*.webp')),'filesystem_allocated_bytes':sum(p.stat().st_blocks*512 for p in store.root.rglob('*') if p.is_file())}))
store.close()
