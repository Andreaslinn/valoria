import subprocess
from pathlib import Path
exec(Path(__file__).with_name('portal_runtime_inventory.py').read_text().split('inner=')[0])
code='''import subprocess,json
names=['valoria-portal-candidate-api','valoria_oracle_beta-api-1']
for name in names:
 x=json.loads(subprocess.check_output(['docker','inspect',name]))[0]
 print(json.dumps({'container':name,'state':x['State']['Status'],'oom_killed':x['State']['OOMKilled'],'memory_limit':x['HostConfig']['Memory'],'nano_cpus':x['HostConfig']['NanoCpus']}))
 log=subprocess.run(['docker','logs','--tail','60',name],capture_output=True,text=True)
 print(json.dumps({'container':name,'safe_log_lines':[line for line in (log.stdout+log.stderr).splitlines() if any(s in line for s in ['radar_endpoint_completed','radar_opportunities','UF','uf_','mindicador','radar_service_completed'])][-12:]}))
print(subprocess.check_output(['docker','stats','--no-stream','--format','{{.Name}} {{.CPUPerc}} {{.MemUsage}}']+names,text=True))
'''
r=subprocess.run(ssh+['python3 -B -'],input=code,text=True,capture_output=True,timeout=40);Path(__file__).with_name('radar-deadline-diagnostic.txt').write_text(r.stdout,encoding='utf-8');print(r.stdout);r.check_returncode()
