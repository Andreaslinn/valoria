it client.get(url,follow_redirects=False)\\n if r.status_code in (403,429):raise RuntimeError(\\\'source_blocked_\\\'+str(r.status_code))\\n if r.status_code in (301,302,303,307,308):\\n  from urllib.parse import urljoin,urlsplit\\n  nxt=urljoin(str(r.url),r.headers.get(\\\'location\\\',\\\'\\\'))\\n  if \\\'/gz/account-verification\\\' in nxt or \\\'login\\\' in nxt:raise RuntimeError(\\\'portal_session_expired_302_account_verification\\\')\\n  if urlsplit(nxt).hostname not in {\\\'www.portalinmobiliario.com\\\',\\\'portalinmobiliario.com\\\',\\\'www.mercadolibre.cl\\\',\\\'articulo.mercadolibre.cl\\\',\\\'www.yapo.cl\\\',\\\'yapo.cl\\\'}:return r\\n  await asyncio.sleep(3.1);last=time.monotonic();r=await client.get(nxt,follow_redirects=False)\\n return r\\n\\nasync def main():\\n async with get_session_factory()() as session:\\n  await session.execute(text(\\\'SET TRANSACTION ISOLATION LEVEL REPEATABLE READ, READ ONLY\\\'))\\n  rows=(await session.execute(text("SELECT source,external_id,title,url,comuna,property_type,m2,built_area_m2,usable_area_m2,bedrooms,bathrooms,parking,lat,lon,price_clp,price_uf,price_currency,raw_metadata FROM listings WHERE status=\\\'active\\\' AND property_type=\\\'apartment\\\' AND source IN (\\\'yapo\\\',\\\'portalinmobiliario\\\')"))).mappings().all()\\n  for row in rows:emit({\\\'event\\\':\\\'db_before\\\',**dict(row)})\\n  await session.rollback()\\n async with portal_client(headers=DEFAULT_HEADERS,timeout=30,follow_redirects=False) as client:\\n  for comuna in [\\\'providencia\\\',\\\'vitacura\\\',\\\'la-florida\\\',\\\'estacion-central\\\',\\\'san-miguel\\\',\\\'santiago\\\',\\\'nunoa\\\',\\\'macul\\\']:\\n   r=await get(client,\\\'https://www.portalinmobiliario.com/venta/departamento/propiedades-usadas/\\\'+comuna+\\\'-metropolitana\\\')\\n   report=PortalInmobiliarioScraper.parse_listings_detailed(r.text,uf_to_clp=Decimal(\\\'41162.73\\\'))\\n   for item in report[\\\'items\\\']:\\n    item.pop(\\\'_source_evidence\\\',None)\\n    emit({\\\'event\\\':\\\'fresh_card\\\',\\\'source\\\':\\\'portalinmobiliario\\\',\\\'comuna_target\\\':comuna,**item})\\n emit({\\\'event\\\':\\\'prices_complete\\\'})\\nasyncio.run(main())\\n\',text=True);raise SystemExit(r.returncode)'
