import subprocess,pathlib
remote='import subprocess;r=subprocess.run(["docker","exec","-i","valoria_oracle_beta-api-1","python","-B","-u","-"],input=\'\\nimport asyncio,json,sys,types,time,os,random\\nfrom datetime import UTC,datetime\\nfrom decimal import Decimal\\nfrom bs4 import BeautifulSoup\\nfrom sqlalchemy import text\\nfrom infrastructure.db.database import get_session_factory\\nfrom infrastructure.scrapers.portalinmobiliario import _extract_nordic_initial_state,_components_by_id,PortalInmobiliarioScraper\\nfrom infrastructure.scrapers.yapo_modern import payload_items\\nfrom scripts.portal_session import portal_client\\nfrom scripts.portal_smoke import DEFAULT_HEADERS\\nfrom config.constants import SCRAPER_HTTP_TIMEOUT_SEC,SCRAPER_USER_AGENT\\nimport httpx\\nSOURCES={\\\'domain/ingestion/published_fields.py\\\': \\\'"""Source observations, independent of the valuation compatibility columns.\\\\n\\\\nNever infer useful area from square/total, age from a year, or coordinate\\\\naccuracy from a street number. This JSON contract lives in raw_metadata so\\\\nrolling back the application does not discard evidence or require a downgrade.\\\\n"""\\\\nfrom __future__ import annotations\\\\n\\\\nimport math\\\\nimport re\\\\nimport unicodedata\\\\nfrom datetime import UTC, datetime\\\\n\\\\n\\\\ndef normalized(value):\\\\n    return \\\\\\\'\\\\\\\'.join(c for c in unicodedata.normalize(\\\\\\\'NFD\\\\\\\', str(value or \\\\\\\'\\\\\\\').lower())\\\\n                   if unicodedata.category(c) != \\\\\\\'Mn\\\\\\\')\\\\n\\\\n\\\\ndef number(value):\\\\n    if value is None or isinstance(value, bool):\\\\n        return None\\\\n    text = str(value).strip()\\\\n    if text in {\\\\\\\'\\\\\\\', \\\\\\\'$undefined\\\\\\\', \\\\\\\'null\\\\\\\'}:\\\\n        return None\\\\n    match = re.fullmatch(r\\\\\\\'(-?\\\\\\\\d+(?:[.,]\\\\\\\\d+)?)\\\\\\\\s*(?:m[²2]|años?|anos?)?\\\\\\\', text)\\\\n    if not match:\\\\n        return None\\\\n    result = float(match[1].replace(\\\\\\\',\\\\\\\', \\\\\\\'.\\\\\\\'))\\\\n    return result if math.isfinite(result) else None\\\\n\\\\n\\\\ndef empty_fields(source, external_id, *, stage=\\\\\\\'detail\\\\\\\'):\\\\n    return dict(version=1, source=source, external_id=str(external_id), stage=stage,\\\\n                observed_at=datetime.now(UTC).isoformat(), useful_area_m2=None,\\\\n                total_area_m2=None, constructed_area_m2=None, age_years=None,\\\\n                construction_year=None, construction_year_description=None,\\\\n                construction_year_conflict=False, floor=None, apartment_number=None,\\\\n                latitude=None, longitude=None, coordinates_origin=None,\\\\n                coordinates_precision=None, address_raw=None, street=None,\\\\n                address_number=None, address_range=None, address_type=None,\\\\n                address_description_raw=None,\\\\n                provenance={}, originals={}, rejected={})\\\\n\\\\n\\\\ndef put(fields, key, raw, path, *, positive=False, integer=False):\\\\n    fields[\\\\\\\'originals\\\\\\\'][path] = raw\\\\n    fields[key + \\\\\\\'_raw\\\\\\\'] = raw\\\\n    value = number(raw)\\\\n    if value is None or (positive and value <= 0) or (integer and value != int(value)):\\\\n        return\\\\n    fields[key] = int(value) if integer else value\\\\n    fields[\\\\\\\'provenance\\\\\\\'][key] = path\\\\n\\\\n\\\\ndef coordinates(fields, lat, lon, path, precision=None):\\\\n    fields[\\\\\\\'originals\\\\\\\'][path] = {\\\\\\\'latitude\\\\\\\': lat, \\\\\\\'longitude\\\\\\\': lon}\\\\n    a, b = number(lat), number(lon)\\\\n    if a is None or b is None:\\\\n        return\\\\n    if (a, b) == (0, 0) or not (-90 <= a <= 90 and -180 <= b <= 180):\\\\n        fields[\\\\\\\'rejected\\\\\\\'][\\\\\\\'coordinates\\\\\\\'] = \\\\\\\'invalid_coordinate_pair\\\\\\\'\\\\n        return\\\\n    fields.update(latitude=a, longitude=b, coordinates_origin=path,\\\\n                  coordinates_precision=precision or \\\\\\\'unknown\\\\\\\')\\\\n    fields[\\\\\\\'provenance\\\\\\\'][\\\\\\\'coordinates\\\\\\\'] = path\\\\n\\\\n\\\\ndef address(fields, raw, path):\\\\n    if not isinstance(raw, str) or raw.strip() in {\\\\\\\'\\\\\\\', \\\\\\\'#f_location#\\\\\\\', \\\\\\\'$undefined\\\\\\\'}:\\\\n        return\\\\n    raw = raw.strip()\\\\n    fields[\\\\\\\'address_raw\\\\\\\'] = raw\\\\n    fields[\\\\\\\'provenance\\\\\\\'][\\\\\\\'address\\\\\\\'] = path\\\\n    fields[\\\\\\\'originals\\\\\\\'][path] = raw\\\\n    # These describe a business address, not the property. Never extract its\\\\n    # office floor/unit/number even when it is the only address in the payload.\\\\n    if re.search(r\\\\\\\'\\\\\\\\b(?:oficinas?|ciudad empresarial|oficina del corredor)\\\\\\\\b\\\\\\\', normalized(raw)):\\\\n        fields[\\\\\\\'rejected\\\\\\\'][\\\\\\\'address\\\\\\\'] = {\\\\\\\'reason\\\\\\\': \\\\\\\'broker_office\\\\\\\', \\\\\\\'path\\\\\\\': path}\\\\n        fields[\\\\\\\'address_raw\\\\\\\'] = None\\\\n        return\\\\n    first = raw.split(\\\\\\\',\\\\\\\', 1)[0].strip()\\\\n    parts = [part.strip() for part in raw.split(\\\\\\\',\\\\\\\')]\\\\n    if len(parts) > 1 and re.fullmatch(r\\\\\\\'\\\\\\\\d+[a-zA-Z]?\\\\\\\', parts[1]):\\\\n        first += \\\\\\\' \\\\\\\' + parts[1]\\\\n    ranged = re.fullmatch(r\\\\\\\'(.+?)\\\\\\\\s+(\\\\\\\\d+)\\\\\\\\s*(?:[-–]|a|al)\\\\\\\\s*(\\\\\\\\d+)\\\\\\\', first, re.I)\\\\n    exact = re.fullmatch(r\\\\\\\'(.+?)\\\\\\\\s+(\\\\\\\\d+[a-zA-Z]?)\\\\\\\', first)\\\\n    cross = re.search(r\\\\\\\'\\\\\\\\b(?:entre|esquina|interseccion|con)\\\\\\\\b|\\\\\\\\s[/&]\\\\\\\\s\\\\\\\', normalized(raw))\\\\n    if ranged:\\\\n        fields.update(street=ranged[1], address_range=[ranged[2], ranged[3]], address_type=\\\\\\\'range\\\\\\\')\\\\n    elif cross:\\\\n        fields.update(street=first if not re.search(r\\\\\\\'\\\\\\\\bentre\\\\\\\\b\\\\\\\', normalized(first)) else first.split(\\\\\\\'entre\\\\\\\')[0].strip(),\\\\n                      address_type=\\\\\\\'intersection\\\\\\\')\\\\n    elif exact:\\\\n        fields.update(street=exact[1], address_number=exact[2],\\\\n                      address_type=\\\\\\\'no_number\\\\\\\' if exact[2] == \\\\\\\'0\\\\\\\' else \\\\\\\'exact\\\\\\\')\\\\n    else:\\\\n        # A metro station or commune is a raw location, not an invented street.\\\\n        street = first if re.match(r\\\\\\\'^(?:av\\\\\\\\.?|avenida|calle|pasaje|camino)\\\\\\\\s\\\\\\\', normalized(first)) else None\\\\n        fields.update(street=street, address_type=\\\\\\\'no_number\\\\\\\')\\\\n        if first == \\\\\\\'0\\\\\\\':\\\\n            fields[\\\\\\\'address_number\\\\\\\'] = \\\\\\\'0\\\\\\\'\\\\n\\\\n\\\\ndef description_fields(fields, description, path):\\\\n    if not isinstance(description, str) or description.startswith(\\\\\\\'$\\\\\\\'):\\\\n        return\\\\n    # JSON-LD often contains HTML. Tags must not separate labels from values.\\\\n    from bs4 import BeautifulSoup\\\\n    plain = BeautifulSoup(description, \\\\\\\'lxml\\\\\\\').get_text(\\\\\\\' \\\\\\\', strip=True)\\\\n    text = normalized(plain).replace(\\\\\\\'\\\\\\\\xa0\\\\\\\', \\\\\\\' \\\\\\\')\\\\n    # Preserve an explicitly introduced property address, separately from the\\\\n    # raw structured address. Do not search arbitrary business/contact text.\\\\n    match = re.search(r\\\\\\\'(?i:ubicaci[oó]n(?:\\\\\\\\s+premium)?|direcci[oó]n(?:\\\\\\\\s+de\\\\\\\\s+la\\\\\\\\s+propiedad)?)\\\\\\\\s*:\\\\\\\\s*((?i:Calle|Avenida|Av\\\\\\\\.|Pasaje|Camino)\\\\\\\\s+[^\\\\\\\\n]+?)(?=(?<!Av)(?<!av)\\\\\\\\.\\\\\\\\s+[A-ZÁÉÍÓÚ]|$)\\\\\\\', plain)\\\\n    if match:\\\\n        candidate = match[1].strip()\\\\n        probe = empty_fields(fields[\\\\\\\'source\\\\\\\'], fields[\\\\\\\'external_id\\\\\\\'])\\\\n        address(probe, candidate, path + \\\\\\\':address\\\\\\\')\\\\n        if probe[\\\\\\\'address_raw\\\\\\\']:\\\\n            fields[\\\\\\\'address_description_raw\\\\\\\'] = candidate\\\\n            fields[\\\\\\\'provenance\\\\\\\'][\\\\\\\'address_description_raw\\\\\\\'] = path + \\\\\\\':address\\\\\\\'\\\\n            if fields[\\\\\\\'street\\\\\\\'] is None and probe[\\\\\\\'street\\\\\\\']:\\\\n                for key in (\\\\\\\'street\\\\\\\', \\\\\\\'address_number\\\\\\\', \\\\\\\'address_range\\\\\\\', \\\\\\\'address_type\\\\\\\'):\\\\n                    fields[key] = probe[key]\\\\n    # Only explicitly labelled areas; never interpret an unqualified m² number.\\\\n    for key, labels in [(\\\\\\\'useful_area_m2\\\\\\\', r\\\\\\\'util(?:es)?\\\\\\\'),\\\\n                        (\\\\\\\'total_area_m2\\\\\\\', r\\\\\\\'total(?:es)?\\\\\\\'),\\\\n                        (\\\\\\\'constructed_area_m2\\\\\\\', r\\\\\\\'construid[oa]s?\\\\\\\')]:\\\\n        unit = r\\\\\\\'(?:m[²2]|mts?2|metros(?:\\\\\\\\s+cuadrados)?)\\\\\\\'\\\\n        patterns = [rf\\\\\\\'(\\\\\\\\d+(?:[.,]\\\\\\\\d+)?)\\\\\\\\s*{unit}\\\\\\\\s*(?:de\\\\\\\\s+)?{labels}\\\\\\\',\\\\n                    rf\\\\\\\'(?:superficie\\\\\\\\s+)?{labels}\\\\\\\\s*[:=]?\\\\\\\\s*(\\\\\\\\d+(?:[.,]\\\\\\\\d+)?)\\\\\\\\s*{unit}\\\\\\\']\\\\n        for pattern in patterns:\\\\n            match = re.search(pattern, text)\\\\n            if match and fields[key] is None:\\\\n                put(fields, key, match[1], path + \\\\\\\':\\\\\\\' + key, positive=True)\\\\n                break\\\\n    if fields[\\\\\\\'floor\\\\\\\'] is None:\\\\n        match = re.search(r\\\\\\\'\\\\\\\\bpiso\\\\\\\\s*[:=]?\\\\\\\\s*(?:n[°ºo.]?\\\\\\\\s*)?(\\\\\\\\d{1,3})\\\\\\\\b\\\\\\\', text)\\\\n        if match is None:\\\\n            match = re.search(r\\\\\\\'\\\\\\\\b(\\\\\\\\d{1,3})\\\\\\\\s*(?:°|º|er|do|to|mo|vo|no)?\\\\\\\\s+piso\\\\\\\\b\\\\\\\', text)\\\\n        if match and not re.search(r\\\\\\\'\\\\\\\\boficinas?\\\\\\\\b|departamentos?\\\\\\\\s+por\\\\\\\\s+\\\\\\\', text[max(0, match.start()-35):match.end()+50]):\\\\n            put(fields, \\\\\\\'floor\\\\\\\', match[1], path + \\\\\\\':floor\\\\\\\', integer=True)\\\\n    match = re.search(r\\\\\\\'(?:ano\\\\\\\\s*(?:de\\\\\\\\s*)?construccion|construido\\\\\\\\s*(?:en\\\\\\\\s*)?(?:el\\\\\\\\s*)?(?:ano\\\\\\\\s*)?)\\\\\\\\s*[:=]?\\\\\\\\s*((?:19|20)\\\\\\\\d{2})\\\\\\\\b\\\\\\\', text)\\\\n    if match:\\\\n        put(fields, \\\\\\\'construction_year_description\\\\\\\', match[1], path + \\\\\\\':construction_year\\\\\\\', integer=True)\\\\n        fields[\\\\\\\'construction_year_conflict\\\\\\\'] = (fields[\\\\\\\'construction_year\\\\\\\'] is not None and\\\\n            fields[\\\\\\\'construction_year\\\\\\\'] != fields[\\\\\\\'construction_year_description\\\\\\\'])\\\\n    if fields[\\\\\\\'age_years\\\\\\\'] is None:\\\\n        match = re.search(r\\\\\\\'(?:antiguedad\\\\\\\\s*[:=]?\\\\\\\\s*)(\\\\\\\\d+)\\\\\\\\s*anos?\\\\\\\', text)\\\\n        if match is None:\\\\n            match = re.search(r\\\\\\\'\\\\\\\\b(\\\\\\\\d+)\\\\\\\\s*anos?\\\\\\\\s*(?:de\\\\\\\\s*)?antiguedad\\\\\\\\b\\\\\\\', text)\\\\n        if match:\\\\n            put(fields, \\\\\\\'age_years\\\\\\\', match[1], path + \\\\\\\':age\\\\\\\', integer=True)\\\\n\\\\n\\\\ndef area_kind(raw):\\\\n    """Label the compatibility m² without changing the number used by the engine."""\\\\n    fields = (raw.get(\\\\\\\'raw_metadata\\\\\\\') or {}).get(\\\\\\\'published_fields\\\\\\\') or {}\\\\n    value = number(raw.get(\\\\\\\'m2\\\\\\\'))\\\\n    for key, kind in [(\\\\\\\'useful_area_m2\\\\\\\', \\\\\\\'useful\\\\\\\'), (\\\\\\\'constructed_area_m2\\\\\\\', \\\\\\\'constructed\\\\\\\'),\\\\n                      (\\\\\\\'total_area_m2\\\\\\\', \\\\\\\'total\\\\\\\')]:\\\\n        if value is not None and fields.get(key) == value:\\\\n            return kind\\\\n    origin = str((raw.get(\\\\\\\'raw_metadata\\\\\\\') or {}).get(\\\\\\\'area_source\\\\\\\') or \\\\\\\'\\\\\\\')\\\\n    return \\\\\\\'constructed\\\\\\\' if origin == \\\\\\\'yapo_payload.square\\\\\\\' else \\\\\\\'generic\\\\\\\'\\\\n\\\', \\\'infrastructure/scrapers/published_fields.py\\\': \\\'"""Publication-bound source facts. No HTTP, valuation or geocoding calls."""\\\\nimport json\\\\nimport re\\\\n\\\\nfrom domain.ingestion.published_fields import (\\\\n    address, coordinates, description_fields, empty_fields, normalized, put,\\\\n)\\\\n\\\\n\\\\ndef portal_fields(state, components, external_id):\\\\n    fields = empty_fields(\\\\\\\'portalinmobiliario\\\\\\\', external_id)\\\\n    if components.get(\\\\\\\'quotable_models\\\\\\\'):\\\\n        return None  # Projects publish ranges, not the attributes of a unit.\\\\n    bound = re.sub(r\\\\\\\'[^0-9]\\\\\\\', \\\\\\\'\\\\\\\', str(state.get(\\\\\\\'id\\\\\\\', \\\\\\\'\\\\\\\')))\\\\n    if bound != re.sub(r\\\\\\\'[^0-9]\\\\\\\', \\\\\\\'\\\\\\\', str(external_id)):\\\\n        return None\\\\n    tech = components.get(\\\\\\\'technical_specifications\\\\\\\') or {}\\\\n    labels = {\\\\\\\'superficie util\\\\\\\': \\\\\\\'useful_area_m2\\\\\\\', \\\\\\\'superficie total\\\\\\\': \\\\\\\'total_area_m2\\\\\\\',\\\\n              \\\\\\\'superficie construida\\\\\\\': \\\\\\\'constructed_area_m2\\\\\\\',\\\\n              \\\\\\\'numero de piso de la unidad\\\\\\\': \\\\\\\'floor\\\\\\\', \\\\\\\'antiguedad\\\\\\\': \\\\\\\'age_years\\\\\\\'}\\\\n    for index, spec in enumerate(tech.get(\\\\\\\'specs\\\\\\\') or []):\\\\n        for attr in spec.get(\\\\\\\'attributes\\\\\\\') or []:\\\\n            label = normalized(attr.get(\\\\\\\'id\\\\\\\') or attr.get(\\\\\\\'name\\\\\\\') or attr.get(\\\\\\\'title\\\\\\\')).strip()\\\\n            key = labels.get(label)\\\\n            if key:\\\\n                put(fields, key, attr.get(\\\\\\\'text\\\\\\\'),\\\\n                    f\\\\\\\'portal.technical_specifications.specs[{index}].{attr.get("id")}\\\\\\\',\\\\n                    positive=key.endswith(\\\\\\\'_m2\\\\\\\'), integer=key in {\\\\\\\'floor\\\\\\\', \\\\\\\'age_years\\\\\\\'})\\\\n    for name in (\\\\\\\'location_and_points\\\\\\\', \\\\\\\'location\\\\\\\'):\\\\n        info = (components.get(name) or {}).get(\\\\\\\'map_info\\\\\\\') or {}\\\\n        point = info.get(\\\\\\\'location\\\\\\\') or {}\\\\n        if point and fields[\\\\\\\'latitude\\\\\\\'] is None:\\\\n            coordinates(fields, point.get(\\\\\\\'latitude\\\\\\\'), point.get(\\\\\\\'longitude\\\\\\\'),\\\\n                        f\\\\\\\'portal:{name}.map_info.location\\\\\\\', info.get(\\\\\\\'precision\\\\\\\'))\\\\n        if info.get(\\\\\\\'item_address\\\\\\\') and fields[\\\\\\\'address_raw\\\\\\\'] is None:\\\\n            address(fields, info[\\\\\\\'item_address\\\\\\\'], f\\\\\\\'portal:{name}.map_info.item_address\\\\\\\')\\\\n    description_fields(fields, (components.get(\\\\\\\'description\\\\\\\') or {}).get(\\\\\\\'content\\\\\\\'),\\\\n                       \\\\\\\'portal.description.content\\\\\\\')\\\\n    return fields\\\\n\\\\n\\\\ndef yapo_description(soup, item):\\\\n    description = item.get(\\\\\\\'description\\\\\\\')\\\\n    if isinstance(description, str) and not description.startswith(\\\\\\\'$\\\\\\\'):\\\\n        return description\\\\n    for script in soup.select(\\\\\\\'script[type="application/ld+json"]\\\\\\\'):\\\\n        try:\\\\n            value = json.loads(script.string or script.get_text())\\\\n        except (ValueError, TypeError):\\\\n            continue\\\\n        objects = value if isinstance(value, list) else [value]\\\\n        for obj in objects:\\\\n            if isinstance(obj, dict) and obj.get(\\\\\\\'@type\\\\\\\') == \\\\\\\'Product\\\\\\\':\\\\n                # Ignore a related Product if the document supplies its identity.\\\\n                product_url = obj.get(\\\\\\\'url\\\\\\\') or (obj.get(\\\\\\\'offers\\\\\\\') or {}).get(\\\\\\\'url\\\\\\\')\\\\n                if product_url and str(item[\\\\\\\'id\\\\\\\']) not in str(product_url):\\\\n                    continue\\\\n                return obj.get(\\\\\\\'description\\\\\\\') or \\\\\\\'\\\\\\\'\\\\n    return \\\\\\\'\\\\\\\'\\\\n\\\\n\\\\ndef yapo_fields(item, soup=None, *, stage=\\\\\\\'detail\\\\\\\'):\\\\n    fields = empty_fields(\\\\\\\'yapo\\\\\\\', item[\\\\\\\'id\\\\\\\'], stage=stage)\\\\n    for key, native in [(\\\\\\\'constructed_area_m2\\\\\\\', \\\\\\\'square\\\\\\\'), (\\\\\\\'total_area_m2\\\\\\\', \\\\\\\'lotSize\\\\\\\'),\\\\n                        (\\\\\\\'useful_area_m2\\\\\\\', \\\\\\\'usableArea\\\\\\\'), (\\\\\\\'floor\\\\\\\', \\\\\\\'floor\\\\\\\')]:\\\\n        put(fields, key, item.get(native), \\\\\\\'yapo.\\\\\\\' + native,\\\\n            positive=key.endswith(\\\\\\\'_m2\\\\\\\'), integer=key == \\\\\\\'floor\\\\\\\')\\\\n    age = item.get(\\\\\\\'age\\\\\\\')\\\\n    from domain.ingestion.published_fields import number\\\\n    numeric = number(age)\\\\n    if numeric is not None:\\\\n        put(fields, \\\\\\\'construction_year\\\\\\\' if 1800 <= numeric <= 2100 else \\\\\\\'age_years\\\\\\\',\\\\n            age, \\\\\\\'yapo.age\\\\\\\', integer=True)\\\\n    location = item.get(\\\\\\\'location\\\\\\\') or {}\\\\n    coordinates(fields, location.get(\\\\\\\'lat\\\\\\\'), location.get(\\\\\\\'lon\\\\\\\'), \\\\\\\'yapo.location\\\\\\\',\\\\n                location.get(\\\\\\\'precision\\\\\\\'))\\\\n    # location.address can be the broker\\\\\\\'s office. exactAddress is the\\\\n    # publication\\\\\\\'s own field; locality is preserved raw, never a street guess.\\\\n    address(fields, item.get(\\\\\\\'exactAddress\\\\\\\'), \\\\\\\'yapo.exactAddress\\\\\\\')\\\\n    office = location.get(\\\\\\\'address\\\\\\\')\\\\n    if office and re.search(r\\\\\\\'\\\\\\\\b(?:oficinas?|ciudad empresarial)\\\\\\\\b\\\\\\\', normalized(office)):\\\\n        fields[\\\\\\\'rejected\\\\\\\'][\\\\\\\'location.address\\\\\\\'] = {\\\\\\\'reason\\\\\\\': \\\\\\\'broker_office\\\\\\\', \\\\\\\'raw\\\\\\\': office}\\\\n    if soup is not None:\\\\n        description_fields(fields, yapo_description(soup, item), \\\\\\\'yapo.jsonld.Product.description\\\\\\\')\\\\n    return fields\\\\n\\\'}\\nFIXED=[{\\\'source\\\': \\\'yapo\\\', \\\'id\\\': \\\'33000977\\\', \\\'comuna\\\': \\\'providencia\\\', \\\'url\\\': \\\'https://www.yapo.cl/bienes-raices-venta-de-propiedades-apartamentos/2d-estar-terraza-y-estacionamiento-en-providencia/33000977\\\', \\\'checked_at\\\': \\\'2026-10-15T21:11:16.697531+00:00\\\', \\\'address_original\\\': \\\'Providencia, Santiago, Metropolitana De Santiago\\\', \\\'useful_original\\\': \\\'\\\', \\\'total_original\\\': \\\'120\\\', \\\'built_original\\\': \\\'109\\\', \\\'floor_original\\\': \\\'4\\\', \\\'age_original\\\': \\\'2003\\\', \\\'useful_structured\\\': False, \\\'total_structured\\\': True, \\\'floor_structured\\\': True, \\\'age_structured\\\': True, \\\'address_number\\\': False, \\\'address_range\\\': False, \\\'address_zero\\\': False, \\\'address_reference\\\': True, \\\'apartment_number\\\': False, \\\'useful\\\': True, \\\'total\\\': True, \\\'coordinates\\\': True, \\\'precision_declared\\\': False, \\\'floor\\\': True, \\\'age\\\': True, \\\'lat\\\': -33.4391162, \\\'lon\\\': -70.6036636, \\\'useful_description\\\': \\\'109 m²\\\', \\\'total_description\\\': \\\'\\\', \\\'floor_description\\\': \\\'\\\', \\\'age_description\\\': \\\'\\\', \\\'address_description\\\': \\\'Calle Ricardo Lyon, entre Bustos y Francisco de Bilbao\\\'}, {\\\'source\\\': \\\'yapo\\\', \\\'id\\\': \\\'33014082\\\', \\\'comuna\\\': \\\'nunoa\\\', \\\'url\\\': \\\'https://www.yapo.cl/bienes-raices-venta-de-propiedades-apartamentos/depto-1-dormitorio-con-bodega-en-irarrazaval-nunoa-a-pasos-del-metro/33014082\\\', \\\'checked_at\\\': \\\'2026-10-15T21:13:34.001689+00:00\\\', \\\'address_original\\\': \\\'Irarrazaval 5091\\\', \\\'useful_original\\\': \\\'\\\', \\\'total_original\\\': \\\'37\\\', \\\'built_original\\\': \\\'37\\\', \\\'floor_original\\\': \\\'19\\\', \\\'age_original\\\': \\\'2008\\\', \\\'useful_structured\\\': False, \\\'total_structured\\\': True, \\\