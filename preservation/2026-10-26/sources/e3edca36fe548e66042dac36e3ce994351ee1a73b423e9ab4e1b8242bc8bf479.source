for n,(status,evidence) in statuses.items():
 pattern=rf'(### #{n} — [^\n]+\n)'
 s=re.sub(pattern,lambda m:m[1]+f'\n- **Current continuation acceptance:** {status}. {evidence}\n',s,count=1)
checkpoint='''
## Final continuation checkpoint — release intentionally withheld

- Four original failures resolved with demonstrable fixture/expectation corrections; full final suite1935 passed,9 deprecation warnings,290.27s. No skips or production guards weakened. Earlier intermittent ZIP manifest failure did not recur.
- Six Oracle failures classified A/C (candidate implemented, older deployed runtime); thumbnail response shape also required preserving the typed production lookup schema (B). New live Portal success is separately F, not proof of successful acquisition from a capability flag.
- Final immutable API overlay commit41773aafbc2b731fbc5d4de5049697806c01ff96; image valoria-remediation:candidate-20261012-v3, sha256:a3148c4ca46139f34f28d75a910c7c5e9ed51af86ac23ce56cdf131d0dc096a5; fingerprint0d7873228253e3d1ecd4e05c7c22540e72bcc5682e60d544799cd53215a40ebe. Earlier candidate images are superseded and must not deploy.
- Production unchanged: valoria-portal-geo:0ceeb1e-20261011, sha256:3342a667c071319097e6c6aed23bfd03ec231f6bf44cd17434d6a0de13187f15. Host checkout06723a90d792221a2deecf22d635c221940dea6f is not asserted as exact image source commit. Original local mixed checkout remains HEAD5288dde, uncommitted; overlay snapshot is separate provenance.
- Protected backup restored;7030 listings/5240 observations/7 users preserved through isolated0021->0022 rehearsal. UPDATE/DELETE/TRUNCATE history guards enforced. Old application can query restored upgraded schema. Rollback tag points to exact production digest; no destructive downgrade required. Production migration remains0021.
- Final production health healthy; Yapo and Portal discovery latest services Result=success/ExecMainStatus0. Persistent volume identities and production start times unchanged. Backups and candidate image preparation are the only remote operational changes; no scraper/session/timer edits.
- Next required action: successful permitted new Portal URL acquisition against the actual candidate, without bypassing upstream controls or changing acquisition sessions; repeat candidate gate. Then refresh backup/runtime/configuration/resource/worker prerequisites and activate only final API overlay using all five existing compose files plus a reviewed image-only override; apply0022 only, restart API only, verify served digest/fingerprint and six contract checks, and perform safe actual1130/298/Portal validation. Frontend deployment target/packaging must be reconciled separately before claiming deployed V2 browser acceptance. No release override was written or activated.
- Continuation code changes include fixture clocks/price selector/normalized expectations, actual OpenAPI test, historical/manual report preservation, saved-state disabled guard/abort propagation, secondary prefill, production0021/observation ORM preservation,0022 and migration-chain regression, portfolio target propagation in overlay, expanded fingerprint, and reusable16-scenario browser scripts. Evidence lives in the final acceptance folder alongside this ledger.
'''
s+=checkpoint;ledger.write_text(s,encoding='utf-8');shutil.copy2(ledger,O/'valoria-v2-remediation.md');shutil.copy2(R/'docs/valoria-v2-architecture.md',O/'valoria-v2-architecture.md')
table='| # | Finding | Current acceptance | Evidence / limit |\n|---|---|---|---|\n'
titles={int(n):t for n,t in re.findall(r'### #(\d+) — ([^\n]+)',s)}
for n in range(1,22):table+=f'| {n} | {titles[n]} | {statuses[n][0]} | {statuses[n][1]} |\n'
(O/'findings-acceptance-matrix.md').write_text(table,encoding='utf-8')
evidence=O/'acceptance-evidence';evidence.mkdir(exist_ok=True)
files=['acceptance-final-backend.log','acceptance-final-build.log','continuation-four-baseline.log','phase1-focused.log','oracle-contract-gate.txt','candidate-image-gate.txt','candidate-restored-data-gate.txt','candidate-api-evidence.json','candidate-temporal-evidence.json','new-live-portal.json','oracle-backup-restore-evidence.json','oracle-migration-rollback-rehearsal.json','oracle-final-state.json','candidate-e2e.log','candidate-e2e-extra.log','candidate-e2e-final.log','seed_candidate.py','temporal_candidate.py','overlay-paths.json','oracle-overlay-review.diff']
for name in files:shutil.copy2(W/name,evidence/name)
shutil.copytree(W/'e2e',evidence/'e2e',dirs_exist_ok=True)
shutil.copy2(W/'release-overlay-v3/manifest.json',evidence/'candidate-image-manifest.json')
for name in ['v2_browser_core.py','v2_browser_recovery.py','v2_browser_sessions.py','README.md']:shutil.copy2(E/name,evidence/name)
# Old failure screenshots remain as investigation history, not final failures; final JSON is authoritative.
manifest={str(p.relative_to(evidence)):hashlib.sha256(p.read_bytes()).hexdigest() for p in evidence.rglob('*') if p.is_file()}
(O/'acceptance-evidence-sha256.json').write_text(json.dumps(manifest,indent=2),encoding='utf-8')
