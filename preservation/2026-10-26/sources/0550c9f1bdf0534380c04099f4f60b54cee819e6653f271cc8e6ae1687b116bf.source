import subprocess
from pathlib import Path
ssh=[r'C:\Windows\System32\OpenSSH\ssh.exe','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes','-o','ConnectTimeout=15','-i',r'C:\Users\heiko\Downloads\ssh-key-2026-07-07 (1).key','ubuntu@161.153.201.245']
code='''import pathlib,subprocess,json,hashlib,datetime,tarfile,io,time
BACK=pathlib.Path('/home/ubuntu/backups/portal-release-20261012');assert not BACK.exists(),'Refuse overwrite';BACK.mkdir(mode=0o700)
def run(args,**kw):
 r=subprocess.run(args,capture_output=True,timeout=100,**kw)
 assert r.returncode==0,'Private backup/restore command failed; details withheld'
 return r.stdout
x=json.loads(run(['docker','inspect','valoria_oracle_beta-api-1']))[0]
assert x['Image']=='sha256:3342a667c071319097e6c6aed23bfd03ec231f6bf44cd17434d6a0de13187f15'
dump=run(['docker','exec','valoria_oracle_beta-postgres-1','sh','-c','exec pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc']);assert dump.startswith(b'PGDMP')
listing=run(['docker','exec','-i','valoria_oracle_beta-postgres-1','pg_restore','--list'],input=dump)
assert b'TABLE DATA public listings' in listing and b'TABLE DATA public listing_observations' in listing
globals_data=run(['docker','exec','valoria_oracle_beta-postgres-1','sh','-c','exec pg_dumpall -U "$POSTGRES_USER" --globals-only'])
buf=io.BytesIO()
with tarfile.open(fileobj=buf,mode='w:gz') as t:
 for name in x['Config']['Labels']['com.docker.compose.project.config_files'].split(',')+['/home/ubuntu/apps/valoria/deploy/oracle.env','/home/ubuntu/apps/valoria/deploy/Caddyfile.oracle']:
  p=pathlib.Path(name);t.add(p,arcname=str(p.relative_to('/home/ubuntu/apps/valoria')),recursive=False)
 content=json.dumps(x).encode();info=tarfile.TarInfo('container-before.json');info.size=len(content);info.mode=0o600;t.addfile(info,io.BytesIO(content))
records=[]
for name,data in [('database.dump',dump),('globals.sql',globals_data),('configuration.tar.gz',buf.getvalue()),('restore-list.txt',listing)]:
 p=BACK/name;p.write_bytes(data);p.chmod(0o600);records.append({'name':name,'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()})
run(['docker','image','tag',x['Image'],'valoria-remediation-rollback:20261012'])
name='valoria-portal-release-restore-check'
run(['docker','run','-d','--name',name,'--network','none','--memory','256m','--cpus','1','-e','POSTGRES_USER=restore_test','-e','POSTGRES_DB=restore_check','-e','POSTGRES_HOST_AUTH_METHOD=trust','postgres:16-alpine'])
for i in range(30):
 r=subprocess.run(['docker','exec',name,'pg_isready','-U','restore_test','-d','restore_check'],capture_output=True)
 if r.returncode==0:break
 time.sleep(1)
else:raise RuntimeError('Restore checker not ready')
run(['docker','exec','-i',name,'pg_restore','--no-owner','--no-acl','--exit-on-error','-U','restore_test','-d','restore_check'],input=dump)
counts=run(['docker','exec',name,'psql','-U','restore_test','-d','restore_check','-At','-c',"SELECT 'revision', version_num FROM alembic_version; SELECT 'listings',count(*)::text FROM listings; SELECT 'observations',count(*)::text FROM listing_observations; SELECT 'users',count(*)::text FROM users;"]).decode()
result={'backup':str(BACK),'base_image':x['Image'],'artifacts':records,'restore_exit':0,'restore_counts':counts,'production_mutations':'none; backup/image tag only; restore isolated network-none container'}
(BACK/'manifest.json').write_text(json.dumps(result,indent=2));(BACK/'manifest.json').chmod(0o600);print(json.dumps(result,indent=2))
'''
r=subprocess.run(ssh+['python3 -B -'],input=code,text=True,capture_output=True,timeout=140);Path(r'C:\Users\heiko\Documents\Codex\2026-10-12\files-pasted-by-the-user-valoria\work\portal-release-backup-restore.json').write_text(r.stdout+r.stderr,encoding='utf-8');print(r.stdout);print(r.stderr if r.returncode else '');r.check_returncode()
