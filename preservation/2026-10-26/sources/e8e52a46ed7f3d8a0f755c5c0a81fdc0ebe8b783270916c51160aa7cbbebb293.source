"""Observable source geography. Unknown precision is not invalid geometry.

USABLE requires explicit source precision plus a publication-bound origin.
UNCERTAIN points may be studied separately; no meter accuracy is inferred.
This module neither resolves physical identity nor geocodes addresses.
"""
import math
import re

VERSION = 'source-geo-v0'

def mlc(value):
    match = re.search(r'MLC[- ]?(\d+)', str(value or ''), re.I)
    return 'MLC-' + match.group(1) if match else None

def assess(lat, lon, *, precision=None, source=None, identity_match=None,
           repeated=False, approximate=False, conflict=False, declared_precision=False):
    if lat is None and lon is None:
        return {'status':'MISSING','reason':'no_coordinate_pair'}
    if lat is None or lon is None or isinstance(lat,bool) or isinstance(lon,bool):
        return {'status':'INVALID','reason':'incomplete_or_boolean_pair'}
    try: x,y=float(lat),float(lon)
    except (ValueError,TypeError,OverflowError):
        return {'status':'INVALID','reason':'non_numeric_pair'}
    if not math.isfinite(x+y) or not (-90<=x<=90 and -180<=y<=180) or (x,y)==(0,0):
        return {'status':'INVALID','reason':'range_nonfinite_or_null_island'}
    if identity_match is False or conflict:
        return {'status':'INVALID','reason':'publication_or_location_conflict'}
    if repeated or precision in ('comuna','comuna_centroid'):
        return {'status':'UNCERTAIN','reason':'centroid_or_repeated_coordinate','local_eligible':False}
    if approximate or not source or identity_match is not True or not declared_precision or precision not in ('address','street'):
        return {'status':'UNCERTAIN','reason':'source_location_accuracy_not_certified','local_eligible':True}
    return {'status':'USABLE','reason':'source_bound_coordinate_with_declared_precision','local_eligible':True}

def evidence(raw_lat, raw_lon, *, publication_id, source, observed_at=None, precision='unknown'):
    quality=assess(raw_lat,raw_lon,precision=precision,source=source,identity_match=True)
    valid=quality['status'] not in ('INVALID','MISSING')
    return {'version':VERSION,'source':source,'source_listing_id':publication_id,
            'original':{'lat':raw_lat,'lon':raw_lon},
            'normalized':{'lat':float(raw_lat),'lon':float(raw_lon)} if valid else None,
            'precision':precision,'quality':quality,'observed_at':observed_at}

def bind_detail(detail, state, requested_url):
    """Accept geography only if an independent page ID matches the requested MLC."""
    metadata=detail['raw_metadata']
    point_id=mlc(state.get('id'))
    requested=mlc(requested_url)
    canonical=mlc(detail.get('canonical_url'))
    known=[x for x in (point_id,requested,canonical) if x]
    bound=bool(point_id and known and len(set(known))==1)
    if 'lat' not in metadata and 'lon' not in metadata:return
    if not bound:
        metadata['coordinates_rejection_reason']='unbound_or_conflicting_mlc'
        metadata['coordinates_rejected_raw']={'lat':metadata.pop('lat',None),'lon':metadata.pop('lon',None)}
        metadata.pop('location_source',None)
        return
    raw=metadata.pop('coordinates_raw',{'lat':metadata.get('lat'),'lon':metadata.get('lon')})
    ev=evidence(raw['lat'],raw['lon'],publication_id=point_id,source=metadata.get('location_source'),
                observed_at=detail.get('scraped_at'))
    metadata.update(coordinates_evidence=ev,geocode_precision='unknown',
                    geocode_precision_reason='source_map_accuracy_not_certified')

def attach_map_point(card, point, *, observed_at=None):
    """Offline adapter for an already acquired map point; never requests a map."""
    from copy import deepcopy
    out=deepcopy(card)
    expected=mlc(card.get('external_id'));actual=mlc(point.get('id'))
    if not expected or actual!=expected:raise ValueError('Map point MLC mismatch')
    ev=evidence(point.get('latitude'),point.get('longitude'),publication_id=actual,
                source='portal:map_listing_point',observed_at=observed_at)
    if ev['normalized'] is None:raise ValueError('Invalid map coordinate pair')
    out.update(ev['normalized'],geocode_precision='unknown')
    out.setdefault('raw_metadata',{}).update(coordinates_evidence=ev,
        location_source=ev['source'],geocode_precision='unknown',**ev['normalized'])
    return out
