import os,json,subprocess
from pathlib import Path
import httpx
root=Path(__file__).parent
repo=root/'valoria'
branch='feature/sii-closing-layer-20261019'
assert not subprocess.check_output(['git','status','--porcelain'],cwd=repo,text=True).strip()
sha=subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()
parent=subprocess.check_output(['git','rev-parse','HEAD^'],cwd=repo,text=True).strip()
assert parent=='d4e6ef9c6baeeee7557c7a7c2818cb55c66ff1ce'
protected=['services/valuation.py','services/sii/closing_knn.py','services/sii/closing_confidence.py','services/sii/closing_address.py','config/valuation_flags.py','reports/sii/closing_confidence_20261019/frozen-rule.json']
assert not subprocess.check_output(['git','diff',parent,'--name-only','--',*protected],cwd=repo,text=True).strip()
assert '181 passed' in (root/'sii-role-tests.log').read_text(encoding='utf8')
os.environ['GIT_TERMINAL_PROMPT']='0';os.environ['GCM_INTERACTIVE']='never'
credential=subprocess.run(['git','credential','fill'],input='protocol=https\nhost=github.com\n\n',cwd=repo,text=True,capture_output=True,timeout=20)
if credential.returncode:raise SystemExit('Credential unavailable; sensitive output suppressed')
fields=dict(x.split('=',1) for x in credential.stdout.splitlines() if '=' in x)
token=fields.get('password')
if not token:raise SystemExit('Credential unavailable')
url='https://api.github.com/repos/Andreaslinn/valoria/pulls/11'
with httpx.Client(headers={'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'},timeout=30,follow_redirects=False) as client:
    response=client.get(url);response.raise_for_status();pr=response.json()
    assert pr['state']=='open' and pr['draft'] and not pr['merged_at']
    assert pr['head']['ref']==branch and pr['head']['sha'] in {parent,sha}
    assert pr['base']['ref']=='release/canonical-only-reproducible-20261013'
    body=pr['body']
    _,sep,rest=body.partition('\n\n')
    lead='Busca por **dirección o rol y comuna**, autocompleta los atributos disponibles de la unidad y presenta una **segunda opinión con cierres SII** junto al valor actual. `sii_closing_layer` sigue **apagado por defecto**; motor canónico, K, pesos, escalas y regla congelada permanecen iguales.'
    body=lead+(sep+rest if sep else '\n\n'+body)
    section=f'''### Búsqueda por rol

Ambas interfaces permiten elegir «Por dirección» o «Por rol». Identificación exacta por manzana-predio en la comuna seleccionada, o rol completo con código SII. Admite ceros iniciales, espacios y guion/barra; rechaza prefijos de otra comuna y consultas incompletas.

- Endpoint autenticado `/api/v1/tasar/rol-details`, bajo el mismo flag y SQLite de solo lectura. Devuelve atributos de la unidad y su dirección únicamente para el rol solicitado explícitamente.
- Tasación directa mediante `sii_rol`: sin resolver de nuevo la dirección y excluyendo las ventas del propio rol de los comparables. El canónico mantiene sus entradas y cálculo.
- Ficha y superficies autocompletadas, con correcciones manuales conservadas. Avisos para formato inválido o rol ausente. La segunda opinión mantiene privacidad de comparables.
- **181 pruebas en verde**, Ruff y TypeScript en ambas interfaces. Igualdad byte a byte con la release con flag apagado, incluso con valores de rol mal tipados; equivalencia entre dirección y rol para la misma unidad.
- Verificado en Tasar local: rol corto/completo, autocompletado, consulta inválida y tasación con segunda opinión. Capturas y registros individuales exclusivamente locales.

[Informe agregado](https://github.com/Andreaslinn/valoria/blob/{sha}/reports/sii/role_lookup_20261020/report.md).

'''
    anchor='### Autocompletado y ficha de propiedad'
    assert anchor in body
    body=body.replace(anchor,section+anchor,1)
    (root/'role-pr-body.md').write_text(body,encoding='utf8')
    subprocess.run(['git','push','origin',branch],cwd=repo,check=True,timeout=90)
    response=client.patch(url,json={'title':'SII: búsqueda por dirección o rol y segunda opinión en Tasar','body':body});response.raise_for_status()
    response=client.get(url);response.raise_for_status();pr=response.json()
    assert pr['draft'] and not pr['merged_at'] and pr['head']['sha']==sha
    result={'url':pr['html_url'],'sha':sha,'draft':True,'merged':False,'deployed':False,'flag_default':False,'tests':'181 passed','private_records_published':False}
    (root.parent/'outputs/SII_BUSQUEDA_ROL_PR.json').write_text(json.dumps(result,indent=2),encoding='utf8')
    print(json.dumps(result))
