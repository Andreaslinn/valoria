"use client";
import {PropertyPhoto} from "@/components/ui/property-photo";
import {useEffect,useRef,useState,type FormEvent} from "react";
import {useRouter} from "next/navigation";
import {ArrowRight,ArrowUpRight,Bookmark,Check,Download,Link2,ScanLine,ShieldCheck,SlidersHorizontal,X} from "lucide-react";
import {AppShell} from "@/components/layout/app-shell";
import {Badge,Button,Card} from "@/components/ui/primitives";
import {legacyRoute,safeExternalUrl} from "@/lib/navigation";
import {formatClp,formatUf,formatNumber,formatCommuneName,formatPropertyType,formatDateTime,formatConfidence} from "@/lib/formatters";
import {saveTasarPrefill} from "@/features/valuation/prefill";
import {mapWarningCodes} from "@/features/valuation/warning-taxonomy";
import {useListingUrl,analysisError} from "./use-listing-url";
import {finite,freshnessText,toTasarPrefill,priceComparisonLabel} from "./view-model";
import "./listing-url.css";

export function ListingUrlWorkspace(){
  const m=useListingUrl(),router=useRouter();
  const [dialog,setDialog]=useState<{title:string;text:string;login?:boolean}|null>(null),[loginError,setLoginError]=useState(""),[signingIn,setSigningIn]=useState(false);
  const modal=useRef<HTMLDialogElement>(null);
  useEffect(()=>{if(dialog)modal.current?.showModal();else modal.current?.close();},[dialog]);
  function navigate(label:string){if(label==="Workspace personal"){setLoginError("");setDialog({title:m.auth?"Tu espacio de análisis":"Sesión de Valoria",text:m.auth?"Inicia sesión para consultar publicaciones y contrastar su precio.":`Sesión activa: ${m.user}`,login:m.auth});return;}const route=legacyRoute(label);if(route)router.push(route);}
  async function login(event:FormEvent<HTMLFormElement>){event.preventDefault();const data=new FormData(event.currentTarget);setSigningIn(true);setLoginError("");try{await m.login(String(data.get("email")),String(data.get("password")));setDialog(null);}catch(e){setLoginError(analysisError(e));}finally{setSigningIn(false);}}
  const data=m.result?.listing_data,analysis=m.analysis;
  const external=safeExternalUrl(m.result?.url);
  const status=m.result?.status==="found_existing"?"En Valoria":m.result?.status==="parsed_new"?"Datos extraídos":m.result?.status==="partial"?"Ficha parcial":"Datos disponibles";
  const warnings=mapWarningCodes([...(m.result?.warnings??[]),...(analysis?.valuation.warnings??[])]);
  const validId=finite(data?.listing_id)&&data.listing_id>0;
  function tasar(){if(!data||!m.result)return;try{saveTasarPrefill(toTasarPrefill(data,m.result.url));router.push("/tasar");}catch{setDialog({title:"No se pudo preparar la ficha",text:"El navegador no permitió guardar la ficha temporal. Puedes ingresar los datos directamente en Tasar."});}}
  return <AppShell data={{user:m.user,alertCount:"—",searchItems:[],searchStatus:"Abre Mi cartera para buscar entre tus propiedades guardadas.",locationNote:"Analiza publicaciones soportadas. La ubicación y la cobertura dependen de la información disponible."}} onNavigate={navigate} showDetail={(title,text)=>setDialog({title,text})}>
    <div className="analyze-workspace"><header className="analyze-heading"><div><span className="analyze-eyebrow">ANÁLISIS DE PUBLICACIÓN</span><h1>Del anuncio a la evidencia.</h1><p>Una URL. Sus datos, su precio y una perspectiva para decidir.</p></div><Badge subtle>Analizar · Datos Valoria</Badge></header>
    <Card label="Consultar publicación" className="analyze-entry"><div className="analyze-entry-label"><span className="analyze-icon"><Link2 size={23}/></span><div><h2>Trae la propiedad que estás mirando.</h2><p>Pega el enlace de Yapo o Portal Inmobiliario.</p></div></div><form onSubmit={e=>{e.preventDefault();void m.lookup();}}><label className="sr-only" htmlFor="analyze-url">URL de la publicación</label><div className="analyze-url-input"><Link2 size={18}/><input id="analyze-url" type="url" required placeholder="https://www.yapo.cl/..." value={m.url} onChange={e=>m.setUrl(e.target.value)} disabled={!!m.busy}/></div><Button type="submit" className="button-primary" disabled={!!m.busy}>{m.busy==="lookup"?"Consultando…":"Consultar publicación"}<ArrowRight size={17}/></Button></form><div className="analyze-entry-footer"><span>Yapo · Portal Inmobiliario</span><span>Los campos ausentes permanecen sin información.</span></div></Card>
    {m.auth&&<div className="analyze-auth"><p>Prepara el enlace e inicia sesión para consultarlo.</p><Button onClick={()=>navigate("Workspace personal")}>Iniciar sesión</Button></div>}
    {m.error&&<p className="analyze-notice" role="alert">{m.error}</p>}{m.message&&<p className="analyze-notice analyze-success" role="status">{m.message}</p>}
    <ol className="analyze-progress" aria-label="Etapas del análisis"><li className={m.result?"complete":"active"}><span>{m.result?<Check size={13}/>:"01"}</span>La publicación</li><li className={analysis?"complete":m.result?"active":""}><span>{analysis?<Check size={13}/>:"02"}</span>El contexto</li><li className={analysis?"active":""}><span>03</span>Tu decisión</li></ol>
    {!data?<Card label="Esperando publicación" className="analyze-empty" ><div className="analyze-preview" aria-hidden="true"><div><Link2 size={22}/><i/></div><span/><span/><div><i/><i/><i/></div><ScanLine size={48}/></div><Badge subtle>{m.busy==="lookup"?"CONSULTANDO LA FUENTE":"EL PUNTO DE PARTIDA"}</Badge><h2>{m.busy==="lookup"?"Buscando los datos\nde esta publicación.":"El precio es solo\nparte de la historia."}</h2><p>{m.busy==="lookup"?"La consulta puede tardar hasta dos minutos. Si el portal no permite leerla, te lo indicaremos.":"Reúne la ficha disponible, contrasta el valor publicado y revisa qué evidencia lo sostiene."}</p><div className="analyze-empty-features"><span><ScanLine size={18}/>Ficha de la propiedad</span><span><ShieldCheck size={18}/>Lectura del precio</span><span><Download size={18}/>Informe descargable</span></div></Card>:
    <div className="analyze-grid"><div className="analyze-stack"><Card label="Ficha de la publicación" className="analyze-property"><div className="analyze-between"><span className="analyze-eyebrow">01 / LA PUBLICACIÓN</span><Badge subtle>{status}</Badge></div><p className="analyze-source">{m.result?.source||data.source||"Fuente no informada"} · {formatPropertyType(data.property_type)}</p><PropertyPhoto thumbnail={data.thumbnail} title={data.title??"Publicación"} className="property-photo-detail"/><h2>{data.title||"Publicación sin título disponible"}</h2><p className="analyze-location">{formatCommuneName(data.comuna)}</p><div className="analyze-price">{finite(data.precio_publicado_uf)?formatUf(data.precio_publicado_uf):formatClp(data.precio_publicado_clp)}</div><p className="analyze-muted">Precio publicado{finite(data.precio_publicado_uf)&&finite(data.precio_publicado_clp)?` · ${formatClp(data.precio_publicado_clp)}`:""}</p><dl className="analyze-facts"><Fact label="Superficie útil" value={finite(data.usable_area_m2)?`${formatNumber(data.usable_area_m2)} m²`:"No informada"}/><Fact label="Construida" value={finite(data.built_area_m2??data.m2)?`${formatNumber(data.built_area_m2??data.m2)} m²`:"No informada"}/><Fact label="Terreno" value={finite(data.land_area_m2)?`${formatNumber(data.land_area_m2)} m²`:"No informado"}/><Fact label="Dormitorios" value={formatNumber(data.dormitorios,0)}/><Fact label="Baños" value={formatNumber(data.banos,0)}/><Fact label="Estacionamientos" value={formatNumber(data.estacionamientos,0)}/></dl><div className="analyze-actions">{external&&<a className="text-action" href={external} target="_blank" rel="noopener noreferrer">Abrir publicación<ArrowUpRight size={15}/></a>}<Button disabled={!validId||!!m.busy||m.saved} onClick={()=>void m.save()} title={!validId?"Solo se guardan publicaciones con un identificador en Valoria":undefined}>{m.saved?<Check size={16}/>:<Bookmark size={16}/>} {m.saved?"Guardada":m.busy==="save"?"Guardando…":"Guardar en watchlist"}</Button></div></Card><Card label="Vigencia de los datos" className="analyze-freshness"><ShieldCheck size={20}/><h3>Vigencia y procedencia</h3><p>{freshnessText(analysis??m.result!)}</p><small>Última observación: {formatDateTime(analysis?.last_seen_at??m.result?.last_seen_at)}</small><details><summary>Detalle del precio</summary><p>Moneda original: {data.price_currency||"No informada"}</p><p>Fuente UF: {data.price_uf_source||"No informada"} · Confianza: {data.price_uf_confidence||"No informada"}</p></details></Card></div>
    <div className="analyze-stack"><Card label="Análisis del precio" className="analyze-assessment"><span className="analyze-eyebrow">02 / EL CONTEXTO</span>{!analysis?<><div className="analyze-assessment-icon"><ShieldCheck size={36}/></div><h2>¿El precio tiene respaldo?</h2><p>Contrasta esta publicación con el motor de valoración de Valoria. La lectura depende de los atributos y los comparables disponibles.</p><Button className="button-primary" disabled={!!m.busy} onClick={()=>void m.analyze()}>{m.busy==="analysis"?"Evaluando comparables…":"Analizar precio"}<ArrowRight size={17}/></Button><small>La consulta puede verificar nuevamente la publicación según su vigencia.</small></>:<><div className="analyze-verdict"><Badge subtle>{analysis.price_analysis.verdict_label||"Evidencia insuficiente"}</Badge><h2>{formatUf(analysis.valuation.estimated_value_uf)}</h2><p>Estimación Valoria{finite(analysis.valuation.estimated_value_clp)?` · ${formatClp(analysis.valuation.estimated_value_clp)}`:""}</p></div><div className="analyze-range"><span>Rango estimado</span><strong>{formatUf(analysis.valuation.range_low_uf)} — {formatUf(analysis.valuation.range_high_uf)}</strong></div><div className="analyze-comparison"><div><span>Publicado</span><strong>{formatUf(analysis.price_analysis.published_price_uf)}</strong></div><ArrowRight size={19}/><div><span>Frente al valor estimado</span><strong>{priceComparisonLabel(analysis.price_analysis.difference_pct)}</strong></div></div><p>{analysis.price_analysis.explanation||"No hay evidencia suficiente para concluir sobre el precio."}</p><div className="analyze-evidence"><span><ShieldCheck size={17}/>{formatConfidence(analysis.valuation.confidence_label)}</span><span>{formatNumber(analysis.valuation.comparables_used,0)} comparables</span></div></>}</Card>
    {analysis&&<Card label="Señales de la publicación" className="analyze-signals"><h3>Lo que conviene mirar</h3><Signal title="A favor" values={analysis.signals.positives}/><Signal title="Para revisar" values={analysis.signals.risks}/><details className="analyze-unavailable"><summary>Información no disponible ({analysis.signals.unavailable.length})</summary><Signal title="Sin información suficiente" values={analysis.signals.unavailable}/></details></Card>}
    {warnings.length>0&&<details className="analyze-warnings"><summary>Advertencias de los datos ({warnings.length})</summary><ul>{warnings.map(w=><li key={w.code}>{w.description}{!w.known&&<small> ({w.code})</small>}</li>)}</ul></details>}
    <Card label="Siguiente paso" className="analyze-next"><span className="analyze-eyebrow">03 / TU DECISIÓN</span><h3>Profundiza con tus propios datos.</h3><p>Revisa o completa la ficha en Tasar antes de calcular una estimación ajustada a la propiedad.</p><div className="analyze-actions"><Button onClick={tasar} disabled={!!m.busy}><SlidersHorizontal size={16}/>Revisar en Tasar<ArrowRight size={16}/></Button>{analysis&&<Button disabled={!!m.busy} onClick={()=>void m.report()}><Download size={16}/>{m.busy==="report"?"Preparando…":"Descargar informe"}</Button>}</div></Card></div></div>}
    <p className="analyze-bottom-note">Los precios publicados no son precios de cierre. Una estimación orienta la revisión; no confirma por sí sola una oportunidad.</p>
    </div><dialog ref={modal} className="detail-dialog" onCancel={()=>setDialog(null)}><button className="dialog-close" aria-label="Cerrar" onClick={()=>setDialog(null)}><X size={20}/></button><h2>{dialog?.title}</h2><p>{dialog?.text}</p>{dialog?.login&&<form className="analyze-login" onSubmit={login}><label>Email<input name="email" type="email" required autoComplete="username"/></label><label>Contraseña<input name="password" type="password" required autoComplete="current-password"/></label>{loginError&&<p role="alert">{loginError}</p>}<Button type="submit" disabled={signingIn}>{signingIn?"Entrando…":"Iniciar sesión"}</Button></form>}</dialog>
  </AppShell>;
}
function Fact({label,value}:{label:string;value:string}){return <div><dt>{label}</dt><dd>{value}</dd></div>;}
function Signal({title,values}:{title:string;values:string[]}){return <div><h4>{title}</h4>{values.length?<ul>{values.map((v,i)=>{const warning=/^[a-z][a-z0-9_]+$/.test(v)?mapWarningCodes([v])[0]:null;return <li key={`${i}-${v}`}>{warning?warning.description:v}{warning&&!warning.known&&<small> ({v})</small>}</li>;})}</ul>:<p>No se reportaron señales en esta categoría.</p>}</div>;}
