import os,json,subprocess
from pathlib import Path
import httpx
root=Path(__file__).parent
repo=root/'valoria'
branch='feature/sii-closing-layer-20261019'
assert not subprocess.check_output(['git','status','--porcelain'],cwd=repo,text=True).strip()
assert subprocess.check_output(['git','branch','--show-current'],cwd=repo,text=True).strip()==branch
sha=subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()
parent=subprocess.check_output(['git','rev-parse','HEAD^'],cwd=repo,text=True).strip()
assert parent=='bc7fc6a23479b49fdf27ef134b57cb558a8fee09'
protected=['api/v1/valuations.py','services/valuation.py','services/sii/closing_knn.py','services/sii/closing_confidence.py','config/valuation_flags.py','reports/sii/closing_confidence_20261019/frozen-rule.json']
assert not subprocess.check_output(['git','diff',parent,'--name-only','--',*protected],cwd=repo,text=True).strip()
assert '153 passed' in (root/'sii-autofill-tests.log').read_text(encoding='utf8')
os.environ['GIT_TERMINAL_PROMPT']='0';os.environ['GCM_INTERACTIVE']='never'
cred=subprocess.run(['git','credential','fill'],input='protocol=https\nhost=github.com\n\n',cwd=repo,text=True,capture_output=True,timeout=20)
if cred.returncode:raise SystemExit('Credential unavailable; sensitive output suppressed')
fields=dict(x.split('=',1) for x in cred.stdout.splitlines() if '=' in x)
token=fields.get('password')
if not token:raise SystemExit('Credential unavailable')
url='https://api.github.com/repos/Andreaslinn/valoria/pulls/11'
with httpx.Client(headers={'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'},timeout=30) as client:
    response=client.get(url);response.raise_for_status();pr=response.json()
    assert pr['state']=='open' and pr['draft'] and not pr['merged_at']
    assert pr['head']['ref']==branch and pr['head']['sha'] in {parent,sha}
    assert pr['base']['ref']=='release/canonical-only-reproducible-20261013'
    lead='Añade en Tasar **autocompletado de datos desde una dirección inequívoca** y una **Segunda opinión con cierres SII**, detrás de `sii_closing_layer` **apagado por defecto**. No modifica el motor canónico, K, pesos, escalas ni la regla congelada.'
    old=pr['body']
    _,sep,rest=old.partition('\n\n')
    body=lead+(sep+rest if sep else '\n\n'+old)
    body=body.replace('**145 pruebas en verde**','**153 pruebas en verde**')
    section=f'''### Autocompletado por dirección

En ambas interfaces, tras seleccionar comuna y escribir dirección, consulta automática con espera de 600 ms. Solo una unidad inequívoca completa **superficie cerrada y tipo de propiedad** y muestra el **año de construcción**. Los baños, dormitorios, estacionamientos y terreno no constan en el índice ni tienen un aviso enlazado fiable: permanecen desconocidos y editables, nunca cero.

- Conserva m² y tipos manuales/importados. Al cambiar dirección/comuna retira los datos autocompletados anteriores y descarta respuestas de consultas antiguas.
- Varios departamentos o dirección ambigua: pide completar unidad/torre; no toma la primera unidad ni atributos de vecinos. Sin roles o direcciones de terceros en la respuesta.
- Distingue **Superficie cerrada SII** de superficie útil; no envía los m² cerrados como `usable_area_m2`.
- Nuevo endpoint autenticado `/api/v1/tasar/address-details`, 404 con flag apagado antes de abrir archivos, índice de solo lectura y sin dependencia del archivo de cierres.
- Prueba real local: autocompletado, campos desconocidos vacíos, correcciones manuales preservadas, cambio rápido a ambigüedad, casa identificada y tasación completa desde el área rellenada. Capturas y casos solo locales.

**153 pruebas pasadas** (145 previas + ocho nuevas), Ruff y TypeScript en ambas interfaces correctos. [Informe agregado de autocompletado](https://github.com/Andreaslinn/valoria/blob/{sha}/reports/sii/address_autofill_20261019/report.md).

'''
    anchor='### Sesgo: mismos 1.142 casos emparejados'
    if anchor in body:body=body.replace(anchor,section+anchor,1)
    else:body+='\n\n'+section
    (root/'autofill-pr-body.md').write_text(body,encoding='utf8')
    subprocess.run(['git','push','origin',branch],cwd=repo,check=True,timeout=90)
    response=client.patch(url,json={'title':'SII: autocompletado por dirección y segunda opinión en Tasar','body':body});response.raise_for_status()
    response=client.get(url);response.raise_for_status();pr=response.json()
    assert pr['draft'] and not pr['merged_at'] and pr['head']['sha']==sha
    result={'url':pr['html_url'],'sha':sha,'draft':True,'merged':False,'deployed':False,'flag_default':False,'tests':'153 passed'}
    (root.parent/'outputs/SII_AUTORRELLENO_PR.json').write_text(json.dumps(result,indent=2),encoding='utf8')
    print(json.dumps(result))
