def upgrade():
    for statement in DDL:
        op.execute(statement)


def downgrade():
    op.drop_table("transfer_unit", schema="property_life")
    op.drop_table("transfer", schema="property_life")
    op.drop_table("uf_daily", schema="property_life")
    op.drop_table("transfer_raw", schema="property_life")
    op.drop_table("property", schema="property_life")
