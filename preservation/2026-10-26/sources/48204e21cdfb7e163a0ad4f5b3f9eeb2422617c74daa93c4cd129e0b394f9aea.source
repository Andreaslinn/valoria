import pathlib, subprocess, sys
base = pathlib.Path(__file__).resolve().parent
cmd = [r'C:\Windows\System32\OpenSSH\ssh.exe', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o', 'ConnectTimeout=20', '-i', r'C:\Users\heiko\Downloads\ssh-key-2026-07-07 (1).key', 'ubuntu@161.153.201.245', 'python3 -B -']
r = subprocess.run(cmd, input=(base / sys.argv[1]).read_bytes(), capture_output=True, timeout=300)
print(r.stdout.decode(errors='replace'))
print(r.stderr.decode(errors='replace')[-2000:])
sys.exit(r.returncode)
