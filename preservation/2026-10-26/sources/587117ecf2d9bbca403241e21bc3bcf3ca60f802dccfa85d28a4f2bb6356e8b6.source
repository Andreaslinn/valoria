  assert live_analysis.valuation.get('estimated_value_uf') is not None
  assert await readonly_lookup(live_url) is None,'Read-only acquisition unexpectedly persisted listing'
  print(json.dumps({'production_new_portal_lookup':live.status,'new_portal_external_id':live.listing_data['external_id'],'new_portal_estimate_uf':live_analysis.valuation.get('estimated_value_uf'),'production_db_transaction':'read_only','actual1130_excluded' ''')
remote='''import subprocess,json,hashlib,pathlib,re
def run(a,**kw):
 r=subprocess.run(a,capture_output=True,text=True,timeout=100,**kw)
 if r.returncode:
  print(json.dumps({'smoke_error_types':re.findall(r'^([A-Za-z_.]+(?:Error|Exception)):',r.stderr,re.M),'frames':re.findall(r'File "([^"\\n]+)", line (\\d+)',r.stderr)}))
  raise RuntimeError('Production smoke failed; sensitive output withheld')
 return r.stdout
api=json.loads(run(['docker','inspect','valoria_oracle_beta-api-1']))[0]
