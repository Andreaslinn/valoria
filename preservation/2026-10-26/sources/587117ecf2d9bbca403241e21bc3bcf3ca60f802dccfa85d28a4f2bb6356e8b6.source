  async def readonly_lookup(url):return await find_existing_listing_by_url(s,url)
  assert await readonly_lookup(live_url) is None,'Expected unseen URL changed; stop for reconciliation'
  live=await lookup_listing_url(live_url,listing_lookup=readonly_lookup)
  assert live.status=='parsed_new' and live.listing_data['external_id']=='MLC-2467200996'
