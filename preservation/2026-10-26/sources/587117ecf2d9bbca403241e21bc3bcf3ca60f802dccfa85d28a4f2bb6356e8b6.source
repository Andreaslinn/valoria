host=env.get('ORACLE_API_HOSTNAME','localhost');origin=host if host.startswith(('http://','https://')) else 'https://'+host
probe="import httpx,json;c=httpx.Client(timeout=30,follow_redirects=True);r=c.get("+repr(origin+'/api/v1/health/capabilities')+");r.raise_for_status();d=r.json();assert d['code_fingerprint']=='2cd008454aaec42a188dbc8bb6fe5f6a372ddc1438bb0621737e8cedb10406f7';print(json.dumps({'proxy_url':str(r.url),'status':r.status_code,'fingerprint':d['code_fingerprint']}))"
print(run(['docker','exec','valoria_oracle_beta-api-1','python','-B','-c',probe]))
print(json.dumps({'session_unchanged_after_smoke':True,'deployed_image':api['Image'],'schema_revision_expected':'0022'}))
'''.replace('INNER',repr(inner))
