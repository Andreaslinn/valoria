"use client";
import { useEffect, useState, type FormEvent } from "react";
import { ArrowRight, Building2, House, BriefcaseBusiness, MapPin, SlidersHorizontal } from "lucide-react";
import { Button, Card } from "@/components/ui/primitives";
import { formatCommuneName } from "@/lib/formatters";
import type { PropertyType, ValuationRequest } from "@/types/valuation";
import { consumeTasarPrefill } from "./prefill";

const communes=["santiago","providencia","nunoa","las_condes","vitacura","lo_barnechea","la_reina","macul","san_miguel","estacion_central","independencia","recoleta","san_joaquin","la_florida"];
const types=[{value:"apartment",label:"Depto.",icon:Building2},{value:"house",label:"Casa",icon:House},{value:"office",label:"Oficina",icon:BriefcaseBusiness}] as const;
const initial={comuna:"",area:"",land:"",beds:"",baths:"",parking:"",priceUf:"",priceClp:"",reference:""};
const number=(value:string)=>value.trim()!=="" && Number.isFinite(Number(value))?Number(value):null;
export function PropertyForm({busy,hasResult,onChange,onSubmit}:{busy:boolean;hasResult:boolean;onChange:()=>void;onSubmit:(payload:ValuationRequest)=>Promise<void>}) {
  const [type,setType]=useState<PropertyType>("apartment"),[values,setValues]=useState(initial),[imported,setImported]=useState(false),[targetId,setTargetId]=useState<number|undefined>(),[currency,setCurrency]=useState("UF"),[error,setError]=useState("");
  useEffect(()=>{const p=consumeTasarPrefill();if(!p)return;const n=(v:unknown)=>typeof v==="number"&&Number.isFinite(v)?String(v):"";setImported(true);setTargetId(p.targetListingId);setType(p.propertyType??"apartment");setCurrency(p.publishedPriceUf==null&&p.publishedPriceClp!=null?"CLP":"UF");setValues({comuna:p.comuna??"",area:n(p.propertyType==="apartment"?(p.usableAreaM2??p.builtAreaM2):(p.builtAreaM2??p.usableAreaM2)),land:n(p.landAreaM2),beds:n(p.dormitorios),baths:n(p.banos),parking:n(p.estacionamientos),priceUf:n(p.publishedPriceUf),priceClp:n(p.publishedPriceClp),reference:p.reference??""});},[]);
  const update=(key:keyof typeof initial,value:string)=>{setValues(v=>({...v,[key]:value}));onChange();};
  async function submit(event:FormEvent<HTMLFormElement>) {
    event.preventDefault();setError("");const area=number(values.area),land=number(values.land);
    if(!values.comuna||area==null||area<=0||(type==="house"&&(land==null||land<=0))){setError("Revisa la comuna y las superficies de la propiedad.");return;}
    await onSubmit({target_listing_id:targetId,comuna:values.comuna,property_type:type,m2:area,built_area_m2:area,usable_area_m2:type==="apartment"?area:null,land_area_m2:type==="house"?land:null,dormitorios:number(values.beds),banos:number(values.baths),estacionamientos:number(values.parking),precio_publicado_uf:currency==="UF"?number(values.priceUf):null,precio_publicado_clp:currency==="CLP"?number(values.priceClp):null});
  }
  return <Card label="Ficha de la propiedad" className="tasar-input"><div className="tasar-card-title"><div><span className="tasar-eyebrow">01 / LA PROPIEDAD</span><h2>Define el punto de partida.</h2></div><SlidersHorizontal size={19}/></div>
    <form onSubmit={submit}><fieldset disabled={busy}>
      {imported&&<p className="tasar-note">Datos importados. Revísalos antes de tasar.</p>}
      <div className="tasar-type" role="group" aria-label="Tipo de propiedad">{types.map(({value,label,icon:Icon})=><button key={value} type="button" aria-pressed={type===value} onClick={()=>{setType(value);onChange();}}><Icon size={19}/>{label}</button>)}</div>
      <label className="tasar-field"><span><MapPin size={14}/> Comuna</span><select required value={values.comuna} onChange={e=>update("comuna",e.target.value)}><option value="">Selecciona una comuna</option>{Array.from(new Set([...communes,...(values.comuna?[values.comuna]:[])])).map(c=><option key={c} value={c}>{formatCommuneName(c)}</option>)}</select></label>
      <div className="tasar-surface"><label className="tasar-field"><span>{type==="apartment"?"Superficie útil":"Superficie construida"}</span><div className="tasar-unit"><input aria-label={type==="apartment"?"Superficie útil":"Superficie construida"} required type="number" min="0.1" step="any" placeholder="Ej. 75" value={values.area} onChange={e=>update("area",e.target.value)}/><span>m²</span></div></label>{type==="house"&&<label className="tasar-field"><span>Terreno</span><div className="tasar-unit"><input aria-label="Superficie de terreno" required type="number" min="0.1" step="any" placeholder="Ej. 250" value={values.land} onChange={e=>update("land",e.target.value)}/><span>m²</span></div></label>}</div>
      <div className="tasar-rooms">{([{key:"beds",label:"Dormitorios"},{key:"baths",label:"Baños"},{key:"parking",label:"Estacionam."}] as const).map(({key,label})=><label className="tasar-field" key={key}><span>{label}</span><input type="number" min="0" step="1" placeholder="—" value={values[key]} onChange={e=>update(key,e.target.value)}/></label>)}</div>
      <div className="tasar-price-input"><div className="tasar-inline"><label htmlFor="tasar-published">Precio publicado <small>Opcional</small></label><select aria-label="Moneda del precio publicado" value={currency} onChange={e=>{setCurrency(e.target.value);onChange();}}><option>UF</option><option>CLP</option></select></div><input id="tasar-published" type="number" min="0" step={currency==="UF"?"any":"1"} placeholder="Compara lo que piden con lo que vale" value={currency==="UF"?values.priceUf:values.priceClp} onChange={e=>update(currency==="UF"?"priceUf":"priceClp",e.target.value)}/></div>
      <details className="tasar-reference"><summary>Añadir una referencia personal</summary><label className="tasar-field"><span>Referencia</span><input value={values.reference} onChange={e=>update("reference",e.target.value)} placeholder="Ej. Departamento de calle Italia"/></label><p>Solo para identificar la propiedad aquí. No interviene en el cálculo.</p></details>
      {error&&<p className="tasar-notice" role="alert">{error}</p>}
      <Button type="submit" className="tasar-submit" disabled={busy}>{busy?"Analizando comparables…":hasResult?"Actualizar tasación":"Obtener estimación"}<ArrowRight size={17}/></Button>
      <p className="tasar-footnote">{busy?"El cálculo puede tardar hasta dos minutos.":"Los campos sin completar se envían como desconocidos."}</p>
    </fieldset></form>
    <div className="tasar-input-footer"><span className="tasar-dot"/> Datos reales · Sin precios de ejemplo</div>
  </Card>;
}
