config={'version':'portal-geo-AM-v0','registered_at':datetime.now(timezone.utc).isoformat(),
 'authorization_sha256':sha(Path('C:/Users/heiko/.codex/attachments/c46ddead-4977-46e4-8c01-4e929d9fbb19/Texto pegado.txt')),
 'dataset_sha256':{g:d.hash() for g,d in datasets.items()},'immutable_inputs':inputs,
 'uf_reference':old['uf_reference'],'cohort':{'n':791,'Portal':406,'Yapo':385,'snapshot':'2026-10-04','status':'previously researched development; exploratory only'},
 'validation':'G3 grouped nested 3x3 CV seeds20261009,20261010; G1 sensitivity seed20261009; primary fresh reproduction; no confirmatory holdout',
 'weights':[.4,.25,.15,.1,.1],'minimum_native_A':5,'maximum_native_A':20,
 'search':'Finite spatial/K grid; no weight optimization or outer feedback. Inner paired source-balanced MAE-log (Portal .6/Yapo .4); full coverage noninferiority to A; baseline wins ties.',
 'geo_policy':'USABLE plus separately flagged UNCERTAIN with valid non-centroid numeric point; no source precision certification inferred. Training repeated coords >=5 excluded; no target-price use.',
