import subprocess,pathlib,json
root=pathlib.Path('/home/ubuntu/apps/valoria-portal-interactive-20261011')
assert root.name=='valoria-portal-interactive-20261011'
assert pathlib.Path('/home/ubuntu/apps/valoria/private/portal-session/session.json').stat().st_mode&0o777==0o600
subprocess.run(['python3','-B',str(root/'cleanup.py')],check=True,capture_output=True)
subprocess.run(['sudo','-n','systemctl','stop','valoria-portal-interactive-expiry-20261011.timer'],check=True,capture_output=True)
print(json.dumps({'temporary_browser_removed':True,'temporary_browser_image_removed':True,'temporary_cleanup_timer_stopped':True,'verified_session_retained_privately':True}))
