import subprocess,pathlib,json,os
root=pathlib.Path('/home/ubuntu/apps/valoria/private/portal-session')
root.mkdir(parents=True,mode=0o700,exist_ok=True);root.chmod(0o700)
code='''import sqlite3,json,hashlib,pathlib,os,time
from cryptography.hazmat.primitives.ciphers import Cipher,algorithms,modes
c=sqlite3.connect("file:/home/browser/profile/Default/Cookies?mode=ro",uri=True)
version=int(c.execute("select value from meta where key='version'").fetchone()[0])
key=hashlib.pbkdf2_hmac('sha1',b'peanuts',b'saltysalt',1,16)
cookies=[]
for host,name,plain,encrypted,path,secure,expiry,session in c.execute("select host_key,name,value,encrypted_value,path,is_secure,expires_utc,is_persistent from cookies where host_key in ('.portalinmobiliario.com','www.portalinmobiliario.com','.www.portalinmobiliario.com')"):
 if encrypted:
  assert encrypted[:3]==b'v10','Unsupported cookie format'
  d=Cipher(algorithms.AES(key),modes.CBC(b' '*16)).decryptor();v=d.update(encrypted[3:])+d.finalize();v=v[:-v[-1]]
  if version>=24:
   assert v[:32]==hashlib.sha256(host.encode()).digest(),'Host binding mismatch'
   v=v[32:]
  plain=v.decode()
 if name.startswith('__g') or name in ('__eoi','_gcl_au'):continue
 cookies.append({'domain':host,'name':name,'value':plain,'path':path,'secure':bool(secure),'expires':int(expiry/1000000-11644473600) if session else None})
assert any(x['name']=='ssid' for x in cookies),'Missing authenticated session'
p=pathlib.Path('/tmp/portal-session.json');p.write_text(json.dumps({'cookies':cookies,'saved_at':int(time.time())}));p.chmod(0o600)
print(json.dumps({'saved':True,'cookie_count':len(cookies),'credentials_stored':False}))
'''
r=subprocess.run(['docker','exec','-i','valoria-portal-interactive-20261011','python','-B','-'],input=code,capture_output=True,text=True,check=True)
cp=subprocess.run(['docker','exec','valoria-portal-interactive-20261011','cat','/tmp/portal-session.json'],capture_output=True,check=True)
with os.fdopen(os.open(root/'session.json',os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600),'wb') as f:f.write(cp.stdout)
(root/'session.json').chmod(0o600)
print(r.stdout)
