code='''import asyncio,json,hashlib,httpx,inspect
from sqlalchemy import text
from infrastructure.db.database import get_session_factory
from api.v1.valuations import ValuationRequest
from services.listing_url_lookup import detect_source
from services.valuation import ValuationService
async def main():
 async with httpx.AsyncClient() as client:
  r=await client.get("http://127.0.0.1:8000/openapi.json")
  schema=r.json()
 print(json.dumps({"schema_sha256":hashlib.sha256(json.dumps(schema,sort_keys=True).encode()).hexdigest(),"api_info":schema.get("info"),"target_listing_id":"target_listing_id" in ValuationRequest.model_fields,"portal_detected":detect_source("https://www.portalinmobiliario.com/MLC-123-depto"),"valuation_source_sha256":hashlib.sha256(inspect.getsource(ValuationService).encode()).hexdigest(),"paths":sorted(schema["paths"])}))
 async with get_session_factory()() as s:
  await s.execute(text("SET TRANSACTION READ ONLY"))
  rows=(await s.execute(text("SELECT id,source,external_id,url,status,comuna,property_type,last_seen_at FROM listings WHERE id IN (1130,298,6842) OR (source='portalinmobiliario' AND status='active') ORDER BY id LIMIT 6"))).mappings().all()
  print(json.dumps({"listings":[dict(r) for r in rows]},default=str))
asyncio.run(main())
'''
