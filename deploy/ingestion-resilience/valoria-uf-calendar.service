[Unit]
Description=Valoria bounded official UF calendar refresh
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/valoria
ExecStart=/usr/bin/flock -n /run/valoria/uf-calendar.lock /usr/bin/python3 -B /home/ubuntu/apps/valoria/scripts/run_ingestion_uf_refresh.py
RuntimeDirectory=valoria
RuntimeDirectoryMode=0750
TimeoutStartSec=3min
Nice=10
UMask=0077
