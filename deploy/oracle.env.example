# Valoria Oracle beta runtime example.
# Copy values into the Oracle VM runtime environment or a private .env file.
# Never put real secrets in this example file.

# Runtime profile
VALORIA_RUNTIME_PROFILE=oracle_beta
ENVIRONMENT=beta
TZ=America/Santiago
LOG_LEVEL=INFO

# Reverse proxy. Use a temporary hostname first, then api.valoria.cl.
ORACLE_API_HOSTNAME=localhost

# PostgreSQL container bootstrap values.
POSTGRES_USER=avm
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=avm

# Internal Docker database URLs used by API, scheduler, and Alembic.
DATABASE_URL=postgresql+asyncpg://avm:replace-with-a-long-random-password@postgres:5432/avm
SYNC_DATABASE_URL=postgresql+psycopg://avm:replace-with-a-long-random-password@postgres:5432/avm
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# FastAPI runtime
PORT=8000
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=*

# CORS for the Netlify frontend. This is the existing code variable;
# do not use a separate CORS_ALLOWED_ORIGINS name in this codebase.
BACKEND_CORS_ORIGINS=https://your-netlify-app.example

# Auth
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
BETA_SIGNUP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# External APIs
UF_API_URL=https://mindicador.cl/api/uf
UF_CACHE_TTL_HOURS=24
UF_MAX_STALENESS_DAYS=1
UF_ALLOW_STALE_ON_FAILURE=true
UF_REQUIRE_FRESH_FOR_RADAR=false
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=Valoria Oracle beta contact:ops@example.com

# Runtime capabilities
SCHEDULER_ENABLED=true
LISTING_ON_DEMAND_REFRESH_ENABLED=true
LISTING_ON_DEMAND_REFRESH_COOLDOWN_HOURS=24
LISTING_ON_DEMAND_REFRESH_SKIP_BLOCKED_HOURS=24
LISTING_ON_DEMAND_REFRESH_TIMEOUT_SEC=12
PORTFOLIO_SNAPSHOT_WRITE_ENABLED=false
VALUATION_FEEDBACK_ENABLED=false

# Scheduler: keep one lightweight scheduler on the 1 OCPU Oracle VM.
SCHEDULER_ENABLE_DISCOVERY=false
SCHEDULER_ENABLE_PORTAL=false
SCHEDULER_STARTUP_CATCHUP_ENABLED=false
SCHEDULER_STARTUP_REFRESH_ENABLED=true
SCHEDULER_STARTUP_ALERTS_ENABLED=true
SCHEDULER_STARTUP_MIN_STALE_HOURS=24
SCHEDULER_DISCOVERY_CRON=0 10 * * *
SCHEDULER_DISCOVERY_MAX_PAGES=1
SCHEDULER_DISCOVERY_SLEEP_SECONDS=3.0
SCHEDULER_REFRESH_CRON=0 12 * * mon,wed,fri
SCHEDULER_ALERTS_CRON=0 13 * * *
SCHEDULER_REFRESH_LIMIT=5
SCHEDULER_REFRESH_STALE_DAYS=30
SCHEDULER_REFRESH_COOLDOWN_HOURS=24
SCHEDULER_ALERTS_THRESHOLD_PCT=5.0
SCHEDULER_ALERTS_LOOKBACK_DAYS=30
SCHEDULER_ENABLE_UF_DAILY_SNAPSHOT=true
UF_REFRESH_ON_STARTUP=true
UF_REFRESH_HOUR=8

# Portfolio snapshots are present but disabled initially for Oracle beta.
PORTFOLIO_SNAPSHOTS_ENABLED=false
PORTFOLIO_SNAPSHOTS_CRON=0 14 * * *
PORTFOLIO_SNAPSHOTS_LIMIT_USERS=10
PORTFOLIO_SNAPSHOTS_LIMIT_ITEMS_PER_USER=20
PORTFOLIO_SNAPSHOTS_MIN_INTERVAL_HOURS=20
PORTFOLIO_SNAPSHOTS_DRY_RUN=false
PORTFOLIO_SNAPSHOTS_USER_ID=
PORTFOLIO_SNAPSHOTS_STARTUP_CATCHUP_ENABLED=false

# Valuation flags
VALORIA_USE_CONSENSUS=false
VALUATION_QUALITY_V2_APPLY_MODE=guarded
VALUATION_QUALITY_V2_ALLOWED_PROPERTY_TYPES=apartment
VALUATION_QUALITY_V2_BLOCKED_COMUNAS=estacion central,la reina,macul
VALUATION_QUALITY_V2_P90_RISK_COMUNAS=la reina,las condes,maipu,nunoa
VALUATION_QUALITY_V2_MIN_VALID_COMPARABLES=5
VALUATION_QUALITY_V2_MAX_POOL_DISPERSION=75
VALUATION_QUALITY_V2_MAX_DELTA_VS_BASELINE_PCT=0.25
