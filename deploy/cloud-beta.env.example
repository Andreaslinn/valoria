# Valoria cloud-beta environment example.
# Provider-neutral: works for Docker platforms with external PostgreSQL.
# Never commit real secrets.

VALORIA_RUNTIME_PROFILE=cloud_beta
ENVIRONMENT=cloud_beta
LOG_LEVEL=INFO

# External PostgreSQL. Use provider secret storage for real values.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
SYNC_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=3

# Redis is optional in cloud-beta; UF falls back to DB/HTTP.
REDIS_ENABLED=false
REDIS_URL=

# Auth and beta controls.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
BETA_SIGNUP_ENABLED=false

# Runtime capabilities: cloud-beta API container only.
SCHEDULER_ENABLED=false
WORKERS_ENABLED=false
LISTING_ON_DEMAND_REFRESH_ENABLED=false
PORTFOLIO_SNAPSHOT_WRITE_ENABLED=false
VALUATION_FEEDBACK_ENABLED=false

# Public API runtime.
PORT=8000
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=*
BACKEND_CORS_ORIGINS=https://your-frontend.example

# External APIs.
UF_API_URL=https://mindicador.cl/api/uf
UF_CACHE_TTL_HOURS=24
UF_MAX_STALENESS_DAYS=1
UF_ALLOW_STALE_ON_FAILURE=true
UF_REQUIRE_FRESH_FOR_RADAR=false
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT="Valoria cloud-beta contact:ops@example.com"

# Valuation feature flags.
VALORIA_USE_CONSENSUS=false
VALUATION_QUALITY_V2_APPLY_MODE=guarded
VALUATION_QUALITY_V2_ALLOWED_PROPERTY_TYPES=apartment
VALUATION_QUALITY_V2_BLOCKED_COMUNAS=estacion central,la reina,macul
VALUATION_QUALITY_V2_P90_RISK_COMUNAS=la reina,las condes,maipu,nunoa
VALUATION_QUALITY_V2_MIN_VALID_COMPARABLES=5
VALUATION_QUALITY_V2_MAX_POOL_DISPERSION=75
VALUATION_QUALITY_V2_MAX_DELTA_VS_BASELINE_PCT=0.25
