# AVM v2 beta environment example.
# Copy to .env locally or configure the same keys in your hosting provider.
# Never commit real secrets.

# Runtime
# Use "local" when API/Streamlit/Alembic run from Windows/PowerShell.
# Docker compose overrides container-only connection URLs where needed.
ENVIRONMENT=local
# Optional Docker runtime label used only by docker-compose.yml.
DOCKER_ENVIRONMENT=beta
LOG_LEVEL=INFO

# PostgreSQL container defaults for docker compose.
POSTGRES_USER=avm
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=avm
POSTGRES_PORT=5432

# App database URLs for LOCAL mode: API/Streamlit/Alembic run from Windows,
# while Postgres is exposed by Docker on localhost:5432.
DATABASE_URL=postgresql+asyncpg://avm:replace-with-a-long-random-password@localhost:5432/avm
SYNC_DATABASE_URL=postgresql+psycopg://avm:replace-with-a-long-random-password@localhost:5432/avm

# DOCKER mode: do not put host "postgres" in .env for local PowerShell use.
# docker-compose.yml injects these container-only URLs into API/Streamlit:
#   DATABASE_URL=postgresql+asyncpg://...@postgres:5432/avm
#   SYNC_DATABASE_URL=postgresql+psycopg://...@postgres:5432/avm

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# API auth. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-characters-for-beta
SECRET_KEY=replace-with-at-least-32-random-characters-for-beta
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Streamlit beta gate. Required by docker compose for private beta packaging.
# Use a random value; do not commit real beta passwords.
BETA_PASSWORD=replace-with-beta-password

# Beta UI scope. This example enables the three real local-beta flows while
# keeping Product Lab and all simulated screens disabled.
BETA_MODE=true
BETA_SHOW_PRODUCT_LAB=false
BETA_SHOW_PORTFOLIO=true
BETA_SHOW_ALERTS=true
BETA_SHOW_STATUS=true

# Streamlit UI variant. Values:
#   legacy            -> current UI
#   demo              -> current Product Lab demo mode
#   tasar_playground  -> experimental Neo Premium Dark Tasar screen only
AVM_UI_VERSION=legacy
# Keep playground demo fixtures disabled even if AVM_UI_VERSION changes locally.
AVM_TASAR_PLAYGROUND_DEMO_MODE=false

# Initial admin bootstrap. Set both ADMIN_EMAIL and ADMIN_PASSWORD to create
# the first admin automatically when the API starts and no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Privacy-conscious product analytics. Local JSONL only, no third-party tracking.
PRODUCT_ANALYTICS_ENABLED=true
PRODUCT_ANALYTICS_DIR=reports/product_usage
PRODUCT_ANALYTICS_SALT=replace-with-random-analytics-salt

# Private beta valuation feedback. Local JSONL only, no external services.
VALUATION_FEEDBACK_DIR=reports/valuation_feedback

# Minimal multi-engine valuation consensus for the local beta profile.
# Runtime code still defaults to false when this variable is absent.
VALORIA_USE_CONSENSUS=true

# Public/internal URLs
API_PORT=8000
STREAMLIT_PORT=8501
# LOCAL mode: Streamlit from Windows talks to the local FastAPI port.
# DOCKER mode: docker-compose.yml injects http://api:8000 into Streamlit.
AVM_API_BASE_URL=http://localhost:8000

# External APIs
UF_API_URL=https://mindicador.cl/api/uf
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Required for Nominatim policy compliance. Use an identifiable product name
# and a real operational contact in private deployments; do not use generic clients.
NOMINATIM_USER_AGENT="AVM-v2-beta/1.0 contact:ops@example.com"

# Scheduler jobs. Cron format: minute hour day month day_of_week.
# Local startup keeps the scheduler disabled by default. Enable only when you
# want a separate operational process:
#   AVM_START_SCHEDULER=true
AVM_START_SCHEDULER=false
# Keep scheduled discovery off until explicitly approved. Refresh/alerts can
# run as the first limited scheduler mode.
SCHEDULER_ENABLE_DISCOVERY=false
# PortalInmobiliario remains experimental/inestable; do not enable for beta ops.
SCHEDULER_ENABLE_PORTAL=false
SCHEDULER_DISCOVERY_CRON="0 10 * * *"
SCHEDULER_REFRESH_CRON="0 12 * * mon,wed,fri"
SCHEDULER_ALERTS_CRON="0 13 * * *"
# Keep local scheduled refresh batches small; increase intentionally in ops.
SCHEDULER_REFRESH_LIMIT=5
SCHEDULER_REFRESH_STALE_DAYS=30
SCHEDULER_REFRESH_COOLDOWN_HOURS=24
SCHEDULER_ALERTS_THRESHOLD_PCT=5.0
SCHEDULER_ALERTS_LOOKBACK_DAYS=30
